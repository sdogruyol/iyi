# iyi's prelude — SPEC.md, "0.1.0", item 3.
#
#   ./bin/crystal build --prelude=iyi/prelude program.iyi
#
# Not a standard library. The prelude an iyi program gets is deliberately the
# smallest thing that runs the samples, because while an iyi program requires
# Crystal's 107,719-line prelude the benchmark measures a workaround rather
# than the thesis: the front end spends 886 ms of its 901 ms analysing it, and
# `.iyimod` saves 15 ms of the remainder (SPEC.md IV.1f).
#
# **What is in here is decided by what a sample calls.** A method enters
# because an existing program needs it, never because it belongs in a standard
# library. The ceiling is 3,734 lines — Crystal's own 0.1.0 core with its concurrency,
# measured in the same language family and for the same purpose.
#
# `primitives.iyi` under it is the list of machine operations iyi admits —
# arithmetic, conversions, comparisons and `Pointer`. It is iyi's own rather
# than Crystal's, and the reason is measured there.
require "./primitives"

require "./macros"
require "./object"
require "./number"
require "./string"
require "./array"
require "./range"
require "./hash"
# `Atomic(T)`, on every target: the instructions are LLVM's and lower to
# plain loads and stores where a target has one thread (wasm32), so the
# type costs nothing where nothing can race and needs no gate here.
require "./atomic"

# iyi: the concurrency runtime — a cooperative scheduler, cancellable
# blocking primitives, `group`/`spawn` and `Channel`, in exactly III.4.8's
# order. Required here rather than gated inside itself, because iyi-only
# syntax (`!`, `defer`, `impl`) does not survive a macro expansion's
# re-parse; the platforms that cannot carry the model are given nothing
# rather than a sequential imitation, which III.4.8 refused by name.
# darwin rides the aarch64 arm of the same runtime through libSystem —
# its own branch below says why libSystem — and the Linux pair keeps its
# raw syscalls.
{% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
  require "./concurrency"
  # A kernel thread, and the stop-the-world over them (GC_DESIGN.md Stage
  # 4); the file itself says which builds get one.
  require "./thread"
{% end %}

# The runtime's one lock: what the allocator's centre, the scheduler's
# registries and the thread list are behind, and what a collection takes
# before it stops anything, so no stopped thread can be holding it. A spin
# on one `compare_and_set` — uncontended it is one instruction, and one
# thread never contends. A spinner holds nothing, so where threads exist
# the spin is also where a thread asked to stop for a collection parks.
class IyiRuntimeLock
  @@word : UInt64 = 0_u64

  def self.word : Pointer(Atomic(UInt64))
    Pointer(Atomic(UInt64)).new(pointerof(@@word).address)
  end

  def self.lock : Nil
    word = self.word
    # Read before the CAS: a failed CAS still takes the line for writing,
    # and fifteen helpers spinning on one while a collection held it
    # slowed the holder; a read spins on a shared line.
    while word.value.get != 0_u64 || !word.value.compare_and_set(0_u64, 1_u64)[1]
      {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64))) %}
        IyiThread.park_if_requested
      {% end %}
      {% if flag?(:x86_64) %}
        asm("pause" :::: "volatile")
      {% elsif flag?(:aarch64) %}
        asm("yield" :::: "volatile")
      {% end %}
    end
  end

  # One try, no wait and no park: for a walk that must not park where it
  # stands and has somewhere else to be.
  def self.try_lock : Bool
    word = self.word
    word.value.get == 0_u64 && word.value.compare_and_set(0_u64, 1_u64)[1]
  end

  def self.unlock : Nil
    word.value.set(0_u64)
  end
end

{% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
  # iyi: On Linux, libc is not bound at all. The dependency floor (SPEC.md
  # III.9) named seven undefined symbols in a default program and five of them
  # were libc's; the kernel's syscall ABI is a stable contract, so `write` and
  # `exit` are one `syscall` instruction each rather than a PLT hop. Same move
  # Go makes with CGO_ENABLED=0. The numbers and register conventions are the
  # ones `src/syscall/x86_64-linux.cr` and `src/syscall/aarch64-linux.cr`
  # carry for the compiler's own runtime, written out here rather than
  # required because the prelude is iyi's own world ("0.1.0", item 3) and
  # requiring compiler source into a program would be a dependency of exactly
  # the kind this removes.
  #
  # `exit_group` rather than `exit`: the kernel's `exit` retires one thread,
  # `exit_group` retires the process. 0.1.0 has one thread, so the difference
  # is unobservable, and exit_group is what a program that grows threads
  # wants its panic path to mean.
  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(1_i64), "{rdi}"(fd.to_i64), "{rsi}"(buffer), "{rdx}"(count)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(64_i64), "{x0}"(fd.to_i64), "{x1}"(buffer), "{x2}"(count)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  # `read`, for `read_input` below. Syscall 0 on x86_64 and 63 on aarch64,
  # the same numbers `src/syscall/*-linux.cr` carries. Binding libc's `read`
  # here for one call would put the whole library back on the link line and
  # undo the floor III.9 measures.
  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(0_i64), "{rdi}"(fd.to_i64), "{rsi}"(buffer), "{rdx}"(count)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(63_i64), "{x0}"(fd.to_i64), "{x1}"(buffer), "{x2}"(count)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  # `openat`/`close` for `File`. Syscall 257/3 on x86_64, 56/57 on aarch64.
  # `AT_FDCWD` (-100) so a relative path does not need a directory fd.
  # The fourth syscall argument on x86_64 is `r10`, not `rcx`.
  def __iyi_open_read(path : UInt8*) : Int64
    __iyi_openat(path, 0, 0)
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # O_WRONLY|O_CREAT|O_TRUNC = 1|64|512, mode 0644.
    __iyi_openat(path, 577, 420)
  end

  def __iyi_openat(path : UInt8*, flags : Int32, mode : Int32) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(257_i64), "{rdi}"(-100_i64), "{rsi}"(path),
                      "{rdx}"(flags.to_i64), "{r10}"(mode.to_i64)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(56_i64), "{x0}"(-100_i64), "{x1}"(path),
                     "{x2}"(flags.to_i64), "{x3}"(mode.to_i64)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  def __iyi_close(fd : Int64) : Nil
    {% if flag?(:x86_64) %}
      asm("syscall" :: "{rax}"(3_i64), "{rdi}"(fd) : "rcx", "r11", "memory" : "volatile")
    {% else %}
      asm("svc #0" :: "{x8}"(57_i64), "{x0}"(fd) : "memory" : "volatile")
    {% end %}
  end

  # `unlinkat`, with AT_FDCWD and no flags. Syscall 263 on x86_64 and 35 on
  # aarch64.
  def __iyi_unlink(path : UInt8*) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(263_i64), "{rdi}"(-100_i64), "{rsi}"(path), "{rdx}"(0_i64)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(35_i64), "{x0}"(-100_i64), "{x1}"(path), "{x2}"(0_i64)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_read(fd.to_i32, buffer, count)
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_write(fd.to_i32, buffer, count)
  end

  def __iyi_exit(status : Int32) : NoReturn
    {% if flag?(:x86_64) %}
      asm("syscall" :: "{rax}"(231_i64), "{rdi}"(status.to_i64) : "rcx", "r11", "memory" : "volatile")
    {% else %}
      asm("svc #0" :: "{x8}"(94_i64), "{x0}"(status.to_i64) : "memory" : "volatile")
    {% end %}
    while true
    end
  end
{% elsif flag?(:darwin) %}
  # iyi: macOS is not a fallback that happened to work; it is a chosen branch,
  # because it is the machine most developers sit in front of. Apple documents
  # libSystem as the only supported interface and raw syscalls as explicitly
  # not a stable ABI on Darwin, so binding `write` and `exit` here is Apple's
  # rule rather than a compromise this design settled for: libSystem ships
  # with the machine, it is not something a person installs, and Go links it
  # on darwin for the same reason (CGO_ENABLED=0 buys nothing there either).
  lib LibC
    fun write(fd : Int32, buf : Void*, count : UInt64) : Int64
    fun read(fd : Int32, buf : Void*, count : UInt64) : Int64
    fun open(path : UInt8*, oflag : Int32, ...) : Int32
    fun chmod(path : UInt8*, mode : Int32) : Int32
    fun close(fd : Int32) : Int32
    fun unlink(path : UInt8*) : Int32
    fun exit(status : Int32) : NoReturn
  end

  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    LibC.write(fd, buffer, count)
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    LibC.read(fd, buffer, count)
  end

  def __iyi_open_read(path : UInt8*) : Int64
    LibC.open(path, 0).to_i64
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # O_WRONLY|O_CREAT|O_TRUNC = 1|0x0200|0x0400. `open` is variadic for the
    # mode, and `chmod` sets 0644 afterwards because a missing mode on create
    # has produced an unreadable file (execute-only) on this machine.
    fd = LibC.open(path, 1537, 420).to_i64
    LibC.chmod(path, 420) if fd >= 0
    fd
  end

  def __iyi_close(fd : Int64) : Nil
    LibC.close(fd.to_i32)
  end

  def __iyi_unlink(path : UInt8*) : Int64
    LibC.unlink(path).to_i64
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.read(fd.to_i32, buffer, count)
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.write(fd.to_i32, buffer, count)
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibC.exit(status)
  end
{% elsif flag?(:win32) %}
  # iyi: On Windows the platform's own interface is the Win32 API in
  # kernel32, which ships with the machine; Go links kernel32 for the same
  # set of operations. There is no libc `write` to fall back to: the C
  # runtime's POSIX shims are a person-installed choice of CRT, not the
  # platform's contract, so stdout is `WriteFile` on the standard handle and
  # exit is `ExitProcess`. The names and signatures are the ones
  # `src/lib_c/x86_64-windows-msvc/c/` carries for the compiler's own
  # runtime, declared locally rather than required for the same reason as the
  # Linux syscalls above: the prelude is iyi's own world.
  # iyi primitives carry arithmetic on Int32/Int64/UInt8/UInt64 only, so the
  # DWORD-width parameters are declared Int32: same 32 bits at the ABI, and
  # no UInt32 value ever exists in this file to convert.
  #
  # The link is named here because an object LLVM emits carries no
  # `/DEFAULTLIB` directives, which an MSVC-compiled one would: without this,
  # `--cross-compile` prints a command that cannot link what it just produced,
  # and every one of these six functions comes back as an unresolved external.
  #
  # `msvcrt`, `ucrt` and `vcruntime` are the *dynamic* CRT, and they are here
  # for one symbol: this program's entry point is `main`, so something has to
  # supply `mainCRTStartup` to call it. The static CRT (`libcmt`) links just as
  # cleanly and the binary then exits `0xC0000005` before `main` runs, which is
  # why the choice is written down rather than left to whoever links. Emitting
  # an entry point of iyi's own would remove all three, and would be the honest
  # form of "kernel32 and nothing else".
  @[Link("kernel32")]
  @[Link(ldflags: "msvcrt.lib ucrt.lib vcruntime.lib")]
  lib LibC
    fun GetStdHandle(n_std_handle : Int32) : Void*
    fun WriteFile(handle : Void*, buffer : Void*, number_of_bytes_to_write : Int32,
                  number_of_bytes_written : Int32*, overlapped : Void*) : Int32
    fun ReadFile(handle : Void*, buffer : Void*, number_of_bytes_to_read : Int32,
                 number_of_bytes_read : Int32*, overlapped : Void*) : Int32
    fun CreateFileA(name : UInt8*, access : Int32, share : Int32, security : Void*,
                    disposition : Int32, flags : Int32, template : Void*) : Void*
    fun DeleteFileA(name : UInt8*) : Int32
    fun CloseHandle(handle : Void*) : Int32
    fun ExitProcess(exit_code : Int32) : NoReturn
  end

  # GetStdHandle's constants, by their Win32 names: STD_INPUT_HANDLE (-10),
  # STD_OUTPUT_HANDLE (-11), STD_ERROR_HANDLE (-12). They are negative
  # identifiers reinterpreted as DWORD; as Int32 they spell themselves.
  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    std_handle = -11
    std_handle = -12 if fd == 2
    std_handle = -10 if fd == 0
    written = uninitialized Int32
    if LibC.WriteFile(LibC.GetStdHandle(std_handle), buffer,
         count.to_i32, pointerof(written), nil) == 0
      return -1_i64
    end
    written.to_i64
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    std_handle = -10
    read = uninitialized Int32
    if LibC.ReadFile(LibC.GetStdHandle(std_handle), buffer,
         count.to_i32, pointerof(read), nil) == 0
      return 0_i64
    end
    read.to_i64
  end

  # HANDLE is pointer-sized; File carries it as Int64. INVALID_HANDLE_VALUE
  # is all bits set, which as an unsigned address plus one wraps to zero.
  def __iyi_open_read(path : UInt8*) : Int64
    # GENERIC_READ, FILE_SHARE_READ, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL.
    handle = LibC.CreateFileA(path, -2147483648, 1, nil, 3, 128, Pointer(Void).new(0_u64))
    return -1_i64 if handle.address &+ 1_u64 == 0_u64
    handle.address.to_i64
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # GENERIC_WRITE, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL.
    handle = LibC.CreateFileA(path, 1073741824, 0, nil, 2, 128, Pointer(Void).new(0_u64))
    return -1_i64 if handle.address &+ 1_u64 == 0_u64
    handle.address.to_i64
  end

  def __iyi_close(fd : Int64) : Nil
    LibC.CloseHandle(Pointer(Void).new(fd.to_u64))
  end

  def __iyi_unlink(path : UInt8*) : Int64
    return 0_i64 if LibC.DeleteFileA(path) != 0
    -1_i64
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    read = uninitialized Int32
    if LibC.ReadFile(Pointer(Void).new(fd.to_u64), buffer,
         count.to_i32, pointerof(read), nil) == 0
      return 0_i64
    end
    read.to_i64
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    written = uninitialized Int32
    if LibC.WriteFile(Pointer(Void).new(fd.to_u64), buffer,
         count.to_i32, pointerof(written), nil) == 0
      return -1_i64
    end
    written.to_i64
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibC.ExitProcess(status)
  end
{% elsif flag?(:wasm32) %}
  # iyi: On wasm32-wasi the platform's own interface is the WASI import set,
  # which the runtime (wasmtime, wasmer, a browser shim) provides; that is
  # the same standing libSystem and kernel32 have on the other platforms, and
  # the reason the imports are bound by their `__wasi_` names rather than
  # through wasi-libc's POSIX shims. `fd_write` takes an iovec, so one call
  # covers the whole buffer; `proc_exit` is NoReturn the same way `exit`
  # elsewhere is. The declarations mirror `src/crystal/system/wasi/lib_wasi.cr`,
  # which binds `proc_exit` this way too.
  # WASI's own types are fd/size/errno as u32; iyi's primitives carry
  # arithmetic on Int32/Int64/UInt8/UInt64 only, so the u32-width parameters
  # are declared Int32, which is the same 32 bits at the ABI, and no UInt32
  # value ever exists in this file to convert.
  lib LibWasi
    struct Ciovec
      buf : UInt8*
      buf_len : Int32
    end

    fun fd_write = __wasi_fd_write(fd : Int32, iovs : Ciovec*,
                                   iovs_len : Int32, nwritten : Int32*) : Int32
    fun fd_read = __wasi_fd_read(fd : Int32, iovs : Ciovec*,
                                 iovs_len : Int32, nread : Int32*) : Int32
    fun proc_exit = __wasi_proc_exit(code : Int32) : NoReturn
  end

  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    iov = LibWasi::Ciovec.new(buf: buffer.as(UInt8*), buf_len: count.to_i32)
    written = uninitialized Int32
    if LibWasi.fd_write(fd, pointerof(iov), 1, pointerof(written)) != 0
      return -1_i64
    end
    written.to_i64
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    iov = LibWasi::Ciovec.new(buf: buffer.as(UInt8*), buf_len: count.to_i32)
    read = uninitialized Int32
    if LibWasi.fd_read(fd, pointerof(iov), 1, pointerof(read)) != 0
      return 0_i64
    end
    read.to_i64
  end

  # WASI's `path_open` takes a preopened directory fd, a rights bitfield and
  # a path. This prelude has none of those, and pretending a relative path
  # opens would be a silent wrong answer. File methods raise through these.
  def __iyi_open_read(path : UInt8*) : Int64
    raise "File is not available on wasm32-wasi: path_open needs a preopened directory fd"
  end

  def __iyi_open_write(path : UInt8*) : Int64
    raise "File is not available on wasm32-wasi: path_open needs a preopened directory fd"
  end

  def __iyi_close(fd : Int64) : Nil
  end

  # Like path_open, path_unlink_file needs a preopened directory fd and a path
  # relative to it. This prelude has no directory capability to pass.
  def __iyi_unlink(path : UInt8*) : Int64
    raise "File.delete is not available on wasm32-wasi: path_unlink_file needs a preopened directory fd"
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    0_i64
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    -1_i64
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibWasi.proc_exit(status)
  end
{% else %}
  {% raise "iyi: this target is not one iyi's prelude has platform bindings for. " \
           "iyi supports Linux (x86_64, aarch64) via raw syscalls, macOS via " \
           "libSystem, Windows via the Win32 API and wasm32-wasi via the WASI " \
           "imports. Teach src/iyi/prelude.iyi a branch for this platform rather " \
           "than linking something absent." %}
{% end %}

require "./file"

# The allocator, selected rather than declared, because the selection has to be
# a real seam a different allocator is swapped in at. The seam has carried
# three defaults: Boehm (0.1.0), then nothing — allocate and never collect —
# after the dependency floor measured libgc as the last library a default
# build could not refuse (SPEC.md III.9), and now the owned collector, once
# GC_DESIGN.md's stages were built, gated, and measured against both
# predecessors (`bench/gc_default.py`). `-Dgc_boehm` still buys libgc and its
# collection; `-Dgc_none` still buys the bump pointer and its unbounded
# floor-clean speed; a plain build gets the collector that pays for itself.
#
# Written out in full rather than put behind a `GC` module the way the standard
# library has it. There are four call sites and all of them are in this file,
# so the module would buy nothing but a frame on every allocation of a build
# that is not optimised.
{% if flag?(:gc_boehm) %}
  # `pkg_config: "bdw-gc"` is how Crystal's own `gc/boehm.cr` names the
  # library, and it is what lets a homebrew-installed collector link on
  # darwin, where `-lgc` alone has no search path that finds it.
  @[Link("gc", pkg_config: "bdw-gc")]
  lib LibGC
    fun init = GC_init
    fun malloc = GC_malloc(size : UInt64) : Void*
    fun malloc_atomic = GC_malloc_atomic(size : UInt64) : Void*
    fun realloc = GC_realloc(pointer : Void*, size : UInt64) : Void*
  end

  # Codegen emits calls to these by name for every allocation, so they are not
  # optional and their names are not ours to choose.
  # Codegen emits calls to these by name for every allocation, so they are not
  # optional and their names are not ours to choose. Every mode leaves one
  # word under the pointer it answers: codegen stores an object's type id in
  # its high half - the only place the id lives, so an object is its fields
  # and nothing else (GC_DESIGN.md Stage 5) - and an object's layout is one
  # thing under any allocator, which is what lets a module's object code
  # link under any of them. Here the word is the first eight bytes of a
  # block libgc handed out; the program's pointer is an interior one, which
  # libgc follows by default.
  fun __crystal_malloc64(size : UInt64) : Void*
    LibGC.malloc(size + 8_u64) + 8_i64
  end

  fun __crystal_malloc_atomic64(size : UInt64) : Void*
    LibGC.malloc_atomic(size + 8_u64) + 8_i64
  end

  fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
    return __crystal_malloc64(size) if pointer.address == 0
    LibGC.realloc(Pointer(Void).new(pointer.address - 8_u64), size + 8_u64) + 8_i64
  end
{% else %}
  {% if !flag?(:gc_none) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin)) %}
    # iyi: **the default allocator on POSIX is the owned collector.** The
    # size-class arena of GC_DESIGN.md's Stage 2, the roots, the marker,
    # the sweep and the allocation-pressure trigger — a plain `iyi build`
    # gets all of it, and the flip was a measurement before it was a
    # decision (`bench/gc_default.py`, the table in GC_DESIGN.md): the
    # collector wins or ties every time column against the bump pointer
    # and Boehm alike, and holds RSS at the live set where a heap that
    # never frees holds it at the garbage.
    #
    # The doors out: `-Dgc_none` selects the bump pointer below —
    # allocate, never free, the old default, still the right tool for a
    # short-lived program that wants the last nanosecond — and
    # `-Dgc_boehm` selects libgc above. `-Dgc_iyi` still names this
    # branch and is now the default spelled out loud, kept so nothing
    # that passes it changes meaning.
    #
    # **This condition has a twin in the compiler** —
    # `Program#iyi_gc_arena?` in `src/compiler/iyi/codegen/gc_layouts.cr`
    # — which decides whether codegen stores type ids into the header and
    # embeds the layout table. The two must agree: a prelude that scans
    # precisely against a compiler that never wrote an id is merely
    # conservative, but a compiler that writes ids into a header this
    # branch did not allocate is memory corruption. Change both or
    # neither.
    #
    # POSIX and no further, which is deliberate rather than unfinished.
    # Linux binds the arena over raw syscalls and darwin over libSystem,
    # the two interfaces this file already calls the platform's own. win32
    # and wasm32 keep the allocators they have: win32's diagnosis for
    # printing memory it was never given has a fixed suspect — the memset
    # stride defect recorded at that definition below — and the watch in
    # CI is what retires it; wasm32 has no mmap, and its watermark arena
    # is a separate design.
    #
    # Requests are rounded to size classes: 16, 32, 64 and doubling to 1 MiB,
    # seventeen classes. A small fixed set is what keeps allocation and free
    # O(1) list operations, and pure doubling is what keeps the per-class
    # table to one page; the waste against the request is under half in the
    # worst case, the standing trade for never splitting or coalescing. The
    # class is the payload: a chunk is the class plus the twenty-four bytes
    # under the user pointer, and every user pointer stays 8-aligned. A
    # request over 1 MiB is large and gets a mapping of its own.
    #
    # Those twenty-four bytes are the object header, and GC_DESIGN.md's Stage
    # 5 is where they became real. With `P` the pointer the program holds:
    #
    #     P-24   size       u64   the requested size, `realloc`'s contract
    #     P-16   type_id    u32   index into the program's layout table
    #     P-12   pad        u32
    #     P-8    mark_word  u64   colour, flags, reserved; zero is white
    #     P      user data
    #
    # The eight-byte size is Stage 2's, moved down rather than changed: it is
    # still the only place that knows how much to copy when `realloc` crosses
    # a class, and it is still read from under the pointer. The sixteen bytes
    # above it are `Iyi::Collector::ObjectHeader` laid out exactly as
    # `src/compiler/iyi/object_header.cr` defines it, because the compiler
    # emits the type id into that word and this file reads it back.
    #
    # `malloc` cannot write the type id: it is handed a size and nothing
    # else. Codegen writes it at the allocation site, right after the call
    # returns, for every object allocated as an instance of a type. Every
    # other allocation — a `Pointer(T).malloc` buffer, a closure's
    # environment — keeps the zero the allocator leaves there, and zero is
    # the sentinel for "no layout": the mark loop word-scans such an object
    # conservatively instead of trusting a map it does not have. Zero is safe
    # to spend that way because the compiler's numbering gives it to `Nil`
    # alone, which is never allocated and never has a layout.
    #
    # One arena is one contiguous 16 MiB mmap region holding chunks of a
    # single class. Sixteen rather than thirty-two because address space is
    # the cheap half of a mapping (pages commit when touched, on Linux and
    # darwin alike) and a small program pays one arena per class it uses. The
    # first 64 bytes of an arena are its header: the next arena in the heap's
    # list, the mapped length, the chunk size, and the fill cursor with the
    # count of chunks never handed out. Everything that varies per class
    # lives in one mapped page holding seventeen free-list heads and
    # seventeen fill-arena pointers — the thread's cache, since the split
    # the class's own comment describes; the centre's page is seventeen
    # heads and the lock: the language has no array class variable, so
    # seventeen scalars would mean a seventeen-way branch on every
    # allocation, and one zeroed page is the whole table.
    #
    # Allocation pops the class's free list in the thread's cache, refills
    # it from the centre when it is empty, and with both empty carves the
    # next fresh chunk from the cache's fill arena, and with the arena
    # spent it maps another and links it in. Free reads the class back out of
    # the size the header carries and pushes the chunk onto that class's
    # list. Neither walks the arena list: the list exists to be
    # traversed, not to serve the hot path.
    #
    # The clearing contract is the stage's correctness point, because reuse
    # is what is new here. `__crystal_malloc64` is documented to allocate
    # *and clear*, and until now the clear was free: every byte any path
    # handed out came from a fresh mapping, zero-filled by the kernel, and
    # nothing was handed out twice. A free list hands memory back out, so a
    # reused chunk is dirty, and a dirty chunk returned as cleared is the
    # exact shape of the defect that has a win32 binary printing memory it
    # was never given. A chunk popped from a free list is therefore cleared
    # before it is returned; a chunk carved fresh from an arena is not,
    # because the kernel already zeroed it and no second pass is owed. What
    # is cleared is the whole class payload, not the requested size: the
    # class rounds up, and the bytes past the request go to the caller with
    # the chunk, reachable through the size header the next time a realloc
    # grows into them. Zeroed slack keeps a reused chunk indistinguishable
    # from a fresh mapping, the invariant every path in this file provided
    # for free until now. `__crystal_malloc_atomic64` does not clear,
    # matching `GC_malloc_atomic`: atomic means the collector never scans
    # those bytes, so their initial value is no one's contract, and a reused
    # chunk may come back dirty on that path on purpose.
    #
    # The header's own two words are the exception, and they are cleared on
    # every reuse whichever path asked. They are not the caller's bytes, they
    # are the collector's: a stale type id names the layout of whoever held
    # the chunk last, which is a map read over an object that does not have
    # that shape, and a stale mark word hands out an object that is already
    # black and will never be scanned again. Both are false negatives, which
    # is the one class of error this collector cannot tolerate, so the clear
    # is unconditional there.
    #
    # `realloc` keeps the size-header contract: within one class, growing or
    # shrinking, it returns the same chunk with the header rewritten; across
    # classes it allocates, copies the smaller of the two requested sizes,
    # and frees the old chunk. A null pointer still means allocate, through
    # the clearing path, which is what `GC_realloc`'s null means.
    #
    # Large objects, over the top class, get one mmap region each and a node
    # on a separate list: the list's next pointer and the mapped length in
    # the sixteen bytes under the object header, so the forty bytes below a
    # large object's user pointer are next, mapped, then the same
    # size/type_id/mark_word header a class chunk carries. `realloc` and
    # `free` therefore read one layout for both.
    # Free unlinks the node and releases the mapping with `munmap`, checked
    # the way `__iyi_mmap` is checked, because a release that failed quietly
    # would leak the mapping with the node that named it already gone.
    #
    # Addressability is a question Stage 3's root scanning asks of every
    # word, and it is a requirement now: `IyiHeap.containing(pointer)` walks
    # the arena list and answers the containing arena's header address, or 0
    # for a pointer in no arena, and the header's chunk field then names the
    # size class. `IyiHeap.containing_large(pointer)` asks the same of the
    # large-object list. A large object answers 0 from `containing`, because
    # it is in no arena and the answer must never be a wrong arena; 0 from
    # both is how a pointer that is not the heap's is reported. The walk is
    # linear in arenas of 16 MiB each, so it is short; a page directory is
    # Stage 3's optimization if profiles say so, not a Stage 2 requirement.
    # Traversability is the same shape: `first_arena` and `arena_next`
    # enumerate the arenas for Stage 6's sweep, `first_large` and
    # `large_next` the large objects, and a list nothing can enumerate would
    # fail the next stage.
    #
    # The state is five class variables with literal zero initializers plus
    # the cache and centre pages, under the bump branch's rule: `$` globals are
    # refused, a `fun` body cannot reach `@@` state, and literal initializers
    # fold into the LLVM global's static zero, so zero means "not yet mapped"
    # rather than a value startup installs. The entry points below stay
    # `fun`s forwarding one frame into the class, the price of the only
    # state-carrying construct the language offers.
    {% if flag?(:darwin) %}
      # `mmap` and `munmap` are libSystem's here, the same standing `write`
      # has at the top of this file: Apple documents libSystem as the
      # platform's interface and raw syscalls as not a stable ABI.
      # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x1002 on
      # darwin, and a failed `mmap` answers MAP_FAILED rather than -errno.
      lib LibC
        fun mmap(addr : Void*, len : UInt64, prot : Int32, flags : Int32, fd : Int32, offset : Int64) : Void*
        fun munmap(address : Void*, length : UInt64) : Int32
        # The sweep hands a run of dead pages back with `MADV_FREE_REUSABLE`
        # (7), the advice under which darwin's accounting stops counting
        # them; `MADV_DONTNEED` there keeps the pages on the books.
        fun madvise(address : Void*, length : UInt64, advice : Int32) : Int32
        # The pause clock (IyiMark), the same call the scheduler's clock
        # uses on the concurrency targets and the same declaration, so the
        # two `lib` reopenings agree the way `mmap`'s do.
        fun clock_gettime_nsec_np(clock_id : Int32) : UInt64
      end

      fun __iyi_mmap(length : UInt64) : Pointer(Void)
        result = LibC.mmap(Pointer(Void).new(0_u64), length, 3, 0x1002, -1, 0_i64)
        if result.address == 0xFFFFFFFFFFFFFFFF_u64
          __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
        result
      end

      fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
        if LibC.munmap(Pointer(Void).new(address), length) != 0
          __iyi_write(1, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
      end

      fun __iyi_release_pages(address : UInt64, length : UInt64) : Nil
        LibC.madvise(Pointer(Void).new(address), length, 7_i32)
      end
    {% else %}
      # `mmap` the way the bump branch binds it, a raw syscall with the
      # numbers `src/syscall/x86_64-linux.cr` and `aarch64-linux.cr` carry.
      # `munmap` joins it here because large objects are released in this
      # stage: syscall 11 on x86_64 and 215 on aarch64, checked rather than
      # assumed for `__iyi_mmap`'s reason, a failure answered with -errno in
      # the result register rather than a flag.
      fun __iyi_mmap(length : UInt64) : Pointer(Void)
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22.
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(9_i64), "{rdi}"(0_i64), "{rsi}"(length), "{rdx}"(3_i64),
                          "{r10}"(34_i64), "{r8}"(-1_i64), "{r9}"(0_i64)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(222_i64), "{x0}"(0_i64), "{x1}"(length), "{x2}"(3_i64),
                         "{x3}"(34_i64), "{x4}"(-1_i64), "{x5}"(0_i64)
                       : "memory"
                       : "volatile")
        {% end %}
        # A failed raw syscall answers with -errno in the result register
        # rather than a flag: -4095..-1 is errno's whole range.
        if result < 0 && result >= -4095
          __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
        Pointer(Void).new(result.to_u64)
      end

      # `madvise`, syscall 28 on x86_64 and 233 on aarch64. Two pieces of
      # advice are given: `MADV_NOHUGEPAGE` (15) on a mapping that is large
      # and touched only at one end - a mark worker's stack, a helper
      # thread's - which would otherwise be given a transparent huge page
      # at its first touch, two megabytes resident for four kilobytes
      # used, sixteen workers and 34 MB of it; and `MADV_DONTNEED` (4) on
      # a run of pages the sweep found nothing alive in, which hands them
      # back to the kernel while the mapping stays, so the heap's resident
      # size follows the live set and not its high-water mark.
      fun __iyi_madvise(address : UInt64, length : UInt64, advice : Int64) : Nil
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(28_i64), "{rdi}"(address), "{rsi}"(length), "{rdx}"(advice)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(233_i64), "{x0}"(address), "{x1}"(length), "{x2}"(advice)
                       : "memory"
                       : "volatile")
        {% end %}
        # Advice refused (a kernel without THP) is no failure.
      end

      fun __iyi_madvise_nohuge(address : UInt64, length : UInt64) : Nil
        __iyi_madvise(address, length, 15_i64)
      end

      # Pages back to the kernel, the mapping kept: they read as zero when
      # touched again, and the touch is what makes them resident again.
      fun __iyi_release_pages(address : UInt64, length : UInt64) : Nil
        __iyi_madvise(address, length, 4_i64)
      end

      fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(11_i64), "{rdi}"(address), "{rsi}"(length)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(215_i64), "{x0}"(address), "{x1}"(length)
                       : "memory"
                       : "volatile")
        {% end %}
        if result < 0 && result >= -4095
          __iyi_write(1, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
      end
    {% end %}

    class IyiHeap
      MAP = 16777216_u64
      TOP = 1048576_u64
      # The arena's first four kilobytes are its header: the words below,
      # and a bit per page of the mapping saying whether the sweep handed
      # it back. The page is the kernel's: darwin arm64's is 16 KB, and an
      # `madvise` of a four-kilobyte run there is refused.
      HEAD = 4096_u64
      {% if flag?(:darwin) %}
        PAGE = 16384_u64
        PAGE_SHIFT = 14_u64
      {% else %}
        PAGE = 4096_u64
        PAGE_SHIFT = 12_u64
      {% end %}
      DIR_LEN = 4096_u64
      # Size classes: eight-byte steps from 16 to 128, then four to each
      # doubling up to the top class, 67 in all; `FILL` is where a cache's
      # fill arenas start in its table, past the free-list heads.
      CLASSES = 67
      FILL = 80

      # The object header, named once: one word, `HEADER` bytes ahead of
      # the pointer the program holds - the mark word, with the type id in
      # its high half (`object_header.cr` says the bits). It was three words
      # - a size, a type id, a mark word - and the size is the chunk's,
      # which the arena knows, so a 16-byte object cost 40 bytes of heap
      # where Go's costs 16 and Boehm's 16; it costs 24 now. `OFF_MARK` is
      # the word's offset from the chunk head, which is P-8 read from the
      # other end. A free chunk's link and its batch's chain ride in the
      # payload, which is nobody's while it is free. `LARGE_USER` is the
      # distance from a large object's node to its user pointer: the node's
      # next and mapped words, then the header.
      HEADER = 8_u64
      OFF_MARK = 0_u64
      OFF_LINK = 8_u64
      TYPE_SHIFT = 32_u64
      # Bit 2 of the mark word: this chunk is on its class's free list. Set
      # by `free`, cleared with the whole mark word when `take` hands the
      # chunk back out, and what makes "is this chunk free?" one load
      # instead of a walk of the class's list — the O(1) form the root
      # walk's comment said Stage 6 could add when a profile asked. The
      # trigger's steady state asked: a sweep over a heap with a long free
      # list was quadratic, seconds per collection where the arithmetic
      # says microseconds.
      FREE_FLAG = 4_u64
      # Bit 3: this allocation is atomic — the caller promised it holds no
      # pointers, which is what `__crystal_malloc_atomic64` means on every
      # allocator. The mark loop honours it the way Boehm honours
      # `GC_malloc_atomic`: an atomic object with no layout is blackened
      # and never word-scanned, because scanning it is where a 32 MiB
      # `Array(Int32)` buffer turned every triggered collection into 20 ms
      # of `base_of` on integers.
      ATOMIC_FLAG = 8_u64
      # Bit 4: the parity of the epoch this chunk was handed out in. What
      # makes the lazy sweep sound: a white chunk stamped with the current
      # epoch's parity was allocated after the mark that this sweep is for,
      # and is alive by construction; one stamped with the last epoch's was
      # unmarked by it and is dead. A surviving object is restamped when the
      # sweep repaints it, so it is the current epoch's from then on.
      EPOCH_FLAG = 16_u64
      LARGE_USER = 24_u64

      OFF_NEXT = 0_u64
      OFF_MAP = 8_u64
      OFF_CHUNK = 16_u64
      OFF_CURSOR = 24_u64
      OFF_LEFT = 32_u64
      # The collection this arena was last swept for (`IyiMark.epoch`): an
      # arena behind the current epoch still holds the last mark's colours
      # and is sweep debt, paid by the allocator that needs its chunks.
      OFF_EPOCH = 40_u64
      # Objects the last mark blackened in this arena: zero means nothing
      # in it is reachable, and the pause that marked can hand the mapping
      # back with every thread stopped.
      OFF_LIVE = 48_u64
      # The carve frontier: no chunk above it was ever handed out, and the
      # sweep walks up to it. The cursor bumps within a region that ends at
      # `OFF_BUMP_END` - the frontier's is the mapping's end; a run of pages
      # the sweep handed back and the carve took up again is a region too.
      # Chunks between the cursor and the region's end are not carved yet.
      OFF_HIGH = 56_u64
      OFF_BUMP_END = 64_u64
      # Pages handed back and not yet taken up again, counted, and a bit
      # each at `OFF_PAGES`: a chunk whose head is on such a page reads as
      # zero and is nobody's - not free-listed, not an object - until the
      # carve takes its run of pages up as a region.
      OFF_RELEASED = 72_u64
      # 1 while the bump region is a run of pages taken up again, 0 while
      # it is a slab of the frontier.
      OFF_REGION_REOPENED = 80_u64
      # The cache whose fill arena this is, or 0: a bump region is one
      # thread's, carved without a lock, so an arena is one cache's at a
      # time, claimed under the lock when a region is set in it and let
      # go when the cache moves to another.
      OFF_OWNER = 88_u64
      # 1 while an allocator's sweep walks this arena outside the runtime
      # lock: no region is set in it until the walk is over, because the
      # walk reads the region's bounds as two words and a pair from two
      # regions could name an uncarved chunk as carved.
      OFF_SWEEPING = 96_u64
      # Where this epoch's sweep of the arena got to: the next chunk head
      # to look at, SWEEP_DONE once it reached the high water, accurate
      # whenever no slice of the arena is in flight.
      OFF_SWEEP_CURSOR = 104_u64
      SWEEP_DONE = 0xFFFFFFFFFFFFFFFF_u64
      # The epoch whose finished sweep of this arena has been counted out.
      OFF_SWEEP_COUNTED = 112_u64
      OFF_PAGES = 128_u64
      # The frontier is carved a slab at a time, so that a run of pages
      # handed back below it is taken up before the slab after it: the
      # heap fills from its low addresses and the frontier stays cold. A
      # class whose chunk is bigger than a slab carves one chunk at a time.
      SLAB = 65536_u64

      def self.slab_for(chunk : UInt64) : UInt64
        chunk + HEAD > SLAB ? chunk + HEAD : SLAB
      end

      # ── Whose state is whose ──────────────────────────────────────────
      #
      # The allocator was one thread's class variables — the directory
      # page of free-list heads and fill arenas — and the thread floor named
      # that as the first cost of a second thread (GC_DESIGN.md). It is two
      # things now, and the split is Go's: a **cache per thread** and a
      # **centre** everything else shares.
      #
      # The cache is one page a `@[ThreadLocal]` address names — `Tls.line`
      # in the probe, the scheduler's state pointer here — laid out as the
      # directory was: a free-list head per class at `[index]`, the class's
      # fill arena at `[FILL + index]`, and word `CACHE_NEXT` linking every
      # cache ever made from `@@caches`, so the sweep's scavenge can strip
      # all of them and a stopped thread's cache is reachable by the thread
      # that stops it. The fast path — pop the cache's list, or carve the
      # cache's own arena — takes no lock and touches no shared word; what
      # it costs is one thread-local read per allocation, and
      # `bench/arena_exercise.sh` prints the number.
      #
      # The centre is the class free lists the sweep fills, the arena list
      # and the large list, behind one spin lock (`CENTRAL_LOCK`, a word on
      # the centre's page, taken with the prelude's `Atomic`). A cache that
      # runs dry takes the lock and takes the class's whole central list —
      # one pointer swap, the same cost as today with one thread; a bounded
      # batch is the fairness a profile with two threads may ask for, and
      # it is not guessed here. `map_arena` and `take_large` push under the
      # lock; `free` pushes to the centre under it, and the sweep frees an
      # arena's chunks as one batch under one take of it.
      #
      # What this decides for Stage 4, said now: a thread stopped while it
      # holds `CENTRAL_LOCK` — inside a refill, a carve that maps, a free —
      # deadlocks a sweep that needs the lock. So the stop handler must not
      # park a thread that holds it: the lock word is the thread's own to
      # check, and a held lock defers the park to the release, which is
      # Go's "no preemption inside mallocgc". One thread never contends,
      # and the lock is one uncontended `compare_and_set` per refill.
      # The cache page past its two tables: the link, the pressure slice
      # (bytes this cache allocated since it last told the trigger), and
      # the two words the stop reads and writes — set while the thread is
      # inside `take`, and the request a handler leaves when it finds it
      # there. The centre's page past its table: the allocated-since count
      # every cache folds its slice into, an atomic, and the trigger's.
      CACHE_NEXT    = 1280_u64
      CACHE_SLICE   = 1288_u64
      CACHE_INSIDE  = 1296_u64
      CACHE_REQUEST = 1304_u64
      SLICE         = 65536_u64
      CENTRAL_ALLOCATED = 1280_u64

      @[ThreadLocal]
      @@cache : UInt64 = 0_u64
      @@caches : UInt64 = 0_u64
      @@central : UInt64 = 0_u64
      @@arenas : UInt64 = 0_u64
      @@large : UInt64 = 0_u64

      def self.read64(address : UInt64) : UInt64
        Pointer(UInt64).new(address).value
      end

      def self.write64(address : UInt64, value : UInt64) : Nil
        Pointer(UInt64).new(address).value = value
      end

      # This thread's cache, mapped on first touch and linked for the
      # scavenge before the thread-local names it.
      def self.cache : Pointer(UInt64)
        page = @@cache
        if page == 0
          page = __iyi_mmap(DIR_LEN).address
          lock
          # The shared pages, made under the same lock the first time any
          # thread reaches the heap: two threads' first allocations would
          # otherwise each map a centre of their own.
          @@central = __iyi_mmap(DIR_LEN).address if @@central == 0
          @@arena_dir = __iyi_mmap(DIR_SLOTS).address if @@arena_dir == 0
          write64(page + CACHE_NEXT, @@caches)
          @@caches = page
          unlock
          @@cache = page
        end
        Pointer(UInt64).new(page)
      end

      def self.first_cache : UInt64
        @@caches
      end

      def self.cache_next(page : UInt64) : UInt64
        read64(page + CACHE_NEXT)
      end

      # A thread's last act with the heap: its cache's lists go to the
      # centre as batches, its fill arenas are let go (they stay on the
      # heap's list and are the scavenge's from now on, no longer anyone's
      # warm cushion), the page leaves the caches list, and the thread
      # allocates nothing after. A cache left behind pinned an arena per
      # class forever and cost every later sweep a walk of it.
      def self.retire_cache : Nil
        page = @@cache
        return if page == 0
        table = Pointer(UInt64).new(page)
        lock
        index = 0
        while index < FILL
          head = table[index]
          if head != 0
            free_batch(index, head)
            table[index] = 0_u64
          end
          fill = table[FILL + index]
          write64(fill + OFF_OWNER, 0_u64) if fill != 0 && read64(fill + OFF_OWNER) == page
          table[FILL + index] = 0_u64
          index = index + 1
        end
        previous = 0_u64
        cursor = @@caches
        while cursor != 0
          following = read64(cursor + CACHE_NEXT)
          if cursor == page
            if previous == 0
              @@caches = following
            else
              write64(previous + CACHE_NEXT, following)
            end
            break
          end
          previous = cursor
          cursor = following
        end
        unlock
        @@cache = 0_u64
        __iyi_munmap(page, DIR_LEN)
      end

      # The stop's view of this thread, read from a signal handler: a
      # thread with no cache yet has never been inside the allocator.
      def self.in_allocator? : Bool
        page = @@cache
        page != 0 && read64(page + CACHE_INSIDE) != 0
      end

      def self.request_stop : Nil
        write64(@@cache + CACHE_REQUEST, 1_u64)
      end

      def self.stop_requested? : Bool
        page = @@cache
        page != 0 && read64(page + CACHE_REQUEST) != 0
      end

      def self.clear_request : Nil
        write64(@@cache + CACHE_REQUEST, 0_u64)
      end

      def self.central : Pointer(UInt64)
        if @@central == 0
          @@central = __iyi_mmap(DIR_LEN).address
        end
        Pointer(UInt64).new(@@central)
      end

      # How many arenas of a class have sweeping left this epoch, on the
      # centre's page past the lists: the allocator's answer without the
      # lock to whether a slice of the class is worth taking. Written
      # under the lock, read without it - a stale nonzero takes the lock
      # and finds nothing, a stale zero carves a chunk a sweep would have
      # handed back later.
      SWEEP_LEFT_AT = 256

      def self.sweep_left_of(index : Int32) : UInt64
        central[SWEEP_LEFT_AT + index]
      end

      def self.sweep_left_add(index : Int32, delta : Int64) : Nil
        centre = central
        centre[SWEEP_LEFT_AT + index] = (centre[SWEEP_LEFT_AT + index].to_i64 + delta).to_u64
      end

      def self.allocated_word : Pointer(Atomic(UInt64))
        Pointer(Atomic(UInt64)).new(central.address + CENTRAL_ALLOCATED)
      end

      def self.lock : Nil
        IyiRuntimeLock.lock
      end

      def self.unlock : Nil
        IyiRuntimeLock.unlock
      end

      # The class a request lands in. Eight-byte steps to 128 are a shift;
      # above, the doubling is found by a loop and the quarter within it
      # by a division. Power-of-two classes wasted up to half a chunk on
      # every object between two of them - a 24-byte object, two pointers
      # behind its type id, the commonest shape a program has, in a
      # 32-byte class - and these cap the waste at eight bytes below 128
      # and a fifth above.
      def self.class_index(size : UInt64) : Int32
        return ((size + 7_u64).unsafe_shr(3_u64).to_i64 - 2_i64).to_i32 if size > 16_u64 && size <= 128_u64
        return 0 if size <= 16_u64
        base = 128_u64
        index = 15
        while base + base < size
          base = base + base
          index = index + 4
        end
        step = base.unsafe_shr(2_u64)
        index + ((size - base + step - 1_u64).unsafe_div(step)).to_i64.to_i32 - 1
      end

      def self.payload(index : Int32) : UInt64
        return (index.to_i64 + 2_i64).to_u64 * 8_u64 if index < 15
        above = (index - 15).to_i64.to_u64
        base = 128_u64.unsafe_shl(above.unsafe_shr(2_u64))
        base + ((above & 3_u64) + 1_u64) * base.unsafe_shr(2_u64)
      end

      def self.class_for(size : UInt64) : UInt64
        payload(class_index(size))
      end

      def self.alloc(size : UInt64) : Void*
        Pointer(Void).new(take(size, true) + HEADER)
      end

      def self.alloc_atomic(size : UInt64) : Void*
        Pointer(Void).new(take(size, false) + HEADER)
      end

      # The one funnel. The cache page's INSIDE word is set for the whole
      # of it, so a stop that lands in here is deferred to the exit rather
      # than taken between reading a list's head and popping it, and the
      # exit is where a deferred stop is paid. The pressure report is a
      # slice: this cache's bytes since it last told the trigger, folded
      # into the centre's atomic count every SLICE bytes, so a thread's
      # allocations cost no shared write until then.
      def self.take(size : UInt64, clear : Bool) : UInt64
        table = cache
        # The arithmetic on the way in and out is wrapping: a counter on
        # a page cannot overflow, and a checked add is a branch each on
        # the path every allocation takes.
        write64(table.address + CACHE_INSIDE, read64(table.address + CACHE_INSIDE) &+ 1_u64)
        slice = read64(table.address + CACHE_SLICE) &+ size
        if slice >= SLICE
          write64(table.address + CACHE_SLICE, 0_u64)
          # Before the carve: a collection triggered here cannot sweep the
          # object about to be born, because it does not exist yet, and
          # everything already born is reachable or fair game. Under a
          # mark, a slice's worth of allocation buys a slice's worth of
          # marking on this thread first - the assist.
          if LibIyiGCTable.__iyi_marking != 0_u8
            IyiMark.assist
          else
            IyiMark.pressure(slice)
          end
        else
          write64(table.address + CACHE_SLICE, slice)
        end
        head = take_inside(table, size, clear)
        # Born while a mark runs beside the program: gray, and on this
        # thread's barrier stack, so a worker scans it once its fields are
        # written — every write to them goes through the barrier — and
        # counts it alive in its arena.
        IyiMark.born_during_mark(head + HEADER, size_of(head + HEADER)) if LibIyiGCTable.__iyi_marking != 0_u8
        leave(table)
        head
      end

      # Out of the allocator, or the barrier: the depth counter down, and
      # a stop that was deferred while it was up is paid now.
      def self.leave(table : Pointer(UInt64)) : Nil
        write64(table.address + CACHE_INSIDE, read64(table.address + CACHE_INSIDE) &- 1_u64)
        {% if !flag?(:gc_none) && !flag?(:gc_boehm) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64))) %}
          if read64(table.address + CACHE_INSIDE) == 0_u64 && read64(table.address + CACHE_REQUEST) != 0
            IyiThread.park_if_requested
          end
        {% end %}
      end

      # The write barrier's bracket (GC_DESIGN.md Stage 9), the same depth
      # counter the allocator uses: a thread between a pointer store and
      # the barrier that shades it is not parked where it stands, or the
      # final stop's rescan could miss what the store just put into a
      # black object.
      def self.enter_barrier : Nil
        table = cache
        write64(table.address + CACHE_INSIDE, read64(table.address + CACHE_INSIDE) + 1_u64)
      end

      def self.leave_barrier : Nil
        leave(cache)
      end

      def self.take_inside(table : Pointer(UInt64), size : UInt64, clear : Bool) : UInt64
        return take_large(size, clear) if size > TOP
        # The small classes' index inline: `class_index` has a loop for
        # the large ones and is a call, and a call is what most
        # allocations would pay for a shift.
        index = size <= 128_u64 ? (size <= 16_u64 ? 0 : ((size &+ 7_u64).unsafe_shr(3_u64).to_i64 &- 2_i64).to_i32) : class_index(size)
        head = table[index]
        head = refill(table, index) if head == 0
        if head != 0
          table[index] = read64(head + OFF_LINK)
          # The header word first, on both paths: it is the collector's
          # word rather than the caller's, and a stale one is a live object
          # the mark loop misses; the type id in its high half is zero
          # until codegen stores one. `clear` is the atomic question worn
          # the other way: the path that does not clear is exactly the
          # path whose caller promised no pointers.
          write64(head + OFF_MARK, (clear ? 0_u64 : ATOMIC_FLAG) | IyiMark.epoch_flag)
          clear_block(head + HEADER, payload(index)) if clear
          return head
        end
        head = carve(table, index)
        write64(head + OFF_MARK, ATOMIC_FLAG | IyiMark.epoch_flag) unless clear
        head
      end

      # The cache's list for this class is empty: take the centre's top
      # batch for it, under the lock — one arena's sweep, `free_batch`
      # says why one. Answers the new head, 0 if the centre had nothing.
      def self.refill(table : Pointer(UInt64), index : Int32) : UInt64
        centre = central
        if centre[index] == 0
          # Nothing swept for this class yet: a slice of an arena of the
          # class, and another, until a batch of the class appears or the
          # class has nothing left to sweep - the sweep's cost lands on
          # the allocations that need its chunks rather than inside the
          # pause (GC_DESIGN.md), and a chunk swept is cheaper than one
          # carved, a page faulted in costing what a hundred sweep. A
          # helper inside a slice of the only arena of the class answers
          # busy: its batch is microseconds away, and the wait is for
          # that. With helpers at a round the class is named for them.
          IyiMark.sweep_wanted(index) if IyiMark.helpers_sweeping?
          chunk = payload(index) + HEADER
          while centre[index] == 0 && sweep_left_of(index) != 0_u64
            answer = IyiMark.sweep_one(chunk)
            break if answer == 0_u64
            if answer == 2_u64
              # Every arena of the class is inside another thread's
              # slice: its batch lands within the slice, microseconds,
              # and the wait for it is off the lock. Carving instead was
              # tried and costs: a fresh page is a fault where a swept
              # chunk is free, and churn - whose every refill meets a
              # helper mid-slice - ran 40 ms to 59.
              spins = 0
              while centre[index] == 0 && spins < 256
                IyiMark.spin_pause
                spins = spins + 1
              end
            end
          end
          return 0_u64 if centre[index] == 0
        end
        lock
        head = centre[index]
        centre[index] = read64(head + BATCH_NEXT) if head != 0
        unlock
        table[index] = head
        head
      end

      def self.carve(table : Pointer(UInt64), index : Int32) : UInt64
        arena = table[FILL + index]
        if arena == 0 || read64(arena + OFF_LEFT) == 0 ||
           (read64(arena + OFF_RELEASED) != 0 && read64(arena + OFF_REGION_REOPENED) == 0)
          # The region ran out, or it is a frontier slab and pages below
          # it came back: the lowest run of pages the sweep handed back,
          # in this arena or another of the class, then the frontier's
          # next slab, then a fresh mapping.
          arena = reopen_pages(table, arena, index)
          table[FILL + index] = arena
        end
        cursor = read64(arena + OFF_CURSOR)
        # The chunk's stamp before the cursor moves past it, and the cursor
        # as an ordered store: a lazy sweeper on another thread reads the
        # cursor and then the chunks below it, and a chunk it can see must
        # already wear this epoch's parity or it would read as last
        # epoch's dead — freed under the thread about to hand it out.
        write64(cursor + OFF_MARK, IyiMark.epoch_flag)
        following = cursor &+ read64(arena + OFF_CHUNK)
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.set(following)
        write64(arena + OFF_LEFT, read64(arena + OFF_LEFT) &- 1_u64)
        write64(arena + OFF_HIGH, following) if following > read64(arena + OFF_HIGH)
        cursor
      end

      # ── Pages handed back, and taken up again ──────────────────────────
      #
      # A collector that frees chunks but never pages has a resident size
      # that is its high-water mark: binary trees held 6 MB live in 55 MB
      # resident. The sweep hands runs of dead pages back to the kernel
      # (`sweep_slice` below), and here the carve takes a run up again as
      # its bump region before it maps anything new. A chunk is on a
      # released page when its head is: such a chunk is on no list and is
      # no object, it reads as zero, and the mark, the sweep and the root
      # walk all refuse it by the bit. Taking a run up clears its bits
      # under the lock the sweep holds, so a sweep sees a region whole.
      def self.page_released?(arena : UInt64, address : UInt64) : Bool
        page = (address - arena).unsafe_shr(PAGE_SHIFT)
        word = read64(arena + OFF_PAGES + page.unsafe_shr(6_u64) * 8_u64)
        word & 1_u64.unsafe_shl(page & 63_u64) != 0
      end

      def self.set_released(arena : UInt64, low : UInt64, high : UInt64, on : Bool) : Nil
        page = (low - arena).unsafe_shr(PAGE_SHIFT)
        stop = (high - arena).unsafe_shr(PAGE_SHIFT)
        while page < stop
          slot = arena + OFF_PAGES + page.unsafe_shr(6_u64) * 8_u64
          bit = 1_u64.unsafe_shl(page & 63_u64)
          if on
            write64(slot, read64(slot) | bit)
          else
            write64(slot, read64(slot) & (0xFFFFFFFFFFFFFFFF_u64 - bit))
          end
          page = page + 1_u64
        end
      end

      # `arena`'s own released pages first, then its frontier's next slab,
      # then any other arena of the class with released pages or frontier
      # left, then a fresh mapping. Answers the arena whose region the
      # carve now bumps in.
      # The whole choice is one take of the lock: the lock's spin parks
      # for a pause, whose scavenge hands arenas back, so an arena read
      # off the list outside the lock is not an arena to trust across a
      # take of it - the first cut walked the list between takes and
      # crashed reading an arena the pause had unmapped.
      def self.reopen_pages(table : Pointer(UInt64), arena : UInt64, index : Int32) : UInt64
        owner = table.address
        lock
        chosen = 0_u64
        if arena != 0
          chosen = arena if read64(arena + OFF_RELEASED) != 0 && reopen_in(arena, owner)
          chosen = arena if chosen == 0 && next_slab(arena, owner)
        end
        chunk = payload(index) + HEADER
        candidate = @@arenas
        while candidate != 0 && chosen == 0
          if candidate != arena && read64(candidate + OFF_CHUNK) == chunk && read64(candidate + OFF_OWNER) == 0
            if read64(candidate + OFF_RELEASED) != 0 && reopen_in(candidate, owner)
              chosen = candidate
            elsif next_slab(candidate, owner)
              chosen = candidate
            end
          end
          candidate = read64(candidate + OFF_NEXT)
        end
        # The old arena is nobody's from here, whatever was chosen: a
        # fresh mapping claims itself as it is made.
        write64(arena + OFF_OWNER, 0_u64) if arena != 0 && chosen != arena && read64(arena + OFF_OWNER) == owner
        unlock
        chosen = map_arena(index, owner) if chosen == 0
        chosen
      end

      # Whether the arena is still an arena, under the lock: the directory
      # byte is cleared before the unmap, under the same lock.
      def self.mapped?(arena : UInt64) : Bool
        Pointer(UInt8).new(arena_dir + arena.unsafe_shr(24_u64)).value != 0_u8
      end

      # Under the lock: whether `owner` may set a region in `arena`, which
      # it may when nobody's fill arena it is, or its own. The claim is
      # written when a region is set, not here: a candidate tried and
      # found spent stayed claimed by the cache that tried it, and the
      # scavenge, which leaves a claimed arena alone, kept the spike's
      # twenty mappings for a cache that had moved on from all of them.
      def self.claimable?(arena : UInt64, owner : UInt64) : Bool
        current = read64(arena + OFF_OWNER)
        current == 0 || current == owner
      end

      # The frontier's next slab as the bump region: from the high-water
      # mark, `SLAB` bytes or what the mapping has left. False when the
      # mapping is carved to its end. Under the lock.
      def self.next_slab(arena : UInt64, owner : UInt64) : Bool
        return false if read64(arena + OFF_SWEEPING) != 0 || !claimable?(arena, owner)
        high = read64(arena + OFF_HIGH)
        top = arena + read64(arena + OFF_MAP)
        chunk = read64(arena + OFF_CHUNK)
        # The frontier stays on the chunk grid: a tail shorter than a
        # chunk is the mapping spent, and `high` is left where the last
        # chunk ended, because the sweep walks to it and would take a
        # tail it was moved over for a chunk.
        return false if high + chunk > top
        stop = high + slab_for(chunk)
        stop = top if stop > top
        count = (stop - high).unsafe_div(chunk)
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.set(high)
        write64(arena + OFF_BUMP_END, high + count * chunk)
        write64(arena + OFF_LEFT, count)
        write64(arena + OFF_REGION_REOPENED, 0_u64)
        write64(arena + OFF_OWNER, owner)
        true
      end

      # The first run of released pages in `arena` becomes its bump region,
      # under the lock.
      # The region's chunks are the grid chunks whose head is on its pages;
      # the one straddling its start belongs to the page before, on a free
      # list, and the one straddling its end is the region's, its tail on
      # a page nobody released.
      def self.reopen_in(arena : UInt64, owner : UInt64) : Bool
        return false if read64(arena + OFF_SWEEPING) != 0 || !claimable?(arena, owner)
        chunk = read64(arena + OFF_CHUNK)
        pages = read64(arena + OFF_MAP).unsafe_shr(PAGE_SHIFT)
        page = 1_u64
        while page < pages && !page_released?(arena, arena + page * PAGE)
          page = page + 1_u64
        end
        return false if page == pages
        stop = page
        while stop < pages && page_released?(arena, arena + stop * PAGE)
          stop = stop + 1_u64
        end
        low = arena + page * PAGE
        high = arena + stop * PAGE
        set_released(arena, low, high, false)
        write64(arena + OFF_RELEASED, read64(arena + OFF_RELEASED) - (stop - page))
        first = arena + HEAD
        head = first + (low - first + chunk - 1_u64).unsafe_div(chunk) * chunk
        count = head < high ? (high - head + chunk - 1_u64).unsafe_div(chunk) : 0_u64
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.set(head)
        write64(arena + OFF_BUMP_END, high)
        write64(arena + OFF_LEFT, count)
        write64(arena + OFF_REGION_REOPENED, 1_u64)
        write64(arena + OFF_OWNER, owner) if count != 0
        @@pages_reopened = @@pages_reopened + (stop - page)
        count != 0
      end

      @@pages_released : UInt64 = 0_u64
      @@pages_reopened : UInt64 = 0_u64

      # Pages the sweep handed back, and pages the carve took up again, in
      # all: the exercises read both.
      def self.pages_released : UInt64
        @@pages_released
      end

      def self.pages_reopened : UInt64
        @@pages_reopened
      end

      def self.pages_released_add(count : UInt64) : Nil
        Pointer(Atomic(UInt64)).new(pointerof(@@pages_released).address).value.add(count)
      end

      # A chunk nobody was handed, as a reader without the lock may ask -
      # the mark, from any thread, while a carve runs: above the frontier,
      # or on a released page. The uncarved part of a taken-up region is
      # not named here, because its bounds are two words a carve moves and
      # a reader could pair a new cursor with the old end and refuse a
      # live object above the region; a chunk of that part read as carved
      # instead is a zero header the mark shades and scans as nothing,
      # which the carve's own stamp then overwrites. Wrong in the safe
      # direction, and only for a stale word that happens to land there.
      def self.uncarved?(arena : UInt64, head : UInt64) : Bool
        head >= read64(arena + OFF_HIGH) || page_released?(arena, head)
      end

      # The same question under the lock, which the sweep holds and a
      # region change takes: the uncarved part of the bump region is
      # exact here, and the sweep must not free it.
      def self.uncarved_held?(arena : UInt64, head : UInt64) : Bool
        return true if head >= read64(arena + OFF_HIGH)
        return true if head >= arena_cursor(arena) && head < read64(arena + OFF_BUMP_END)
        page_released?(arena, head)
      end

      # Every arena is MAP-aligned, and a byte per MAP-sized slot of the
      # address space says whether the slot is an arena: `arena_of` is an
      # AND, a shift and a load, where it was a walk of the arena list per
      # pointer the marker met — the walk was most of a mark. The
      # directory is a mapping of 2^24 bytes for a 48-bit space, reserved
      # once and committed a page at a time as arenas land in it; the
      # kernel charges nothing for the untouched rest.
      DIR_SLOTS = 16777216_u64

      @@arena_dir : UInt64 = 0_u64

      def self.arena_dir : UInt64
        @@arena_dir = __iyi_mmap(DIR_SLOTS).address if @@arena_dir == 0
        @@arena_dir
      end

      # The arena holding `address`, or 0. One load past the arithmetic; a
      # pointer into an arena's header or past its fill cursor is the
      # caller's to refuse.
      def self.arena_of(address : UInt64) : UInt64
        slot = address.unsafe_shr(24_u64)
        return 0_u64 if slot >= DIR_SLOTS
        return 0_u64 if Pointer(UInt8).new(arena_dir + slot).value == 0_u8
        address & (0_u64 &- MAP)
      end

      # A MAP-aligned mapping of MAP bytes: ask for twice, keep the aligned
      # middle, give the ends back.
      def self.map_aligned : UInt64
        raw = __iyi_mmap(MAP * 2_u64).address
        base = (raw + MAP - 1_u64) & (0_u64 &- MAP)
        __iyi_munmap(raw, base - raw) if base > raw
        tail = raw + MAP * 2_u64 - (base + MAP)
        __iyi_munmap(base + MAP, tail) if tail > 0
        base
      end

      # Arenas below this many - 128 MB - are refused transparent huge pages: a
      # huge page given to an arena's first touch is two megabytes
      # resident for a class with ten objects in it, and eight such
      # arenas were 16 MB of binary trees' footprint. Past it the heap is
      # large, the two megabytes are a rounding of it, and the page walk
      # the huge pages save is what a large heap pays most: live churn,
      # 48 MB live, ran 17% faster on them.
      HUGE_FROM = 8_u64
      @@arenas_mapped : UInt64 = 0_u64

      def self.map_arena(index : Int32, owner : UInt64) : UInt64
        base = map_aligned
        {% if flag?(:linux) %}
          __iyi_madvise_nohuge(base, MAP) if @@arenas_mapped < HUGE_FROM
        {% end %}
        @@arenas_mapped = @@arenas_mapped &+ 1_u64
        chunk = payload(index) + HEADER
        write64(base + OFF_MAP, MAP)
        write64(base + OFF_CHUNK, chunk)
        slab = slab_for(chunk)
        write64(base + OFF_CURSOR, base + HEAD)
        write64(base + OFF_LEFT, (slab - HEAD).unsafe_div(chunk))
        write64(base + OFF_HIGH, base + HEAD)
        write64(base + OFF_BUMP_END, base + slab)
        write64(base + OFF_OWNER, owner)
        lock
        # Fresh chunks are white and nobody's: swept for the current epoch
        # by construction — the epoch read under the lock, because a thread
        # that read it before parking in this very spin, through a pause
        # that turned it, would link an arena that looked like debt and was
        # not counted as any: the next pause's debt loop swept it in place
        # of a real one, a real one kept the last mark's black, and the mark
        # that followed counted nothing alive in it. The scavenge then
        # handed a mapping full of live objects back to the kernel.
        write64(base + OFF_EPOCH, IyiMark.epoch)
        # And nothing of it left to sweep: everything carved from it
        # wears the epoch's parity.
        write64(base + OFF_SWEEP_CURSOR, SWEEP_DONE)
        write64(base + OFF_NEXT, @@arenas)
        @@arenas = base
        # The directory byte last, after the header and the link: a reader
        # that finds the byte finds an arena that is whole.
        Pointer(UInt8).new(arena_dir + base.unsafe_shr(24_u64)).value = 1_u8
        unlock
        base
      end

      def self.take_large(size : UInt64, clear : Bool) : UInt64
        mapped = size + LARGE_USER
        base = __iyi_mmap(mapped).address
        write64(base + OFF_MAP, mapped)
        write64(base + 16 + OFF_MARK, (clear ? 0_u64 : ATOMIC_FLAG) | IyiMark.epoch_flag)
        lock
        write64(base + OFF_NEXT, @@large)
        @@large = base
        unlock
        base + 16
      end

      # One chunk back, to the calling thread's own cache and no lock:
      # `realloc`'s old chunk, and the exercises' hand-frees, come from the
      # thread that will allocate next, and a grow-by-doubling loop that
      # paid two lock cycles per step measured 61 ns an alloc+free pair
      # against 27 with the chunk kept local. The sweep does not come
      # through here; it has `free_batch`, to the centre.
      def self.free(pointer : Void*) : Nil
        return if pointer.address == 0
        head = pointer.address - HEADER
        arena = arena_of(head)
        if arena != 0
          index = class_index(read64(arena + OFF_CHUNK) - HEADER)
          table = cache
          write64(head + OFF_MARK, read64(head + OFF_MARK) | FREE_FLAG)
          write64(head + OFF_LINK, table[index])
          table[index] = head
        else
          lock
          free_large(head)
          unlock
        end
      end

      # Every free list emptied, under the lock with every thread stopped:
      # the sweep's `begin_sweep` says why.
      def self.drop_free_lists : Nil
        centre = central
        index = 0
        while index < CLASSES
          centre[index] = 0_u64
          index = index + 1
        end
        page = @@caches
        while page != 0
          table = Pointer(UInt64).new(page)
          index = 0
          while index < CLASSES
            table[index] = 0_u64
            index = index + 1
          end
          page = read64(page + CACHE_NEXT)
        end
      end

      # The bytes under a pointer: its chunk's payload, or its mapping's.
      # What the header used to carry as a third word, answered from the
      # arena or the large node instead.
      def self.size_of(base : UInt64) : UInt64
        arena = arena_of(base)
        return read64(arena + OFF_CHUNK) - HEADER if arena != 0
        read64(base - LARGE_USER + OFF_MAP) - LARGE_USER
      end

      # An arena's worth of swept chunks, already flagged and linked head to
      # tail by the sweep, pushed onto the centre as one batch: the centre
      # keeps a class's chunks as a stack of batches, each one arena's
      # sweep, chained through the first payload words of each batch's head
      # (a free chunk's payload is nobody's; the cache overwrites them when
      # it hands the head out). A refill takes one batch, which is how the
      # centre is shared rather than hoarded — the whole-list refill let
      # one of eight threads take every chunk and the other seven carve,
      # and the heap and every sweep grew with it. The sweep runs under
      # the collector's own take of the lock, with every other thread
      # stopped, so nothing here takes it again.
      BATCH_NEXT = 16_u64

      def self.free_batch(index : Int32, head : UInt64) : Nil
        centre = central
        write64(head + BATCH_NEXT, centre[index])
        centre[index] = head
      end

      # Under the lock, whoever holds it: `free` takes it for a mutator's
      # large chunk, the sweep already has it.
      def self.free_large(head : UInt64) : Nil
        base = head - 16
        previous = 0_u64
        node = @@large
        while node != 0
          if node == base
            if previous == 0
              @@large = read64(node)
            else
              write64(previous, read64(node))
            end
            break
          end
          previous = node
          node = read64(node)
        end
        __iyi_munmap(base, read64(base + 8))
      end

      # Hand one empty arena's mapping back to the kernel — the sweep's
      # scavenge, kept here because every word it touches is this class's
      # own state. Any cache's current fill arena answers false: one warm
      # arena per class per thread is the cushion that keeps spike-then-idle
      # from paying an mmap on its next allocation. Every free list was
      # dropped before the scavenge began, so no list holds a chunk of
      # this mapping (stripping them here, when they held the last
      # epoch's chunks, was 7 ms of a stop); the arena leaves the heap's
      # own list so `containing` never walks into a hole, and only then
      # does the mapping go back.
      def self.release_arena(previous : UInt64, arena : UInt64) : Bool
        # A walk in flight on a stopped thread holds chunks of this arena
        # in a batch it has yet to hand over; a cache that claimed it has
        # yet to write it into its table - it parked in the lock spin of
        # letting its old arena go, this arena's address in a register.
        return false if read64(arena + OFF_SWEEPING) != 0 || read64(arena + OFF_OWNER) != 0
        chunk = read64(arena + OFF_CHUNK)
        index = class_index(chunk - HEADER)
        page = @@caches
        while page != 0
          return false if Pointer(UInt64).new(page)[FILL + index] == arena
          page = read64(page + CACHE_NEXT)
        end
        if previous == 0
          @@arenas = read64(arena + OFF_NEXT)
        else
          write64(previous + OFF_NEXT, read64(arena + OFF_NEXT))
        end
        Pointer(UInt8).new(arena_dir + arena.unsafe_shr(24_u64)).value = 0_u8
        # Off the heap's list and out of the directory inside the stop,
        # so nothing finds it; the unmap itself waits for the program to
        # be running again - the kernel frees a resident mapping's four
        # thousand pages in half a millisecond, ten of them were the
        # whole of a 5 ms stop, and a released arena is nobody's to touch.
        write64(arena + OFF_NEXT, @@to_unmap)
        @@to_unmap = arena
        true
      end

      @@to_unmap : UInt64 = 0_u64

      # The mappings the last scavenge let go, handed back: the collector's
      # own time after it resumed the program.
      def self.unmap_released : Nil
        arena = @@to_unmap
        @@to_unmap = 0_u64
        while arena != 0
          following = read64(arena + OFF_NEXT)
          __iyi_munmap(arena, read64(arena + OFF_MAP))
          arena = following
        end
      end

      def self.arena_live(arena : UInt64) : UInt64
        read64(arena + OFF_LIVE)
      end

      def self.arena_live_reset(arena : UInt64) : Nil
        write64(arena + OFF_LIVE, 0_u64)
      end


      # Same-chunk growth within a class, allocate-and-copy across one,
      # because the old size rides under the object header, which is the only
      # place that knows it. The new chunk's type id stays zero, which is
      # right: a reallocated buffer is raw memory whose old map, if it had
      # one, described a different number of bytes, and zero means the mark
      # loop word-scans it conservatively instead. The ATOMIC promise does
      # travel: the caller's "no pointers in here" is about the data, and
      # the data is what the copy carries — dropping the flag on growth is
      # how an `Array(Int32)` buffer got word-scanned at every doubling.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        head = pointer.address - HEADER
        old_size = size_of(pointer.address)
        atomic = read64(head + OFF_MARK) & ATOMIC_FLAG != 0
        return pointer if size <= old_size && (size > TOP) == (old_size > TOP)
        new_pointer = Pointer(Void).new(take(size, !atomic) + HEADER)
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        # The copy was bytes, invisible to the barrier the compiler puts on
        # pointer stores; what the new block now holds is shaded here, so a
        # buffer of references grown under a running mark keeps them.
        IyiMark.barrier(new_pointer.address, limit.unsafe_div(8_u64)) if LibIyiGCTable.__iyi_marking != 0_u8
        free(pointer)
        new_pointer
      end

      def self.clear_block(start : UInt64, count : UInt64) : Nil
        words = Pointer(UInt64).new(start)
        filled = 0_u64
        while filled &+ 8_u64 <= count
          words.value = 0_u64
          words = words + 1_i64
          filled = filled &+ 8_u64
        end
        bytes = Pointer(UInt8).new(start &+ filled)
        while filled < count
          bytes.value = 0_u8
          bytes = bytes + 1_i64
          filled = filled &+ 1_u64
        end
      end

      def self.containing(pointer : Void*) : UInt64
        address = pointer.address
        arena = arena_of(address)
        return 0_u64 if arena == 0
        return 0_u64 if address < arena + HEAD
        arena
      end

      def self.containing_large(pointer : Void*) : UInt64
        address = pointer.address
        node = @@large
        while node != 0
          if address >= node + LARGE_USER && address < node + read64(node + OFF_MAP)
            return node
          end
          node = read64(node)
        end
        0_u64
      end

      def self.first_arena : UInt64
        @@arenas
      end

      def self.arena_next(arena : UInt64) : UInt64
        read64(arena + OFF_NEXT)
      end

      def self.arena_map(arena : UInt64) : UInt64
        read64(arena + OFF_MAP)
      end

      def self.arena_chunk(arena : UInt64) : UInt64
        read64(arena + OFF_CHUNK)
      end

      # The fill cursor names where carving stopped, which is what tells a
      # chunk that was handed out from the untouched tail of an arena. Stage 3
      # asks it of every candidate pointer and Stage 6's sweep will ask it of
      # every arena, so it is an accessor beside the others rather than a
      # thing either stage reaches into the header for.
      def self.arena_cursor(arena : UInt64) : UInt64
        Pointer(Atomic(UInt64)).new(arena + OFF_CURSOR).value.get
      end

      # The carve frontier, the sweep's stop.
      def self.arena_high(arena : UInt64) : UInt64
        read64(arena + OFF_HIGH)
      end

      def self.arena_epoch(arena : UInt64) : UInt64
        read64(arena + OFF_EPOCH)
      end

      def self.arena_epoch_set(arena : UInt64, epoch : UInt64) : Nil
        write64(arena + OFF_EPOCH, epoch)
      end

      def self.first_large : UInt64
        @@large
      end

      def self.large_next(node : UInt64) : UInt64
        read64(node)
      end

      def self.large_mapped(node : UInt64) : UInt64
        read64(node + 8)
      end
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc_atomic(size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is defined locally for the bump branch's reason: codegen itself
    # reaches for the name (`pre_initialize_aggregate` and
    # `generic_array_malloc` lower to the LLVM `llvm.memset` intrinsic, which
    # becomes a C `memset` call once the size is not a constant), and a
    # definition with the same name, types and return is the only thing that
    # can intercept that. The bulk goes eight bytes at a time, and the word
    # store advances one word per store, because pointer arithmetic here
    # counts elements: eight bytes is one step, not eight. The byte loop
    # carries the tail, and the pattern word is the byte tiled eight wide.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!

      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end

    {% if flag?(:darwin) %}
      # `bzero` is defined for the same reason on darwin: the aarch64 back end
      # lowers a zeroing `llvm.memset` it will not inline — every
      # `Pointer.malloc` clears with one, and a --release build keeps the
      # allocator's variable-length ones — to a `bzero` call rather than a
      # `memset` call, so without this every darwin release binary asked
      # libSystem for one more name (bench/thread_floor.sh was the gate that
      # first read it; bench/dependency_floor.sh builds plain and never saw
      # it). The stores are inline asm, not a loop the compiler can read:
      # the loop-idiom pass turns a zeroing store loop into the very
      # `llvm.memset` this exists to catch, and it spares only functions
      # named `memset` and `memcpy` — the first version of this, written as
      # `memset`'s loop, came back as a tail call to itself on its own byte
      # tail. A call to `memset` would fold the same way. A word per store,
      # the shape `memset` above has, and the byte tail is at most seven.
      fun bzero(destination : Void*, count : UInt64) : Nil
        address = destination.address
        filled = 0_u64
        while filled + 8_u64 <= count
          {% if flag?(:aarch64) %}
            asm("str xzr, [$0]" :: "r"(address + filled) : "memory" : "volatile")
          {% else %}
            asm("movq $$0, ($0)" :: "r"(address + filled) : "memory" : "volatile")
          {% end %}
          filled = filled + 8_u64
        end
        while filled < count
          {% if flag?(:aarch64) %}
            asm("strb wzr, [$0]" :: "r"(address + filled) : "memory" : "volatile")
          {% else %}
            asm("movb $$0, ($0)" :: "r"(address + filled) : "memory" : "volatile")
          {% end %}
          filled = filled + 1_u64
        end
      end
    {% end %}

    # GC_DESIGN.md's Stage 3: the root set, made enumerable. Nothing marks and
    # nothing collects here. What lands is the answer to "where could a
    # pointer to a live object be", asked of the one thread this language has,
    # and the answer to "is this word one", asked of the heap Stage 2 built.
    # Stage 5 passes a marking function to `IyiRoots.each_root` and that is
    # the whole interface it needs; `bench/root_exercise.iyi` is the only
    # caller until then, and it is what says the mechanism works.
    #
    # Conservative, and deliberately biased toward retaining. A word that is
    # not a pointer but lands inside an allocated chunk keeps that chunk alive
    # for one cycle, which costs memory. A word that IS a pointer and is not
    # reported frees a live object, which costs correctness. Every decision
    # below is made in that direction: when in doubt, retain.
    #
    # Three places a root can be, and the second is the one that gets missed:
    #
    # 1. The stack, word by word between the current stack pointer and the
    #    base. Both targets grow the stack downward, so the stack pointer is
    #    the low end and the base is the high one, and the scan runs upward
    #    from the first 8-aligned address. Only aligned words are candidates:
    #    a pointer the compiler stored is 8-aligned on both targets, so an
    #    unaligned word is a coincidence of neighbouring bytes and not a
    #    reference anything can follow.
    #
    # 2. The registers. A root can sit in a callee-saved register and appear
    #    nowhere on the stack, so a collector that scans only the stack frees
    #    a live object. This is the part of GC_DESIGN.md's Stage 4 that is
    #    real without threads: there is no thread to suspend and no register
    #    state to read out of one, but the register file of the thread that
    #    is running still holds references. They are spilled to memory before
    #    the scan and that memory is a root range of its own.
    #
    # 3. The globals, whose ranges come from the platform rather than from a
    #    guess. A range that cannot be obtained is fatal rather than empty,
    #    because a missing root range is a collector that frees live objects
    #    and an empty range looks exactly like a clean scan.
    #
    # 4. Every suspended fiber's stack (Stage 3's fourth task, closed).
    #    The scheduler keeps an all-fibers registry precisely because its
    #    wait queues cannot serve this walk — a channel-parked fiber lives
    #    in the channel's own nodes — and `each_fiber_root` scans each
    #    suspended fiber from its saved stack pointer to its stack top.
    #    This was a recorded gap between 0.4.0's scheduler landing and
    #    this walk: an object reachable only from a parked fiber's stack
    #    would have been freed live — latent then because only the
    #    exercises collected, and closed before the allocation-pressure
    #    trigger made any allocation a collection point.
    #
    # What is NOT here, for the same reason: nothing suspends a thread. Stage
    # 4's `SIGSTOP` on Linux and Mach `thread_suspend` on darwin stop threads
    # this runtime cannot create, and code that stops nothing cannot be
    # tested for stopping the right things.
    {% if flag?(:darwin) %}
      # The stack base and the global segments, from libSystem, which has the
      # same standing here that `write` and `mmap` do: Apple documents it as
      # the platform's interface and raw syscalls as not a stable ABI.
      # `pthread_get_stackaddr_np` is the sanctioned answer for the highest
      # address of a thread's stack, and dyld's image list is the sanctioned
      # answer for where a Mach-O image's segments landed after sliding.
      lib LibC
        fun pthread_self : Void*
        fun pthread_get_stackaddr_np(thread : Void*) : Void*
        fun _dyld_get_image_header(index : Int32) : Void*
        fun _dyld_get_image_vmaddr_slide(index : Int32) : Int64
      end
    {% else %}
      # The static data span on Linux, from symbols the link already
      # defines. On glibc, `__data_start` at the front of `.data` comes from
      # the C runtime object every link template adds, and `_end` past the
      # back of `.bss` from the linker itself — GC_DESIGN.md's
      # "`__data_start` to `__bss_end`" written the way the linker spells
      # it. musl's crt defines no `__data_start` (CI's Alpine arm failed at
      # the link, which is this comment's provenance), so there the range is
      # `__bss_start`.._end`, both linker-synthesized on every ELF: narrower
      # by `.data`, and honest about it — this prelude's globals fold their
      # literal initializers to static zero, so a global that ever holds a
      # heap pointer lives in `.bss`, which is exactly the half kept.
      # Declaring them costs no library; a binary whose link provides
      # neither fails at the link rather than scanning nothing at run time.
      {% if flag?(:musl) %}
        lib LibIyiImage
          $__bss_start : UInt8
          $_end : UInt8
        end
      {% else %}
        lib LibIyiImage
          $__data_start : UInt8
          $_end : UInt8
        end
      {% end %}
    {% end %}

    class IyiRoots
      # Six callee-saved registers on x86_64 and twelve on aarch64, named
      # where they are spilled.
      {% if flag?(:x86_64) %}
        SPILL = 48_u64
      {% else %}
        SPILL = 96_u64
      {% end %}
      PAGE = 4096_u64
      MAPS = 65536_u64

      # The same rule the allocator's state lives under: `$` globals are
      # refused, a `fun` body cannot reach `@@` state, and a literal
      # initializer folds into the LLVM global's static zero, so zero means
      # "not discovered yet" rather than a value startup code installs. There
      # is no array class variable either, which is why the register spill
      # buffer is a mapped page named by one of these rather than a field.
      @@spill : UInt64 = 0_u64
      @@stack_base : UInt64 = 0_u64
      @@data_low : UInt64 = 0_u64
      @@data_high : UInt64 = 0_u64
      @@const_low : UInt64 = 0_u64
      @@const_high : UInt64 = 0_u64
      @@found_globals : UInt64 = 0_u64

      # A root range that cannot be obtained ends the program. The whole
      # point of the range is that missing it frees live objects, so a
      # diagnosis now is cheaper than a corrupted heap later.
      def self.fatal(message : String) : NoReturn
        __iyi_write(1, message.to_unsafe.as(Void*), message.bytesize.to_u64)
        __iyi_exit(1)
      end

      # One page of its own for the register spill, mapped on first use the
      # way the allocator's directory is. It is deliberately not heap memory:
      # a spill buffer taken from `IyiHeap` would be a chunk the scan then
      # reports as a live object, and a chunk holding a raw pointer to
      # everything every register held.
      def self.spill : UInt64
        @@spill = __iyi_mmap(PAGE).address if @@spill == 0
        @@spill
      end

      # The callee-saved registers, stored where the scan can see them.
      # x86_64 System V preserves rbx, rbp and r12 through r15 across a call;
      # aarch64 AAPCS64 preserves x19 through x28, x29 the frame pointer and
      # x30 the link register. The caller-saved registers are not captured
      # and do not need to be: their convention is that a caller keeps
      # nothing live in them across a call, so any value still wanted was
      # written to the frame that the stack scan already covers. The
      # floating-point callee-saved registers (d8 to d15, xmm on Windows) are
      # not captured either, because nothing in this language puts an object
      # pointer in one.
      #
      # The destination is pinned to a caller-saved register, rdi or x0, so
      # that the register holding it can never be one of the registers being
      # captured. Slots left over from an earlier spill stay as they were,
      # which retains a little more than it must and never less.
      def self.spill_registers : Nil
        buffer = spill
        {% if flag?(:x86_64) %}
          asm("movq %rbx, 0($0)
               movq %rbp, 8($0)
               movq %r12, 16($0)
               movq %r13, 24($0)
               movq %r14, 32($0)
               movq %r15, 40($0)" :: "{rdi}"(buffer) : "memory" : "volatile")
        {% else %}
          asm("stp x19, x20, [$0, #0]
               stp x21, x22, [$0, #16]
               stp x23, x24, [$0, #32]
               stp x25, x26, [$0, #48]
               stp x27, x28, [$0, #64]
               stp x29, x30, [$0, #80]" :: "{x0}"(buffer) : "memory" : "volatile")
        {% end %}
      end

      # The low end of the stack, read out of the register that names it.
      # Taken here rather than from the address of a local because a local's
      # address is above whatever the current frame has already pushed, and
      # the difference is exactly the words a compiler spills a pointer into.
      def self.stack_pointer : UInt64
        value = uninitialized UInt64
        {% if flag?(:x86_64) %}
          asm("movq %rsp, $0" : "=r"(value) :: : "volatile")
        {% else %}
          asm("mov $0, sp" : "=r"(value) :: : "volatile")
        {% end %}
        value
      end

      # The high end, discovered once. The main thread's stack grows down
      # from a fixed top on both targets, so the number does not change over
      # a run and reading it lazily is the same answer as recording it at
      # startup, without the startup cost for a program that never collects.
      def self.stack_base : UInt64
        @@stack_base = discover_stack_base if @@stack_base == 0
        @@stack_base
      end

      {% if flag?(:darwin) %}
        # What this number is: the address one past the highest byte of the
        # main thread's stack, which is what `pthread_get_stackaddr_np`
        # returns and is the true base rather than an approximation of it.
        def self.discover_stack_base : UInt64
          base = LibC.pthread_get_stackaddr_np(LibC.pthread_self).address
          fatal("iyi: stack base unavailable\n") if base == 0
          base
        end
      {% else %}
        # What this number is: the end address of the kernel's `[stack]`
        # mapping for this process, read out of `/proc/self/maps`, which is
        # the true base and not an approximation. The address of a local in
        # `main` was the alternative and it is not the same number: it sits
        # below argv, envp and the auxiliary vector, which the kernel places
        # at the top of that mapping, so a base taken there is too low and a
        # base that is too low silently loses roots.
        #
        # Reading a file is three syscalls this file already issues. The
        # buffer is a mapping of its own rather than a heap chunk, because
        # the heap is the thing being described and a scratch chunk in it
        # would be one more object every later scan has to reason about.
        def self.discover_stack_base : UInt64
          buffer = __iyi_mmap(MAPS).address
          handle = __iyi_open_read("/proc/self/maps".to_unsafe)
          fatal("iyi: /proc/self/maps unreadable\n") if handle < 0
          filled = 0_u64
          while filled < MAPS
            count = __iyi_read(handle.to_i32, Pointer(Void).new(buffer + filled), MAPS - filled)
            break if count <= 0
            filled = filled + count.to_u64
          end
          __iyi_close(handle)
          base = stack_end_in_maps(buffer, filled)
          __iyi_munmap(buffer, MAPS)
          # The `[stack]` line is near the end of the file, so a read that
          # filled the buffer and stopped short reports no line rather than a
          # wrong one, and this is where that becomes a diagnosis.
          fatal("iyi: no [stack] line in /proc/self/maps\n") if base == 0
          base
        end
      {% end %}

      # `/proc/self/maps` is a line per mapping, "low-high perms ..." in hex,
      # with the region's name last. The line whose name is `[stack]` is the
      # main thread's, and the number after the dash is its end. Kept off the
      # platform branch and reachable on both, because parsing text is the
      # half of this that a test can exercise anywhere and the syscalls are
      # the half that cannot leave Linux.
      def self.stack_end_in_maps(buffer : UInt64, length : UInt64) : UInt64
        bytes = Pointer(UInt8).new(buffer)
        start = 0_u64
        index = 0_u64
        while index <= length
          if index == length || (bytes + index.to_i64).value == 10_u8
            return line_stack_end(bytes, start, index) if line_names_stack?(bytes, start, index)
            start = index + 1
          end
          index = index + 1
        end
        0_u64
      end

      def self.line_names_stack?(bytes : Pointer(UInt8), start : UInt64, stop : UInt64) : Bool
        return false if stop < start + 7
        name = "[stack]".to_unsafe
        cursor = stop - 7
        index = 0
        while index < 7
          return false if (bytes + (cursor + index.to_u64).to_i64).value != name[index]
          index = index + 1
        end
        true
      end

      def self.line_stack_end(bytes : Pointer(UInt8), start : UInt64, stop : UInt64) : UInt64
        cursor = start
        # 45 is '-', which separates the two addresses.
        while cursor < stop && (bytes + cursor.to_i64).value != 45_u8
          cursor = cursor + 1
        end
        return 0_u64 if cursor >= stop
        cursor = cursor + 1
        value = 0_u64
        digits = 0
        while cursor < stop
          digit = hex_digit((bytes + cursor.to_i64).value)
          break if digit > 15
          value = value * 16_u64 + digit
          digits = digits + 1
          cursor = cursor + 1
        end
        return 0_u64 if digits == 0
        value
      end

      # 16 for anything that is not a hex digit, which is the terminator the
      # caller reads rather than a second return value it has nowhere to put.
      def self.hex_digit(byte : UInt8) : UInt64
        return (byte - 48_u8).to_u64 if byte >= 48_u8 && byte <= 57_u8
        return (byte - 97_u8).to_u64 + 10_u64 if byte >= 97_u8 && byte <= 102_u8
        return (byte - 65_u8).to_u64 + 10_u64 if byte >= 65_u8 && byte <= 70_u8
        16_u64
      end

      {% if flag?(:darwin) %}
        # The main executable's `__DATA` and `__DATA_CONST`, walked out of its
        # Mach header. Image 0 is the main executable, and it is the only
        # image asked: nothing outside this program allocates from this heap,
        # so no other image's data segment can hold a pointer into it. The
        # segment addresses in the file are unslid, so the slide is added.
        # `__DATA_CONST` is optional because a binary may genuinely have none;
        # `__DATA` is not, because every binary has one and its absence means
        # the walk is wrong rather than the binary unusual.
        def self.discover_globals : Nil
          header = LibC._dyld_get_image_header(0).address
          fatal("iyi: no Mach header for the main image\n") if header == 0
          fatal("iyi: main image is not 64-bit Mach-O\n") if IyiHeap.read64(header) & 0xFFFFFFFF_u64 != 0xFEEDFACF_u64
          slide = LibC._dyld_get_image_vmaddr_slide(0).to_u64
          count = IyiHeap.read64(header + 16) & 0xFFFFFFFF_u64
          cursor = header + 32_u64
          seen = 0_u64
          while seen < count
            word = IyiHeap.read64(cursor)
            size = word.unsafe_shr(32)
            fatal("iyi: zero-length Mach load command\n") if size == 0
            # LC_SEGMENT_64. The name is sixteen bytes at offset 8, compared
            # as two words rather than a loop: "__DATA" padded with zeros,
            # and "__DATA_CONST" the same.
            if word & 0xFFFFFFFF_u64 == 0x19_u64
              first = IyiHeap.read64(cursor + 8)
              second = IyiHeap.read64(cursor + 16)
              if first == 0x415441445F5F_u64 && second == 0_u64
                @@data_low = IyiHeap.read64(cursor + 24) &+ slide
                @@data_high = @@data_low &+ IyiHeap.read64(cursor + 32)
              elsif first == 0x435F415441445F5F_u64 && second == 0x54534E4F_u64
                @@const_low = IyiHeap.read64(cursor + 24) &+ slide
                @@const_high = @@const_low &+ IyiHeap.read64(cursor + 32)
              end
            end
            cursor = cursor + size
            seen = seen + 1_u64
          end
          fatal("iyi: no __DATA segment in the main image\n") if @@data_high <= @@data_low
          @@found_globals = 1_u64
        end
      {% else %}
        # `.data` and `.bss`, which are contiguous in every ELF layout the
        # link templates produce, so the two symbols bound one range rather
        # than two. There is no second range on this target, which is why
        # `@@const_low` and `@@const_high` stay zero here and the scan skips
        # an empty range rather than needing a flag to tell it to.
        def self.discover_globals : Nil
          {% if flag?(:musl) %}
            low = pointerof(LibIyiImage.__bss_start).address
          {% else %}
            low = pointerof(LibIyiImage.__data_start).address
          {% end %}
          high = pointerof(LibIyiImage._end).address
          fatal("iyi: the static data span is not a range\n") if high <= low
          @@data_low = low
          @@data_high = high
          @@found_globals = 1_u64
        end
      {% end %}

      def self.globals : Nil
        discover_globals if @@found_globals == 0
      end

      def self.data_low : UInt64
        globals
        @@data_low
      end

      def self.data_high : UInt64
        globals
        @@data_high
      end

      def self.const_low : UInt64
        globals
        @@const_low
      end

      def self.const_high : UInt64
        globals
        @@const_high
      end

      # Is this word a pointer to a live object, and if so where does that
      # object start? One answer for both questions, because a root usually
      # points into the middle of an object and the marker needs the base.
      # Zero means "not a heap pointer", which is also the answer for a null
      # word, for a word in no arena, for a word in the part of an arena that
      # was never carved, and for a word in a chunk that has been freed.
      #
      # Stage 2 answers the first half already: `containing` names the arena
      # a pointer is in, and the arena's header names its chunk size, so the
      # chunk a word falls in is arithmetic rather than a search. The rest is
      # the part Stage 2 had no reason to answer. A chunk at or past the fill
      # cursor was never handed out, which is also how the tail of an arena
      # too short for one more chunk is rejected. A chunk on its class's free
      # list was handed out and given back, and reporting it live would keep
      # a dead object alive forever, since nothing would ever free it twice.
      #
      # The freed check is one load — the FREE flag in the chunk's own mark
      # word. It began as a walk of the class's free list, which the comment
      # here called fine "before a profile asks": the trigger's steady state
      # asked, a long free list made every sweep quadratic, and the flag is
      # the per-chunk bit the same comment predicted.
      def self.base_of(word : UInt64) : UInt64
        return 0_u64 if word == 0
        candidate = Pointer(Void).new(word)
        arena = IyiHeap.containing(candidate)
        if arena != 0
          first = arena + IyiHeap::HEAD
          chunk = IyiHeap.arena_chunk(arena)
          head = first + (word - first).unsafe_div(chunk) * chunk
          return 0_u64 if IyiHeap.uncarved?(arena, head)
          return 0_u64 if free_listed?(head, chunk)
          return head + IyiHeap::HEADER
        end
        node = IyiHeap.containing_large(candidate)
        return node + IyiHeap::LARGE_USER if node != 0
        0_u64
      end

      # One load: `IyiHeap.free` set the flag when the chunk went on its
      # list and `take` zeroes the mark word when it comes back off. The
      # list walk this used to be was linear in the chunks freed for the
      # class, which made the sweep over them quadratic once the trigger
      # gave every steady-state heap a long free list. The `chunk`
      # parameter stays: a caller that knows the stride names it, and the
      # signature is the check's identity in the gates that break it.
      def self.free_listed?(head : UInt64, chunk : UInt64) : Bool
        IyiHeap.read64(head + IyiHeap::OFF_MARK) & IyiHeap::FREE_FLAG != 0
      end

      # Every 8-aligned word in [low, high), with the ones that validate
      # handed to the callback as the base of the object they reach. The same
      # base can be reported more than once, because more than one root can
      # reach one object; marking is idempotent, so deduplicating is the
      # caller's business and not worth a set here.
      def self.scan_range(low : UInt64, high : UInt64, visit : Proc(UInt64, Nil)) : Nil
        return if high <= low
        cursor = low
        remainder = cursor.unsafe_mod(8_u64)
        cursor = cursor + (8_u64 - remainder) if remainder != 0
        while cursor + 8_u64 <= high
          base = base_of(IyiHeap.read64(cursor))
          visit.call(base) if base != 0
          cursor = cursor + 8_u64
        end
      end

      # The running stack. Its high end is the thread's own top — the main
      # thread's base, or a started thread's own mapping — unless a spawned
      # fiber is executing, in which case it is that fiber's mmap'd top:
      # scanning up to the thread base from a fiber stack would walk the
      # unmapped gap between the two mappings and fault.
      def self.each_stack_root(visit : Proc(UInt64, Nil)) : Nil
        top = 0_u64
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          top = IyiScheduler.current_stack_top
          top = IyiThread.current_stack_top if top == 0
        {% end %}
        top = stack_base if top == 0
        scan_range(stack_pointer, top, visit)
      end

      # Every other thread's registers and stack, each stopped where it
      # was by the collection that asks (thread.iyi); on one thread, an
      # empty walk.
      def self.each_thread_root(visit : Proc(UInt64, Nil)) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          IyiThread.each_stopped_root(visit)
        {% end %}
      end

      # Every suspended fiber's stack, from its saved stack pointer to its
      # top (GC_DESIGN.md Stage 3's fourth task, closed). The registry is
      # the scheduler's all-fibers list, because the wait queues cannot
      # serve this walk: a channel-parked fiber lives in the channel's own
      # nodes. Skipped by state: the running fiber is `each_stack_root`'s
      # business, a done fiber's stack holds nothing live, and a fiber that
      # never suspended has no saved pointer to scan from. The main fiber's
      # top is 0 in the registry, standing for the thread base this module
      # discovered. On the targets with no scheduler there is nothing to
      # walk and this is the empty walk it looks like.
      def self.each_fiber_root(visit : Proc(UInt64, Nil)) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          fiber = IyiScheduler.first_fiber
          while fiber.is_a?(IyiFiber)
            if fiber.state != 0 && fiber.state != 6 && fiber.saved_sp != 0
              top = fiber.stack_top
              top = stack_base if top == 0
              scan_range(fiber.saved_sp, top, visit)
            end
            fiber = fiber.next_fiber
          end
        {% end %}
      end

      # The spill buffer as a root range. Writing the registers somewhere the
      # scan does not reach would be the same as not capturing them.
      def self.each_register_root(visit : Proc(UInt64, Nil)) : Nil
        buffer = spill
        scan_range(buffer, buffer + SPILL, visit)
      end

      def self.each_global_root(visit : Proc(UInt64, Nil)) : Nil
        scan_range(data_low, data_high, visit)
        scan_range(const_low, const_high, visit)
      end

      # The whole root set: the running stack, the spilled registers, the
      # globals, and every suspended fiber's stack — the gap the block
      # above used to record, closed by the scheduler's registry. The
      # spill happens first and before anything calls back into user code,
      # because the callback is user code and user code uses registers.
      def self.each_root(visit : Proc(UInt64, Nil)) : Nil
        spill_registers
        each_register_root(visit)
        each_stack_root(visit)
        each_thread_root(visit)
        each_fiber_root(visit)
        each_global_root(visit)
      end

      # The root set as a helper sees it at the mark's second stop: every
      # stopped thread's registers and stack, the fibers, the globals — and
      # not the helper's own stack, which holds no object of the program's
      # and sits in a mapping no thread base bounds.
      def self.each_root_of_others(visit : Proc(UInt64, Nil)) : Nil
        each_thread_root(visit)
        each_fiber_root(visit)
        each_global_root(visit)
      end
    end

    # iyi: GC_DESIGN.md Stage 5, the mark phase. Roots go gray, the queue
    # drains, and what is still white when it stops is unreachable. Nothing
    # sweeps yet: this stage decides what is garbage, Stage 6 reclaims it.
    #
    # Colour lives in bits 0 and 1 of the mark word at `base - 8`, matching
    # `Iyi::Collector::ObjectHeader` in the compiler: 0 white, 1 gray, 2 black,
    # and a fresh chunk is zero, so a newly allocated object is white without
    # anyone writing anything. The bits above are left alone on every write,
    # because they are the flag and reserved bits the header promises to a
    # forwarding pointer later.
    #
    # **Precise where the header says a type, conservative everywhere else.**
    # Codegen stores an object's `type_id` at `P-16` at the allocation site
    # (`allocate_aggregate`), and this loop looks the id up in the layout
    # table the same compiler embedded (`__iyi_gc_layouts`,
    # `codegen/gc_layouts.cr`): a hit scans exactly the pointer offsets the
    # `TypeLayout` names, so an integer that happens to hold an address no
    # longer retains a dead object through a typed field. An id of zero — a
    # `Pointer(T).malloc` buffer, a closure environment, anything not
    # allocated as an instance of a type — word-scans between the user
    # pointer and the size the header carries, which is what Boehm does in
    # production and is safe in the direction that matters: a false positive
    # retains a dead object, only a false negative frees a live one. A
    # missing table entry falls back the same way, never a crash.
    #
    # Plain loads and stores rather than compare-and-swap: one mutator
    # thread, and the scheduler's fibers yield only at suspension points,
    # never inside the marker. `ObjectHeader`'s CAS helpers exist and are
    # tested for when Stage 7 has threads to contend, and with a single
    # mutator a CAS and a load-store pair decide the same thing.

    # The compiler's embedded layout table. The symbol is a pointer-sized
    # global whose value is the table's address (`gc_layouts.cr` gives it
    # its one real definition, an empty table included, so referencing it
    # can never cost a link). Declared the way `__data_start` is: an
    # external the link already owes, no library.
    lib LibIyiGCTable
      $__iyi_gc_layouts : Void*
      # Non-zero while a mark runs beside the program: what every
      # pointer-bearing store the compiler emits checks before it calls
      # the barrier. Codegen defines the byte; only the marker writes it.
      $__iyi_marking : UInt8
    end

    # The barrier's two entry points, called by name from the code the
    # compiler emits around a store (SPEC.md II.5, GC_DESIGN.md Stage 9).
    fun __iyi_write_barrier_begin : Nil
      IyiHeap.enter_barrier
    end

    fun __iyi_write_barrier(address : Void*, words : UInt64) : Nil
      IyiMark.barrier(address.address, words)
      IyiHeap.leave_barrier
    end

    class IyiMark
      WHITE = 0_u64
      GRAY  = 1_u64
      BLACK = 2_u64
      COLOUR = 3_u64

      # ── The parallel marker's memory ───────────────────────────────────
      #
      # Nothing here is the heap being marked: a mark phase that allocated
      # from that heap could carve a chunk, or hand back one it is about to
      # decide the liveness of, which is a collector reasoning about memory
      # it is mutating. Every worker — the collecting thread and the helpers
      # `IyiThread.start_helper` gave the collector — has a stack of its
      # own, a mapping named by a `@[ThreadLocal]`; gray objects go there
      # first, and only a full stack spills. What is shared is a pool of
      # batches (GC_DESIGN.md Stage 7's work distribution): a worker whose
      # stack passes SPILL_AT moves a batch of BATCH entries to the pool
      # under the pool's own lock, a worker whose stack runs dry takes a
      # batch from it, and the mark is over when the pool is empty and no
      # worker holds work. Batches come from a bump region the collection
      # resets, so the pool never touches the heap and never leaks.
      SPILL_AT = 512_u64
      BATCH = 128_u64
      BATCH_WORDS = 130_u64
      STACK_WORDS = 4194304_u64
      POOL_REGION = 67108864_u64

      # A worker's state is one page, and one `@[ThreadLocal]` names the
      # thread's page: read once when a drain begins and passed down as
      # `w`, because every thread-local read is a `noinline` call (the
      # compiler's rule, so a fiber that changes threads never reads a
      # cached address), and fifteen of them per object doubled the mark.
      #   +0   the stack's mapping     +8   its length in entries
      #   +16  bytes this worker blackened
      #   +24  the arena its pending live count is for   +32  the count
      #   +40  the type id whose layout entry is cached   +48  the entry
      @[ThreadLocal]
      @@worker : UInt64 = 0_u64
      @@collector_worker : UInt64 = 0_u64
      W_STACK = 0_u64
      W_LEN = 8_u64
      W_BYTES = 16_u64
      W_LIVE_ARENA = 24_u64
      W_LIVE_PENDING = 32_u64
      W_LAST_TYPE = 40_u64
      W_LAST_ENTRY = 48_u64
      W_BLACK = 56_u64
      W_SINCE = 64_u64

      # The pool: a lock word, the batch list's head, the bump region and its
      # cursor, the count of workers holding work, and the generation the
      # helpers wake on — each on a line of its own in one mapping.
      @@pool : UInt64 = 0_u64
      POOL_LOCK = 0_u64
      POOL_HEAD = 64_u64
      POOL_REGION_BASE = 128_u64
      POOL_CURSOR = 192_u64
      POOL_ACTIVE = 256_u64
      POOL_GENERATION = 320_u64
      POOL_HELPERS_DONE = 384_u64
      POOL_ASKED = 448_u64
      POOL_READY = 512_u64
      # The sweep round (GC_DESIGN.md Stage 8): open after a collection
      # while helpers may claim arenas, closed by the next collection
      # before it stops anything; and how many helper walks are in flight.
      POOL_SWEEP = 576_u64
      POOL_SWEEPERS = 640_u64
      POOL_SWEEP_PERMITS = 704_u64
      # The class an allocating thread is waiting on, plus one; 0 is none.
      # A helper's claim takes an arena of that class first.
      POOL_SWEEP_WANTED = 768_u64
      # A mark's permits: as many as it asks helpers, taken one each by
      # whichever helpers wake first, and the first taker is the one that
      # finishes a concurrent mark. Every helper is woken and one that
      # finds no permit parks again, so a mark over a small heap asks one
      # helper and fifteen do not contend for its pool - churn's 122
      # marks are 40 ms of wall time with permits and 52 without.
      #
      # The count they are waited for is the count *taken*, `ASKED -
      # PERMITS`, never `ASKED`: a helper can miss a generation
      # altogether - it spends its wake on the sweep round, and by the
      # time it looks again the mark's generation is the one it has
      # already seen - and a wait for a headcount that never arrives is
      # a hang, which is what three cores found one run in three.
      POOL_MARK_PERMITS = 832_u64
      POOL_FINISH = 896_u64
      NO_PERMIT = 0xFFFFFFFFFFFFFFFF_u64

      # A mark's permit, or NO_PERMIT: the slot is the order of taking,
      # 0 for the first.
      def self.take_mark_permit : UInt64
        word = pool_word(POOL_MARK_PERMITS)
        while true
          left = word.value.get
          return NO_PERMIT if left == 0_u64
          return IyiHeap.read64(pool + POOL_ASKED) - left if word.value.compare_and_set(left, left - 1_u64)[1]
        end
      end

      # How many helpers took a permit for the mark in flight.
      def self.mark_takers : UInt64
        IyiHeap.read64(pool + POOL_ASKED) - pool_word(POOL_MARK_PERMITS).value.get
      end


      # Helpers: how many the collector may use besides itself, how many
      # exist, and the threshold under which a mark runs alone — waking
      # fifteen threads to mark a hundred kilobytes costs more than the
      # marking, and the last mark's live bytes are the estimate.
      @@workers : UInt64 = 0_u64
      @@helpers : UInt64 = 0_u64
      @@helpers_wanted : UInt64 = 0_u64
      @@helpers_decided : Bool = false
      @@workers_set : Bool = false
      @@last_marked : UInt64 = 0_u64
      PARALLEL_FROM = 1048576_u64

      # What the last sweep reclaimed and kept, and how many collections have
      # run. Literal initializers, so codegen folds them to a static zero the
      # way every other piece of state in this file does.
      @@swept : UInt64 = 0_u64
      @@kept : UInt64 = 0_u64
      @@bytes_freed : UInt64 = 0_u64
      @@bytes_kept : UInt64 = 0_u64
      # What the sweep walked: every carved byte of every arena, live or
      # not, which is what a sweep costs and what the budget is floored by.
      @@bytes_walked : UInt64 = 0_u64
      @@collections : UInt64 = 0_u64
      @@arenas_released : UInt64 = 0_u64
      @@pause_last : UInt64 = 0_u64
      @@pause_max : UInt64 = 0_u64
      @@pause_total : UInt64 = 0_u64

      # The pause clock. Linux asks the kernel directly — clock_gettime,
      # CLOCK_MONOTONIC — writing the timespec into the caller's frame,
      # because a collector must not allocate from the heap it is
      # collecting, not even sixteen bytes for a stamp, and a page shared
      # between callers is a stamp two threads tear: the runtime's own
      # calls are all under its lock, but a probe that read the clock from
      # an allocation while helper 0 read it under the lock saw time go
      # backwards. darwin asks libSystem's clock_gettime_nsec_np for
      # CLOCK_MONOTONIC_RAW, the scheduler's own clock and for its reason:
      # a pause is microseconds, and 6 would report it in whole ones.
      {% if flag?(:linux) %}
        lib LibIyiClock
          struct Timespec
            sec : Int64
            nsec : Int64
          end
        end
      {% end %}

      def self.now_ns : UInt64
        {% if flag?(:linux) %}
          stamp = uninitialized LibIyiClock::Timespec
          result = uninitialized Int64
          {% if flag?(:x86_64) %}
            asm("syscall" : "={rax}"(result)
                          : "{rax}"(228_i64), "{rdi}"(1_i64), "{rsi}"(pointerof(stamp))
                          : "rcx", "r11", "memory"
                          : "volatile")
          {% else %}
            asm("svc #0" : "={x0}"(result)
                         : "{x8}"(113_i64), "{x0}"(1_i64), "{x1}"(pointerof(stamp))
                         : "memory"
                         : "volatile")
          {% end %}
          stamp.sec.to_u64 * 1000000000_u64 + stamp.nsec.to_u64
        {% else %}
          LibC.clock_gettime_nsec_np(4)
        {% end %}
      end

      def self.colour(base : UInt64) : UInt64
        IyiHeap.read64(base - 8_u64) & COLOUR
      end

      # Set the colour and leave every other bit of the word as it was, because
      # those are the flag and reserved bits the header promises to a forwarding
      # pointer later.
      #
      # `word - (word & COLOUR)` is how the low two bits get cleared, and the
      # shape is dictated by what this prelude actually defines on `UInt64`.
      # Neither `~` nor `>>` is there, and the literal 2^64-4 as a mask invited
      # a question about whether a literal that large round-trips exactly, which
      # is not a question worth carrying in the one line that decides an
      # object's colour. Subtracting the low bits from the word needs only `&`
      # and `-`, both of which this file already relies on everywhere.
      def self.recolour(base : UInt64, colour : UInt64) : Nil
        word = IyiHeap.read64(base - 8_u64)
        IyiHeap.write64(base - 8_u64, (word - (word & COLOUR)) | colour)
      end

      # The pool's page, made by the first collection before any helper
      # exists: `start_helpers` makes it, under the runtime lock, and a
      # helper's first `pool_word` finds it made. Two threads reaching
      # here at once would each map a page and count on different ones -
      # the first concurrent collection hung that way, its helpers ready
      # on a page the collector never read.
      def self.pool : UInt64
        @@pool = __iyi_mmap(4096_u64).address if @@pool == 0
        @@pool
      end

      def self.pool_word(offset : UInt64) : Pointer(Atomic(UInt64))
        Pointer(Atomic(UInt64)).new(pool + offset)
      end

      def self.pool_lock : Nil
        word = pool_word(POOL_LOCK)
        while !word.value.compare_and_set(0_u64, 1_u64)[1]
        end
      end

      def self.pool_unlock : Nil
        pool_word(POOL_LOCK).value.set(0_u64)
      end

      # A batch's words, from the bump region; the region is reset when a
      # mark begins, so a collection's batches are gone with it.
      def self.new_batch : UInt64
        base = IyiHeap.read64(pool + POOL_REGION_BASE)
        if base == 0
          base = __iyi_mmap(POOL_REGION).address
          IyiHeap.write64(pool + POOL_REGION_BASE, base)
          IyiHeap.write64(pool + POOL_CURSOR, base)
        end
        cursor = IyiHeap.read64(pool + POOL_CURSOR)
        IyiRoots.fatal("iyi: the marker's pool region is full\n") if cursor + BATCH_WORDS * 8_u64 > base + POOL_REGION
        IyiHeap.write64(pool + POOL_CURSOR, cursor + BATCH_WORDS * 8_u64)
        cursor
      end

      # This thread's worker page and stack, mapped on first use.
      # Every page ever made, linked for the final stop, which flushes what
      # every mutator's barrier left on its stack.
      W_NEXT = 72_u64
      # Bytes this thread allocated while a mark ran beside it: born gray,
      # so counted marked, but not survivors of anything - the budget is
      # set from the marked bytes less these.
      W_BORN = 80_u64
      @@worker_pages : UInt64 = 0_u64

      def self.worker : UInt64
        w = @@worker
        if w == 0
          w = __iyi_mmap(4096_u64).address
          stack = __iyi_mmap(STACK_WORDS * 8_u64).address
          {% if flag?(:linux) %}
            __iyi_madvise_nohuge(stack, STACK_WORDS * 8_u64)
          {% end %}
          IyiHeap.write64(w + W_STACK, stack)
          pool_lock
          IyiHeap.write64(w + W_NEXT, @@worker_pages)
          @@worker_pages = w
          pool_unlock
          @@worker = w
        end
        w
      end

      # ── The write barrier's half ────────────────────────────────────────
      #
      # A mutator that stored a pointer-bearing value while a mark runs
      # calls in with the destination's words; each heap pointer among them
      # is grayed and queued on this thread's own stack, which is handed to
      # the pool in batches so the helpers marking beside the program find
      # it. An object born during the mark comes the same way.
      MUTATOR_BATCH = 64_u64

      def self.barrier(address : UInt64, words : UInt64) : Nil
        w = worker
        index = 0_u64
        while index < words
          base = IyiRoots.base_of(IyiHeap.read64(address + index * 8_u64))
          mutator_shade(w, base) if base != 0
          index = index + 1_u64
        end
      end

      # The assist, GC_DESIGN.md Stage 9: a mutator that allocated a slice
      # under a running mark scans ASSIST_OBJECTS of the pool's before it
      # goes on, so that a program allocating faster than the helpers mark
      # cannot outrun them - thirty-two threads allocating through a mark
      # bore 13 MB beside a 4 MB budget, and every collection's end was
      # the next one's trigger. Go's mutator assist is the same bargain,
      # scan work bought per byte allocated. The mutator counts itself
      # active on the pool while it holds a batch, so the helpers' end of
      # mark waits for it, and what it has not scanned it publishes back.
      ASSIST_OBJECTS = 1024_u64

      def self.assist : Nil
        return if LibIyiGCTable.__iyi_marking == 0_u8
        w = worker
        active = pool_word(POOL_ACTIVE)
        active.value.add(1_u64)
        stack = IyiHeap.read64(w + W_STACK)
        scanned = 0_u64
        while scanned < ASSIST_OBJECTS
          # An assist runs inside the allocator, where a stop is deferred
          # until the thread leaves: a thousand objects were a hundred
          # microseconds a second stop waited for. A stop asked for ends
          # the assist where it stands; what is left stays on the stack.
          break if IyiHeap.stop_requested?
          len = IyiHeap.read64(w + W_LEN)
          if len == 0_u64
            break unless take_batch(w)
            len = IyiHeap.read64(w + W_LEN)
          end
          len = len - 1_u64
          IyiHeap.write64(w + W_LEN, len)
          scan(w, IyiHeap.read64(stack + len * 8_u64))
          scanned = scanned + 1_u64
        end
        flush_mutator(w)
        flush_live(w)
        active.value.sub(1_u64)
      end

      # An object born under the mark is born black - Go's allocate-black:
      # its fields are empty now and every store into them goes through
      # the barrier, so there is nothing for a worker to scan, and the
      # first cut, which grayed it onto the barrier stack, fed the pool a
      # batch per sixty-four allocations from every thread and the mark
      # could not find the pool empty to end. Counted live in its arena
      # here, as a scan would have: the scavenge reads that count.
      def self.born_during_mark(base : UInt64, size : UInt64) : Nil
        w = worker
        IyiHeap.write64(w + W_BORN, IyiHeap.read64(w + W_BORN) + size)
        word = IyiHeap.read64(base - 8_u64)
        IyiHeap.write64(base - 8_u64, (word - (word & COLOUR)) | BLACK)
        count_live(w, base)
      end

      def self.mutator_shade(w : UInt64, base : UInt64) : Nil
        word_pointer = Pointer(Atomic(UInt64)).new(base - 8_u64)
        word = word_pointer.value.get
        while word & COLOUR == WHITE
          if word_pointer.value.compare_and_set(word, word | GRAY)[1]
            mutator_push(w, base)
            return
          end
          word = word_pointer.value.get
        end
      end

      def self.mutator_push(w : UInt64, base : UInt64) : Nil
        len = IyiHeap.read64(w + W_LEN)
        IyiHeap.write64(IyiHeap.read64(w + W_STACK) + len * 8_u64, base)
        len = len + 1_u64
        IyiHeap.write64(w + W_LEN, len)
        flush_mutator(w) if len >= MUTATOR_BATCH
      end

      # A mutator's stack to the pool, whole.
      def self.flush_mutator(w : UInt64) : Nil
        len = IyiHeap.read64(w + W_LEN)
        return if len == 0_u64
        stack = IyiHeap.read64(w + W_STACK)
        given = 0_u64
        while given < len
          count = len - given
          count = BATCH if count > BATCH
          publish(stack + given * 8_u64, count)
          given = given + count
        end
        IyiHeap.write64(w + W_LEN, 0_u64)
      end

      # Onto this worker's stack — and, with helpers, work shared where it
      # helps: a stack past SPILL_AT spills its top; a stack of any depth
      # donates its *bottom* half when the pool is empty and a worker is
      # idle, because a depth-first mark of a tree keeps a stack as deep
      # as the tree and no deeper (the oldest entries are the widest
      # subtrees), and a marker that only spilled a full stack never
      # shared a tree at all — measured, fifteen helpers idle through
      # binary trees.
      def self.push(w : UInt64, base : UInt64) : Nil
        len = IyiHeap.read64(w + W_LEN)
        if @@workers > 1_u64
          if len >= SPILL_AT
            spill(w)
            len = IyiHeap.read64(w + W_LEN)
          else
            # A donation at most every DONATE_EVERY pushes: the first cut
            # of this gave half of an eight-entry stack on every push to
            # fifteen idle helpers, a million nodes in eight-entry batches
            # through one lock, and the mark took twice as long as alone.
            since = IyiHeap.read64(w + W_SINCE) + 1_u64
            if since >= DONATE_EVERY && len >= 2_u64 && IyiHeap.read64(pool + POOL_HEAD) == 0 && pool_word(POOL_ACTIVE).value.get < @@workers
              donate(w)
              len = IyiHeap.read64(w + W_LEN)
              since = 0_u64
            end
            IyiHeap.write64(w + W_SINCE, since)
          end
        end
        IyiRoots.fatal("iyi: a mark worker's stack overflowed\n") if len >= STACK_WORDS
        IyiHeap.write64(IyiHeap.read64(w + W_STACK) + len * 8_u64, base)
        IyiHeap.write64(w + W_LEN, len + 1_u64)
      end

      DONATE_EVERY = 256_u64

      # BATCH entries off the top of this stack into the pool.
      def self.spill(w : UInt64) : Nil
        stack = IyiHeap.read64(w + W_STACK)
        len = IyiHeap.read64(w + W_LEN) - BATCH
        publish(stack + len * 8_u64, BATCH)
        IyiHeap.write64(w + W_LEN, len)
      end

      # The bottom half of this stack into the pool, the rest shifted down.
      def self.donate(w : UInt64) : Nil
        stack = IyiHeap.read64(w + W_STACK)
        len = IyiHeap.read64(w + W_LEN)
        give = len.unsafe_div(2_u64)
        give = BATCH if give > BATCH
        publish(stack, give)
        rest = len - give
        index = 0_u64
        while index < rest
          IyiHeap.write64(stack + index * 8_u64, IyiHeap.read64(stack + (give + index) * 8_u64))
          index = index + 1_u64
        end
        IyiHeap.write64(w + W_LEN, rest)
      end

      # `count` entries from `from` as one batch on the pool. A batch's
      # first word links it, its second says how many it holds.
      def self.publish(from : UInt64, count : UInt64) : Nil
        pool_lock
        batch = new_batch
        IyiHeap.write64(batch + 8_u64, count)
        index = 0_u64
        while index < count
          IyiHeap.write64(batch + 16_u64 + index * 8_u64, IyiHeap.read64(from + index * 8_u64))
          index = index + 1_u64
        end
        IyiHeap.write64(batch, IyiHeap.read64(pool + POOL_HEAD))
        IyiHeap.write64(pool + POOL_HEAD, batch)
        pool_unlock
      end

      # A batch from the pool onto this stack; false when the pool is empty.
      def self.take_batch(w : UInt64) : Bool
        return false if IyiHeap.read64(pool + POOL_HEAD) == 0
        pool_lock
        batch = IyiHeap.read64(pool + POOL_HEAD)
        if batch == 0
          pool_unlock
          return false
        end
        IyiHeap.write64(pool + POOL_HEAD, IyiHeap.read64(batch))
        pool_unlock
        stack = IyiHeap.read64(w + W_STACK)
        len = IyiHeap.read64(w + W_LEN)
        count = IyiHeap.read64(batch + 8_u64)
        index = 0_u64
        while index < count
          IyiHeap.write64(stack + (len + index) * 8_u64, IyiHeap.read64(batch + 16_u64 + index * 8_u64))
          index = index + 1_u64
        end
        IyiHeap.write64(w + W_LEN, len + count)
        true
      end

      # Gray, if it was white, and onto this worker's stack. Alone, a plain
      # store; with helpers, one compare-and-swap on the colour bits so two
      # workers that reach an object from two parents agree on who queues
      # it. Everything above the colour rides along unchanged.
      def self.shade(w : UInt64, base : UInt64) : Nil
        return if base == 0
        word = IyiHeap.read64(base - 8_u64)
        return if word & COLOUR != WHITE
        if @@workers > 1_u64
          word_pointer = Pointer(Atomic(UInt64)).new(base - 8_u64)
          while !word_pointer.value.compare_and_set(word, word | GRAY)[1]
            word = word_pointer.value.get
            return if word & COLOUR != WHITE
          end
        else
          IyiHeap.write64(base - 8_u64, word | GRAY)
        end
        push(w, base)
      end

      # The root visitor's shade: onto the collecting thread's stack.
      def self.shade(base : UInt64) : Nil
        shade(@@collector_worker, base)
      end

      # The table's address, read from the symbol once. Zero after the read
      # means an image with no table, which no build emits (`gc_layouts.cr`
      # writes an empty one), so it is treated as "no entry for anything"
      # rather than trusted.
      @@layouts : UInt64 = 0_u64

      def self.layouts_table : UInt64
        @@layouts = IyiHeap.read64(pointerof(LibIyiGCTable.__iyi_gc_layouts).address) if @@layouts == 0
        @@layouts
      end

      # Five words per entry, sorted by type id (`gc_layouts.cr` names the
      # word layout beside its writer): +0 id, +8 alloc size, +16 scan cap,
      # +24 offset count, +32 index into the offset words after the entries.
      ENTRY = 40_u64

      # The entry's address for a type id, or zero: zero id, no table, and
      # an id the table does not carry all answer zero, and every zero means
      # the same thing to `scan` — word-scan conservatively.
      def self.layout_entry(w : UInt64, type_id : UInt64) : UInt64
        return 0_u64 if type_id == 0
        return IyiHeap.read64(w + W_LAST_ENTRY) if type_id == IyiHeap.read64(w + W_LAST_TYPE)
        entry = layout_search(type_id)
        IyiHeap.write64(w + W_LAST_TYPE, type_id)
        IyiHeap.write64(w + W_LAST_ENTRY, entry)
        entry
      end

      def self.layout_search(type_id : UInt64) : UInt64
        table = layouts_table
        return 0_u64 if table == 0
        low = 0_u64
        high = IyiHeap.read64(table)
        while low < high
          mid = (low + high).unsafe_div(2_u64)
          entry = table + 8_u64 + mid * ENTRY
          entry_id = IyiHeap.read64(entry)
          return entry if entry_id == type_id
          if entry_id < type_id
            low = mid + 1_u64
          else
            high = mid
          end
        end
        0_u64
      end

      # Scan one object's payload and blacken it. With a layout, the scan is
      # exactly the pointer offsets the compiler wrote down — an integer
      # field holding something address-shaped retains nothing. An atomic
      # allocation with no layout is blackened and never opened: its caller
      # promised it holds no pointers, and honouring that promise is where
      # a 32 MiB `Array(Int32)` buffer stopped costing 20 ms of `base_of`
      # per collection. Everything else without a layout (a pointer-bearing
      # buffer, a closure environment, an id the table does not carry)
      # word-scans to the chunk's payload: the bytes past the request are
      # the allocator's zeros, or the last owner's, cleared at reuse.
      def self.scan(w : UInt64, base : UInt64) : Nil
        word = IyiHeap.read64(base - 8_u64)
        type_id = word.unsafe_shr(IyiHeap::TYPE_SHIFT)
        entry = layout_entry(w, type_id)
        if entry == 0
          unless word & IyiHeap::ATOMIC_FLAG != 0
            size = IyiHeap.size_of(base)
            cursor = base
            limit = base + size
            while cursor + 8_u64 <= limit
              shade(w, IyiRoots.base_of(IyiHeap.read64(cursor)))
              cursor = cursor + 8_u64
            end
          end
        else
          table = layouts_table
          offsets = table + 8_u64 + IyiHeap.read64(table) * ENTRY + IyiHeap.read64(entry + 32_u64) * 8_u64
          remaining = IyiHeap.read64(entry + 24_u64)
          index = 0_u64
          while index < remaining
            offset = IyiHeap.read64(offsets + index * 8_u64)
            shade(w, IyiRoots.base_of(IyiHeap.read64(base + offset)))
            index = index + 1_u64
          end
        end
        # Black, by a plain store: only the worker that grayed it holds it,
        # and every other worker's write to this word is a compare-and-swap
        # that fails on anything but white.
        word = IyiHeap.read64(base - 8_u64)
        IyiHeap.write64(base - 8_u64, (word - (word & COLOUR)) | BLACK)
        IyiHeap.write64(w + W_BYTES, IyiHeap.read64(w + W_BYTES) + IyiHeap.size_of(base))
        count_live(w, base)
      end

      # One more live object in its arena, folded per worker: consecutive
      # objects are mostly one arena's, so the shared add happens on the
      # arena change rather than per object.
      def self.count_live(w : UInt64, base : UInt64) : Nil
        arena = IyiHeap.arena_of(base)
        return if arena == 0
        if arena != IyiHeap.read64(w + W_LIVE_ARENA)
          flush_live(w)
          IyiHeap.write64(w + W_LIVE_ARENA, arena)
        end
        IyiHeap.write64(w + W_LIVE_PENDING, IyiHeap.read64(w + W_LIVE_PENDING) + 1_u64)
      end

      def self.flush_live(w : UInt64) : Nil
        arena = IyiHeap.read64(w + W_LIVE_ARENA)
        pending = IyiHeap.read64(w + W_LIVE_PENDING)
        if arena != 0 && pending != 0
          Pointer(Atomic(UInt64)).new(arena + IyiHeap::OFF_LIVE).value.add(pending)
        end
        IyiHeap.write64(w + W_LIVE_PENDING, 0_u64)
        IyiHeap.write64(w + W_LIVE_ARENA, 0_u64)
      end

      # One mark phase. Returns how many objects came out black, which is the
      # live count the exercise checks and the number Stage 6 will sweep
      # against.
      # One mark phase, on the collecting thread and, when the last mark
      # found more than PARALLEL_FROM live, on the helpers too. Roots go
      # gray on this thread's stack; the drain is every worker's. Returns
      # how many objects this thread blackened, the number the exercises
      # check when they run alone.
      def self.mark : UInt64
        w = worker
        @@collector_worker = w
        IyiHeap.write64(w + W_LEN, 0_u64)
        IyiHeap.write64(w + W_BYTES, 0_u64)
        @@bytes_marked = 0_u64
        arena = IyiHeap.first_arena
        while arena != 0
          IyiHeap.arena_live_reset(arena)
          arena = IyiHeap.arena_next(arena)
        end
        IyiHeap.write64(pool + POOL_HEAD, 0_u64)
        IyiHeap.write64(pool + POOL_CURSOR, IyiHeap.read64(pool + POOL_REGION_BASE))
        # Helpers by the work: one per MiB the last mark found live, up to
        # the number wanted — fifteen helpers on a three-MiB heap spent
        # the mark waking, contending for the pool and detecting the end
        # (94 ms across binary trees against 47 with three), and a large
        # live set is where they pay.
        helpers = @@last_marked.unsafe_div(PARALLEL_FROM)
        helpers = @@helpers_wanted if helpers > @@helpers_wanted
        if helpers > 0_u64
          start_helpers(helpers)
          helpers = @@helpers if @@helpers < helpers
        end
        @@workers = helpers + 1_u64
        IyiHeap.write64(pool + POOL_ASKED, helpers)
        pool_word(POOL_MARK_PERMITS).value.set(helpers)
        pool_word(POOL_FINISH).value.set(0_u64)
        @@helper_black = 0_u64
        pool_word(POOL_ACTIVE).value.set(0_u64)
        pool_word(POOL_HELPERS_DONE).value.set(0_u64)
        IyiRoots.each_root(->(base : UInt64) { shade(base) })
        # The helpers wake on the generation; from here every worker runs
        # the same drain, this thread included.
        if helpers > 0_u64
          pool_word(POOL_GENERATION).value.add(1_u64)
          wake_helpers
        end
        black = drain(w)
        # Every helper asked has answered - left the drain and folded its
        # accounts - before this thread reads them or turns the
        # generation again.
        while pool_word(POOL_HELPERS_DONE).value.get < mark_takers
          spin_pause
        end
        @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
        @@last_marked = @@bytes_marked
        @@workers = 0_u64
        black
      end

      # The drain: pop and scan until this stack and the pool are both empty
      # and no worker holds work. A worker counts itself out of ACTIVE when
      # it has nothing, back in when the pool has something, and the mark
      # is over at zero with an empty pool — a batch is always published
      # before its publisher could count out, so a spinner that sees zero
      # and an empty pool has seen every batch there will be.
      #
      # The count is of workers that took work, and every worker counts
      # itself *in* here rather than being counted by whoever asked for
      # it. Pre-setting it to the number asked is a hang: a mark's
      # permits let a helper skip a generation, and the helpers that did
      # take one then spun forever waiting for a count that nobody would
      # ever pay - the collector's own gate on a two-core runner, and the
      # thread exercise on three.
      def self.drain(w : UInt64) : UInt64
        black = 0_u64
        stack = IyiHeap.read64(w + W_STACK)
        active = pool_word(POOL_ACTIVE)
        active.value.add(1_u64)
        while true
          while (len = IyiHeap.read64(w + W_LEN)) > 0_u64
            len = len - 1_u64
            IyiHeap.write64(w + W_LEN, len)
            scan(w, IyiHeap.read64(stack + len * 8_u64))
            black = black + 1_u64
          end
          next if take_batch(w)
          active.value.sub(1_u64)
          while true
            if IyiHeap.read64(pool + POOL_HEAD) != 0
              active.value.add(1_u64)
              break
            end
            if active.value.get == 0_u64
              flush_live(w)
              return black
            end
            spin_pause
          end
        end
      end

      # This worker's own stack and then the pool, up to `limit` objects:
      # true when both are empty within the bound. The second stop's
      # probe of what the roots and the mutators' stacks found, with the
      # helpers parked: what does not finish within the bound is the
      # retreat's case, whatever it hangs off - a register, or a batch a
      # mutator published after the helpers found the pool empty.
      def self.drain_bounded(w : UInt64, limit : UInt64) : Bool
        stack = IyiHeap.read64(w + W_STACK)
        scanned = 0_u64
        while true
          len = IyiHeap.read64(w + W_LEN)
          if len == 0_u64
            return true unless take_batch(w)
            len = IyiHeap.read64(w + W_LEN)
          end
          return false if scanned >= limit
          len = len - 1_u64
          IyiHeap.write64(w + W_LEN, len)
          scan(w, IyiHeap.read64(stack + len * 8_u64))
          scanned = scanned + 1_u64
        end
      end

      # ── Helpers ─────────────────────────────────────────────────────────

      # How many helpers a mark may use. Set before the first collection;
      # the default is the core count less one, capped at fifteen, and 0
      # marks alone. A count past the cores is the cores less one: a
      # helper past the cores has no core to run on, and on darwin, where
      # a parked helper spins, fifteen of them on three cores held the
      # parallel mark's exercise past its five minutes.
      def self.workers=(count : UInt64) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          cap = default_helpers
          count = cap if count > cap
        {% end %}
        @@helpers_wanted = count
        @@workers_set = true
      end

      def self.workers : UInt64
        @@helpers_wanted
      end

      # A spin's breath: the CPU's pause hint, no syscall.
      def self.spin_pause : Nil
        {% if flag?(:x86_64) %}
          asm("pause" :::: "volatile")
        {% else %}
          asm("yield" :::: "volatile")
        {% end %}
      end

      {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
      def self.default_helpers : UInt64
        cores = IyiThread.core_count
        cores = 16_u64 if cores > 16_u64
        cores > 1_u64 ? cores - 1_u64 : 0_u64
      end

      # Helpers up to `count`, and every one of them at its park before
      # this returns: a helper that read the generation after it turned
      # would sleep through the mark, and the collector waits for every
      # helper to answer a generation it turned.
      def self.start_helpers(count : UInt64) : Nil
        pool
        while @@helpers < count
          IyiThread.start_helper(helper_entry, @@helpers)
          @@helpers = @@helpers + 1_u64
        end
        while pool_word(POOL_READY).value.get < @@helpers
          spin_pause
        end
      end

      def self.helper_entry : UInt64
        proc = ->(index : UInt64) { IyiMark.helper_main(index) }
        Pointer(UInt64).new(pointerof(proc).address).value
      end

      # A helper's whole life: park on the generation, drain, fold its
      # accounts, count itself done, park again.
      def self.helper_main(index : UInt64) : Nil
        w = worker
        seen = pool_word(POOL_GENERATION).value.get
        pool_word(POOL_READY).value.add(1_u64)
        while true
          seen = wait_generation(seen)
          # A permit or nothing: a helper the mark did not ask for parks
          # again without counting itself in, and is not waited for.
          slot = take_mark_permit
          if slot != NO_PERMIT
            IyiHeap.write64(w + W_LEN, 0_u64)
            IyiHeap.write64(w + W_BYTES, 0_u64)
            IyiHeap.write64(w + W_BLACK, drain(w))
            fold_helper(w)
            pool_word(POOL_HELPERS_DONE).value.add(1_u64)
            # Beside the program, the drain's end is not the mark's: the
            # first taker waits for the rest - for the count taken, which
            # rises if another helper is still arriving and is never a
            # promise a missing helper has to keep - and takes the second
            # stop.
            if slot == 0_u64 && pool_word(POOL_FINISH).value.get != 0_u64
              pool_word(POOL_FINISH).value.set(0_u64)
              while pool_word(POOL_HELPERS_DONE).value.get < mark_takers
                spin_pause
              end
              # The finish turns the generation once more, for the
              # remainder, and again for the sweep round; that is the one
              # this helper waits past next.
              seen = finish_concurrent
            end
          end
          # The round, if one is open and a permit is left: arenas until
          # none is left or a collection closes it.
          if take_sweep_permit
            while sweep_one_helper
            end
          end
        end
      end

      # A spin before the park, and the reason is the stop rather than the
      # wake: a sleeping thread has to be scheduled before it can answer a
      # stop-the-world signal, and on a machine with fewer cores than
      # threads that is milliseconds - darwin's CI runner has three cores,
      # and its every-collection stop went from tens of microseconds to
      # milliseconds when the helpers stopped spinning. Collections come
      # in bursts, so a helper that spins for the length of one stays hot
      # through the burst and sleeps between them; SPIN_BEFORE_PARK is
      # about fifty microseconds of the pause hint.
      SPIN_BEFORE_PARK = 20000_u64

      def self.spin_for_generation(word : Pointer(Atomic(UInt64)), seen : UInt64) : UInt64
        spins = 0_u64
        while spins < SPIN_BEFORE_PARK
          now = word.value.get
          return now if now != seen
          spin_pause
          spins = spins + 1_u64
        end
        seen
      end

      # A round's permits are SWEEP_HELPERS; on Linux that many helpers
      # are woken and each takes one, on darwin every helper spins awake
      # and the first that many do.
      def self.take_sweep_permit : Bool
        word = pool_word(POOL_SWEEP_PERMITS)
        while true
          left = word.value.get
          return false if left == 0_u64
          return true if word.value.compare_and_set(left, left - 1_u64)[1]
        end
      end

      # A helper's bytes into the collection's, under the pool lock; its
      # per-arena counts were flushed by the drain.
      def self.fold_helper(w : UInt64) : Nil
        pool_lock
        @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
        @@helper_black = @@helper_black + IyiHeap.read64(w + W_BLACK)
        pool_unlock
        # Folded once: the second stop folds every worker page's bytes
        # for the mutators' assists, and a helper's page is on that list
        # too - live churn's 40 MB read as 76 with helpers counted twice.
        IyiHeap.write64(w + W_BYTES, 0_u64)
      end

      # Objects the helpers blackened in the last mark: zero means the
      # helpers were woken and found nothing to share, which
      # `bench/parallel_mark.sh` refuses.
      def self.helper_black : UInt64
        @@helper_black
      end

      @@helper_black : UInt64 = 0_u64

      {% if flag?(:linux) %}
        # The generation is one word and every helper sleeps on it: a
        # futex wake of fifteen threads is microseconds, and a per-helper
        # park that woke only the helpers a mark asked let a helper miss a
        # generation and the mark wait forever (`helper_main` says how).
        def self.wait_generation(seen : UInt64) : UInt64
          word = pool_word(POOL_GENERATION)
          spun = spin_for_generation(word, seen)
          return spun if spun != seen
          while (now = word.value.get) == seen
            __iyi_conc_syscall6(IYI_SYS_FUTEX, (pool + POOL_GENERATION).to_i64, IYI_FUTEX_WAIT, seen.to_i64, 0_i64, 0_i64, 0_i64)
          end
          now
        end

        def self.wake_helpers : Nil
          __iyi_conc_syscall6(IYI_SYS_FUTEX, (pool + POOL_GENERATION).to_i64, IYI_FUTEX_WAKE, 1000000_i64, 0_i64, 0_i64, 0_i64)
        end

        def self.wake_some_helpers(count : UInt64) : Nil
          wake_helpers
        end
      {% else %}
        # darwin has no futex: a helper spins on the generation with a
        # yield between reads, which costs no name on the floor.
        # darwin's helpers spin on the generation, and it is a hot spin -
        # `yield` there is the ARM hint, not a syscall. Measured and kept:
        # a park was built for them, a pipe per helper (there is no futex
        # on darwin, and a signal handler may call `read` but not
        # `os_unfair_lock_lock`), and on CI's three-core runner it cost
        # binary trees 1.07 s against the spin's 0.23 and churn 0.19
        # against 0.075. A parked helper has to be woken and then
        # scheduled before it marks, and on a machine with three cores
        # that is the mark's latency; a spinning helper is at the pool the
        # instant the generation turns, and the core it burns while idle
        # is worth less than the mark it delays. Linux's futex park costs
        # microseconds and keeps its cores, which is why the platforms
        # differ here at all.
        def self.wait_generation(seen : UInt64) : UInt64
          word = pool_word(POOL_GENERATION)
          while (now = word.value.get) == seen
            IyiThread.yield_cpu
          end
          now
        end

        # Nothing to wake: a darwin helper is spinning on the generation,
        # which the caller has already turned.
        def self.wake_helpers : Nil
        end

        def self.wake_some_helpers(count : UInt64) : Nil
        end
      {% end %}
      {% else %}
        # No kernel thread on this target (x86_64 darwin): the mark runs
        # alone and asks for no helper.
        def self.default_helpers : UInt64
          0_u64
        end

        def self.start_helpers(count : UInt64) : Nil
        end

        def self.wake_helpers : Nil
        end

        def self.wake_some_helpers(count : UInt64) : Nil
        end
      {% end %}

      # Put every live object back to white, so a second phase starts from
      # where the first one did. Stage 6 does this as it sweeps, one walk
      # instead of two; until then the exercise needs a way to run the phase
      # more than once.
      def self.unmark : Nil
        arena = IyiHeap.first_arena
        while arena != 0
          chunk = IyiHeap.arena_chunk(arena)
          cursor = arena + IyiHeap::HEAD
          stop = IyiHeap.arena_high(arena)
          while cursor < stop
            recolour(cursor + IyiHeap::HEADER, WHITE) unless IyiHeap.uncarved_held?(arena, cursor)
            cursor = cursor + chunk
          end
          arena = IyiHeap.arena_next(arena)
        end
        node = IyiHeap.first_large
        while node != 0
          recolour(node + IyiHeap::LARGE_USER, WHITE)
          node = IyiHeap.large_next(node)
        end
      end

      # iyi: GC_DESIGN.md Stage 6, the sweep. Stage 5 decided what is garbage;
      # this is where the memory comes back. One walk over every chunk that has
      # been carved: a white object is unreachable, so its chunk goes on its
      # class's free list, and a black one survives and is repainted white for
      # the next cycle. Repainting as it goes is why sweep does not need a
      # second pass, and why `unmark` above is only the exercise's tool.
      #
      # A chunk already on a free list is skipped rather than freed again. It is
      # white, because nothing marked it and nothing owns it, and freeing it
      # twice would put one chunk on the list twice, which is the same memory
      # handed to two callers. `free_listed?` is that check, and it is why this
      # loop cannot simply trust the colour.
      #
      # A large object's `next` is read before the node is released, because
      # releasing it unmaps the memory the link lives in.
      #
      # What is not here, and why. **Finalizers**: nothing in this language
      # defines one. There is no `def finalize` anywhere in `src/iyi` or
      # `samples/iyi`, so a finalizer queue would be a mechanism no program
      # could put an entry in, which is the shape SPEC.md III.4.8 refused for a
      # concurrency marker and the shape this collector has refused twice
      # already. **Weak references**: the same answer. They are registration
      # based and the standard library's `WeakRef` lives on the `--crystal`
      # side, so there is no table here to walk and null out. Both wait on the
      # language having the feature rather than on the collector.
      # The sweep is lazy since the thread cutover, the way Go's is: a
      # collection marks, stamps a new epoch, and returns; every arena behind
      # the epoch is sweep debt, and the debt is paid one arena at a time by
      # the allocator that runs out of swept chunks (`IyiHeap.refill`) — so
      # the sweep's cost lands on the allocations that need its memory, in
      # proportion to them, and never inside the pause. What a pause is now
      # is the mark, and the mark alone. The next collection pays whatever
      # debt is left before it marks, because an unswept arena still wears
      # the last mark's colours; under steady allocation that is little or
      # nothing, and the exercise reports it. `sweep` here is the eager verb:
      # every arena and the large list at once, what `IyiMark.collect` runs
      # for a program that asked for its memory back now.
      def self.sweep : Nil
        while sweep_one
        end
        sweep_large
      end

      # ── The sweep, in slices, and beside the program — GC_DESIGN.md
      # Stage 8 ──────────────────────────────────────────────────────────
      #
      # An arena is swept in slices of SWEEP_SPAN bytes, from a cursor it
      # carries, by whoever needs its chunks or has time: an allocating
      # thread that finds nothing swept for its class takes one slice of
      # an arena of that class and goes on allocating from it, some
      # microseconds; the helpers, after a collection, take whole arenas
      # slice after slice and hand each slice's batch over as they go.
      # The sweep is a walk of every chunk header in the heap - binary
      # trees paid a fifth of its wall time walking, on the thread that
      # allocates - and the slices are what let it leave that thread
      # without a wait: a helper mid-arena is mid-slice for microseconds,
      # and the thread that wants the arena's next slice waits for that,
      # not for the arena.
      #
      # The words: an arena's epoch says whether its sweep for this
      # epoch has begun; its cursor says how far it got, accurate whenever
      # nobody is inside a slice of it, because a slicer writes it back
      # before it lets anything stop it; and OFF_SWEEPING is the walk
      # claim, held across one slice, so two walkers never share one. A
      # pause takes no claim: every thread is stopped where no slice is,
      # and it finishes every arena from its cursor - and so does the
      # thread that triggers a collection, before it stops anything and
      # on its own clock, the way the concurrent mark's first stop
      # already paid the debt: a half-swept arena wears two epochs'
      # colours, and the mark reads one.
      #
      # A round is open from a collection's end to the next collection's
      # start. SWEEP_HELPERS helpers take it - a sweep walks at memory's
      # speed, one helper outruns an allocating thread's consumption
      # tenfold, and fifteen of them beside binary trees cost it its
      # core's other half. The next collection closes the round, so no
      # slice starts after, and waits out the slices in flight - a
      # half-swept slice wears two epochs' colours, and the mark reads
      # one - with the lock released, since a slice's end wants it.
      SWEEP_SPAN = 65536_u64
      SWEEP_HELPERS = 3_u64

      # A slice of an arena of `wanted`'s class, or any if the class has
      # none left, by an allocating thread. Answers 1 for a slice swept,
      # 2 for a slice of the class that a helper is inside - the caller
      # spins, its batch is microseconds away - and 0 for nothing left.
      def self.sweep_one(wanted : UInt64) : UInt64
        # No debt, no lock: with every list dropped at the pause, a thread
        # carving fresh chunks refills on every allocation, and each refill
        # came here - a lock and a walk of the arena list, 39 ns of a
        # release build's allocation on Linux and a microsecond on
        # darwin, for nothing to sweep. The count is read without the
        # lock; a stale nonzero takes the lock and finds nothing, a stale
        # zero carves a chunk that a sweep would have handed back later.
        IyiRuntimeLock.lock
        arena = claim_slice(wanted, false)
        IyiRuntimeLock.unlock
        return arena if arena < 4_u64
        epoch = @@epoch
        batch = sweep_slice(arena, SWEEP_SPAN)
        IyiRuntimeLock.lock
        release_claim(arena, epoch)
        arena_done(arena, epoch)
        # A collection may have come and gone while this thread waited
        # for the lock - it was inside the allocator, so it was stopped
        # after its slice and after the cursor was written, and the pause
        # went on from there - and the pause dropped every list. A batch
        # from the old epoch is left to the new one's sweep, which finds
        # its chunks by their flag; handed over, the same chunk would be
        # on two lists.
        IyiHeap.free_batch(IyiHeap.class_index(IyiHeap.arena_chunk(arena) - IyiHeap::HEADER), batch) if batch != 0 && @@epoch == epoch
        IyiRuntimeLock.unlock
        1_u64
      end

      # Under the lock: an arena with sweeping left, its walk claim taken.
      # An arena not yet begun this epoch is begun here: its cursor set
      # to its first chunk, the count of unbegun arenas down by one.
      #
      # `wanted` names a class to take first, 0 any; `helper` says a
      # helper asks, which takes any class when the wanted one has none
      # left, where an allocating thread answers 2 (busy) if the wanted
      # class has arenas but every one is inside another walker's slice,
      # and 0 only when the class has nothing left to sweep at all.
      def self.claim_slice(wanted : UInt64, helper : Bool) : UInt64
        epoch = @@epoch
        busy = false
        pass = 0
        while pass < 2
          chunk = pass == 0 ? wanted : 0_u64
          if chunk != 0 || pass == 1
            arena = IyiHeap.first_arena
            while arena != 0
              if (chunk == 0 || IyiHeap.arena_chunk(arena) == chunk) && sweep_left?(arena, epoch)
                if IyiHeap.read64(arena + IyiHeap::OFF_SWEEPING) == epoch
                  busy = true
                else
                  begin_arena(arena, epoch, helper ? 2 : 1) if IyiHeap.arena_epoch(arena) != epoch
                  IyiHeap.write64(arena + IyiHeap::OFF_SWEEPING, epoch)
                  return arena
                end
              end
              arena = IyiHeap.arena_next(arena)
            end
          end
          # An allocating thread wants its class: busy is an answer, and
          # so is nothing of the class; a helper goes on to any, and busy
          # is its answer too once every arena with work is inside
          # another's slice - a helper that took that for nothing left
          # went back to its park with the round barely begun, and the
          # allocating thread swept the heap itself, slice after slice.
          return 2_u64 if !helper && busy
          return 0_u64 if !helper && wanted != 0
          pass = pass + 1
        end
        busy ? 2_u64 : 0_u64
      end

      def self.sweep_left?(arena : UInt64, epoch : UInt64) : Bool
        IyiHeap.arena_epoch(arena) != epoch || IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_CURSOR) != IyiHeap::SWEEP_DONE
      end

      # Under the lock: an arena's sweep for this epoch begun, by a
      # helper (2), an allocating thread (1) or a pause (0).
      def self.begin_arena(arena : UInt64, epoch : UInt64, who : Int32) : Nil
        IyiHeap.arena_epoch_set(arena, epoch)
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_CURSOR, arena + IyiHeap::HEAD)
        @@unswept = @@unswept - 1_u64 if @@unswept > 0_u64
        @@swept_by_helpers = @@swept_by_helpers + 1_u64 if who == 2
        @@swept_by_allocator = @@swept_by_allocator + 1_u64 if who == 1
      end

      # Under the lock, after a slice: the arena counted out if the slice
      # reached its end, in the epoch the slice ran in - a slice parked
      # through a pause finished an arena of an epoch that is gone, and
      # the new epoch's count is the new epoch's.
      def self.arena_done(arena : UInt64, epoch : UInt64) : Nil
        return unless @@epoch == epoch && IyiHeap.mapped?(arena)
        return unless IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_CURSOR) == IyiHeap::SWEEP_DONE
        # Once: a walker parked through a pause that finished its arena
        # comes here after the pause did.
        return if IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_COUNTED) == epoch
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_COUNTED, epoch)
        @@sweep_left = @@sweep_left - 1_u64 if @@sweep_left > 0_u64
        IyiHeap.sweep_left_add(IyiHeap.class_index(IyiHeap.arena_chunk(arena) - IyiHeap::HEADER), -1_i64)
      end

      # Under the lock: the walk claim let go, if it is still this walk's
      # - a claim of an older epoch stands until its walker clears it,
      # and a newer walker's claim on the same arena is not this one's -
      # and only if the arena is still an arena: a pause's scavenge may
      # have handed the mapping back while this thread waited at the lock.
      def self.release_claim(arena : UInt64, epoch : UInt64) : Nil
        if IyiHeap.mapped?(arena) && IyiHeap.read64(arena + IyiHeap::OFF_SWEEPING) == epoch
          IyiHeap.write64(arena + IyiHeap::OFF_SWEEPING, 0_u64)
        end
      end

      # The pause's own sweep, the lock held and every thread stopped: one
      # arena with sweeping left finished from its cursor, whoever's
      # claim stands on it - a claim stands for a walker parked at the
      # lock after its slice, whose batch that walker will discard.
      # Answers whether there was one.
      def self.sweep_one_held : Bool
        epoch = @@epoch
        arena = IyiHeap.first_arena
        while arena != 0 && !sweep_left?(arena, epoch)
          arena = IyiHeap.arena_next(arena)
        end
        return false if arena == 0
        begin_arena(arena, epoch, 0) if IyiHeap.arena_epoch(arena) != epoch
        index = IyiHeap.class_index(IyiHeap.arena_chunk(arena) - IyiHeap::HEADER)
        batch = sweep_slice(arena, IyiHeap::SWEEP_DONE)
        IyiHeap.free_batch(index, batch) if batch != 0
        arena_done(arena, epoch)
        true
      end

      # The triggering thread's sweep before the stop, the lock held on
      # entry and on exit and released for the walk: one arena with
      # sweeping left and no slice in flight, claimed and finished from
      # its cursor while every other thread runs. An arena a thread is
      # inside a slice of is left to the pause. Answers whether there was
      # one.
      def self.sweep_one_before_stop : Bool
        epoch = @@epoch
        arena = IyiHeap.first_arena
        while arena != 0 && !(sweep_left?(arena, epoch) && IyiHeap.read64(arena + IyiHeap::OFF_SWEEPING) != epoch)
          arena = IyiHeap.arena_next(arena)
        end
        return false if arena == 0
        begin_arena(arena, epoch, 0) if IyiHeap.arena_epoch(arena) != epoch
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEPING, epoch)
        IyiRuntimeLock.unlock
        batch = sweep_slice(arena, IyiHeap::SWEEP_DONE)
        IyiRuntimeLock.lock
        release_claim(arena, epoch)
        arena_done(arena, epoch)
        IyiHeap.free_batch(IyiHeap.class_index(IyiHeap.arena_chunk(arena) - IyiHeap::HEADER), batch) if batch != 0
        true
      end

      # Whether helpers are at a round right now: the allocating thread
      # spins on a class's batch only while one is coming.
      def self.helpers_sweeping? : Bool
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          @@helpers > 0_u64 && @@sweep_left != 0_u64 && pool_word(POOL_SWEEP).value.get != 0_u64
        {% else %}
          false
        {% end %}
      end

      {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
        # A helper's turn of the round: one slice, the way an allocating
        # thread takes one - so three helpers are on one arena at once,
        # and the arena a program churns through is swept three times
        # faster - its batch handed over under the lock; or false when
        # the round is closed or nothing is left. The slice is counted in
        # while it runs, so the collection that closes the round can wait
        # it out; a helper parked at the lock after its slice may wait
        # through a whole collection, and its batch is then an old
        # epoch's, discarded.
        def self.sweep_one_helper : Bool
          return false if pool_word(POOL_SWEEP).value.get == 0_u64
          IyiRuntimeLock.lock
          arena = 0_u64
          if pool_word(POOL_SWEEP).value.get != 0_u64
            wanted = pool_word(POOL_SWEEP_WANTED).value.get
            arena = claim_slice(wanted == 0_u64 ? 0_u64 : IyiHeap.payload(wanted.to_i32 - 1) + IyiHeap::HEADER, true)
            # Counted in under the lock that closes the round: closed, no
            # slice starts; open, a slice begun is counted before the
            # closer looks.
            pool_word(POOL_SWEEPERS).value.add(1_u64) if arena > 2_u64
          end
          IyiRuntimeLock.unlock
          return false if arena == 0
          if arena == 2_u64
            # Every arena with work is inside another's slice, for
            # microseconds: wait off the lock and come back.
            spins = 0
            while spins < 64
              spin_pause
              spins = spins + 1
            end
            return true
          end
          epoch = @@epoch
          batch = sweep_slice(arena, SWEEP_SPAN)
          pool_word(POOL_SWEEPERS).value.sub(1_u64)
          IyiRuntimeLock.lock
          release_claim(arena, epoch)
          arena_done(arena, epoch)
          IyiHeap.free_batch(IyiHeap.class_index(IyiHeap.arena_chunk(arena) - IyiHeap::HEADER), batch) if batch != 0 && @@epoch == epoch
          IyiRuntimeLock.unlock
          true
        end

        # At a collection's end, with helpers, before the threads it
        # stopped are released: the round opened, so the first refill
        # after the release finds helpers coming rather than sweep alone.
        # The wake itself comes after the lock is released - a thread
        # woken may preempt the waker, and seven helpers woken inside the
        # stop made a 90 us pause 1.6 ms. SWEEP_HELPERS of the parked
        # helpers are woken, and each takes a permit; on darwin every
        # helper spins awake and the first SWEEP_HELPERS take one.
        def self.open_sweep_round : Nil
          return if @@helpers == 0_u64 || @@sweep_left == 0_u64
          IyiHeap.write64(pool + POOL_ASKED, 0_u64)
          pool_word(POOL_MARK_PERMITS).value.set(0_u64)
          pool_word(POOL_HELPERS_DONE).value.set(0_u64)
          pool_word(POOL_SWEEP_PERMITS).value.set(@@helpers < SWEEP_HELPERS ? @@helpers : SWEEP_HELPERS)
          pool_word(POOL_SWEEP).value.set(1_u64)
          pool_word(POOL_GENERATION).value.add(1_u64)
          @@round_to_wake = true
        end

        @@round_to_wake : Bool = false

        def self.wake_sweep_round : Nil
          return unless @@round_to_wake
          @@round_to_wake = false
          wake_some_helpers(SWEEP_HELPERS)
        end

        # Before a collection stops anything, under the lock: the round
        # closed, and the slices in flight waited out with the lock
        # released, since a slice's end wants it.
        def self.close_sweep_round : Nil
          return if @@helpers == 0_u64
          pool_word(POOL_SWEEP).value.set(0_u64)
          pool_word(POOL_SWEEP_PERMITS).value.set(0_u64)
          while pool_word(POOL_SWEEPERS).value.get != 0_u64
            IyiRuntimeLock.unlock
            spin_pause
            IyiRuntimeLock.lock
          end
        end
      {% end %}

      # An allocating thread about to wait on a class names it for the
      # helpers; the last to name one is the one they read.
      def self.sweep_wanted(index : Int32) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          pool_word(POOL_SWEEP_WANTED).value.set(index.to_u64 + 1_u64)
        {% end %}
      end

      # Dead chunks go on the class's list in one batch - except a run of
      # them long enough to cover whole pages, RELEASE_PAGES or more, once
      # the epoch's sweeps have kept a budget's worth of such runs
      # resident: those pages go back to the kernel, and the chunks whose
      # head is on them go on no list, to be carved again when the run is
      # taken up. The run's chunks straddling its edges are the list's.
      # Runs are found as the walk goes and released as they close, one
      # `madvise` each.
      #
      # The retention is the point. Released on sight, every page the
      # program churns through went back and came back each cycle - a
      # syscall per run and a fault per page - and a 64-byte allocation
      # cost 220 ns where it had cost 21. What the program will allocate
      # before the next collection is the budget, and that much of the
      # free pages is kept warm; what is free beyond it is what a smaller
      # program would never have touched, and it goes back.
      RELEASE_PAGES = 2_u64
      @@kept_pages : UInt64 = 0_u64

      # One slice: from the arena's cursor, `span` bytes or to its high
      # water, whichever is first; the cursor written back at the end,
      # before anything can stop this thread. Answers the batch of dead
      # chunks for the centre; the caller hands it over under the lock.
      def self.sweep_slice(arena : UInt64, span : UInt64) : UInt64
        chunk = IyiHeap.arena_chunk(arena)
        first = arena + IyiHeap::HEAD
        batch_head = 0_u64
        cursor = IyiHeap.read64(arena + IyiHeap::OFF_SWEEP_CURSOR)
        high = IyiHeap.arena_high(arena)
        if cursor >= high
          IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_CURSOR, IyiHeap::SWEEP_DONE)
          return 0_u64
        end
        stop = high
        stop = cursor + span if stop - cursor > span
        @@bytes_walked = @@bytes_walked + (stop - cursor)
        # The uncarved part of the bump region, read once: the cursor only
        # rises, and a chunk carved past the value read here wears this
        # epoch's parity and is left alone either way.
        region_low = IyiHeap.arena_cursor(arena)
        region_high = IyiHeap.read64(arena + IyiHeap::OFF_BUMP_END)
        # The run of dead chunks in progress: its first head, and what the
        # batch's head was before it, so that a run whose pages go back
        # can be taken off the batch again in one assignment - every dead
        # chunk is linked as the walk meets it, and a released run's
        # chunks are the batch's newest prefix.
        run_low = 0_u64
        run_batch = 0_u64
        while cursor < stop
          if cursor >= region_low && cursor < region_high
            # Uncarved: past the region in one step, the run closed.
            if run_low != 0
              batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch)
              run_low = 0_u64
            end
            cursor = first + (region_high - first + chunk - 1_u64).unsafe_div(chunk) * chunk
            next
          end
          if IyiHeap.page_released?(arena, cursor)
            # On a page handed back: past the page in one step, likewise.
            if run_low != 0
              batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch)
              run_low = 0_u64
            end
            page_end = (cursor & (0_u64 &- IyiHeap::PAGE)) + IyiHeap::PAGE
            cursor = first + (page_end - first + chunk - 1_u64).unsafe_div(chunk) * chunk
            next
          end
          word = IyiHeap.read64(cursor + IyiHeap::OFF_MARK)
          if word & IyiHeap::FREE_FLAG != 0 || (word & COLOUR == WHITE && word & IyiHeap::EPOCH_FLAG != @@epoch_flag)
            # Free already, on a list the pause dropped, or unmarked and
            # allocated before the mark: dead, and the run's.
            if word & IyiHeap::FREE_FLAG == 0
              @@bytes_freed = @@bytes_freed + chunk - IyiHeap::HEADER
              @@swept = @@swept + 1_u64
              IyiHeap.write64(cursor + IyiHeap::OFF_MARK, word | IyiHeap::FREE_FLAG)
            end
            if run_low == 0
              run_low = cursor
              run_batch = batch_head
            end
            IyiHeap.write64(cursor + IyiHeap::OFF_LINK, batch_head)
            batch_head = cursor
          else
            if word & COLOUR != WHITE
              # Marked: survives, white again and this epoch's. A white
              # chunk of this epoch's parity was allocated after the mark,
              # alive by construction, and is left as it is.
              @@bytes_kept = @@bytes_kept + chunk - IyiHeap::HEADER
              IyiHeap.write64(cursor + IyiHeap::OFF_MARK, (word - (word & COLOUR) - (word & IyiHeap::EPOCH_FLAG)) | @@epoch_flag)
              @@kept = @@kept + 1_u64
            end
            if run_low != 0
              batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch)
              run_low = 0_u64
            end
          end
          cursor = cursor + chunk
        end
        # The run in progress closes at the slice's end and the next slice
        # begins one of its own: a run cut back for a page release is the
        # batch's newest prefix, and a batch handed over is nobody's to
        # cut. A run split at a slice's edge may keep a page it would
        # have released; the slices are sixteen pages, the edge one.
        batch_head = close_run(arena, chunk, run_low, cursor, batch_head, run_batch) if run_low != 0
        # Past the high water the arena is done: what is carved after
        # this wears the epoch's parity and is alive by construction.
        IyiHeap.write64(arena + IyiHeap::OFF_SWEEP_CURSOR, cursor >= high ? IyiHeap::SWEEP_DONE : cursor)
        batch_head
      end

      # A closed run of dead chunks, `[low, high)` in chunk heads, all of
      # them linked onto the batch already as its newest prefix, above
      # `batch_before`. The whole pages inside the run are released when
      # there are enough and the epoch's sweeps have kept a budget's
      # worth: then the batch is cut back to `batch_before` and the run's
      # chunks whose head is on no released page - the ones at its edges
      # - are linked again. Answers the batch's head.
      def self.close_run(arena : UInt64, chunk : UInt64, low : UInt64, high : UInt64, batch_head : UInt64, batch_before : UInt64) : UInt64
        page_low = (low + IyiHeap::PAGE - 1_u64) & (0_u64 &- IyiHeap::PAGE)
        page_high = high & (0_u64 &- IyiHeap::PAGE)
        return batch_head unless page_low < page_high && page_high - page_low >= RELEASE_PAGES * IyiHeap::PAGE
        pages = (page_high - page_low).unsafe_shr(IyiHeap::PAGE_SHIFT)
        kept = Pointer(Atomic(UInt64)).new(pointerof(@@kept_pages).address)
        if kept.value.get * IyiHeap::PAGE < budget
          kept.value.add(pages)
          return batch_head
        end
        IyiHeap.set_released(arena, page_low, page_high, true)
        IyiHeap.write64(arena + IyiHeap::OFF_RELEASED, IyiHeap.read64(arena + IyiHeap::OFF_RELEASED) + pages)
        IyiHeap.pages_released_add(pages)
        batch_head = batch_before
        cursor = low
        while cursor < page_low
          IyiHeap.write64(cursor + IyiHeap::OFF_LINK, batch_head)
          batch_head = cursor
          cursor = cursor + chunk
        end
        first = arena + IyiHeap::HEAD
        cursor = first + (page_high - first + chunk - 1_u64).unsafe_div(chunk) * chunk
        while cursor < high
          IyiHeap.write64(cursor + IyiHeap::OFF_LINK, batch_head)
          batch_head = cursor
          cursor = cursor + chunk
        end
        # After the links: a released page written to would be resident
        # again, and none is written to above.
        __iyi_release_pages(page_low, page_high - page_low)
        batch_head
      end

      # The scavenge, in the pause with every thread stopped: an arena the
      # mark found nothing alive in goes back to the kernel (a collector
      # that reclaims chunks but never mappings has a high-water heap, not
      # a heap) — every free list, the centre's and each stopped thread's
      # cache's, stripped of its chunks first, which is why this is the
      # pause's and not the lazy sweeper's: a sweeper on one thread cannot
      # edit another running thread's cache. Some cache's warm fill arena
      # is exempt, the cushion that keeps spike-then-idle from paying an
      # mmap on its next allocation. Runs after the mark and before the
      # epoch turns, so a released arena is never debt.
      def self.scavenge : Nil
        # Every free list dropped first - the centre's and each stopped
        # thread's cache's - which is what lets a mapping go back without
        # a walk of the lists for its chunks, and what `begin_sweep` says
        # the sweep needs anyway.
        IyiHeap.drop_free_lists
        previous = 0_u64
        arena = IyiHeap.first_arena
        while arena != 0
          following = IyiHeap.arena_next(arena)
          if IyiHeap.arena_live(arena) == 0 && IyiHeap.release_arena(previous, arena)
            @@arenas_released = @@arenas_released + 1_u64
          else
            previous = arena
          end
          arena = following
        end
      end

      # The large list is short and its sweep is a walk of nodes, not of
      # memory: eager, under the collection's own lock.
      def self.sweep_large : Nil
        node = IyiHeap.first_large
        while node != 0
          following = IyiHeap.large_next(node)
          base = node + IyiHeap::LARGE_USER
          word = IyiHeap.read64(base - 8_u64)
          if word & COLOUR == WHITE && word & IyiHeap::EPOCH_FLAG != @@epoch_flag
            @@bytes_freed = @@bytes_freed + IyiHeap.read64(node + IyiHeap::OFF_MAP) - IyiHeap::LARGE_USER
            @@swept = @@swept + 1_u64
            IyiHeap.free_large(node + 16_u64)
          elsif word & COLOUR != WHITE
            @@bytes_kept = @@bytes_kept + IyiHeap.read64(node + IyiHeap::OFF_MAP) - IyiHeap::LARGE_USER
            IyiHeap.write64(base - 8_u64, (word - (word & COLOUR) - (word & IyiHeap::EPOCH_FLAG)) | @@epoch_flag)
            @@kept = @@kept + 1_u64
          end
          node = following
        end
      end

      # A new epoch: every arena is debt, the counters this epoch's sweep
      # fills start again. Called with the lock held, after a mark.
      # The epoch turns. Every free list was dropped at the scavenge, so
      # the sweep is the only source of free chunks: a chunk left on a
      # list from the last sweep, sitting between two dead ones, broke the
      # run they would have made and kept its page resident - with the
      # lists carried across, an arena of 40-byte chunks holding 1.5 MB
      # live kept 12 MB of pages. The chunks keep their free flag, so the
      # sweep of their arena finds them where it finds the dead, and they
      # join whatever run they lie in.
      def self.begin_sweep : Nil
        @@kept_pages = 0_u64
        @@epoch = @@epoch + 1_u64
        @@epoch_flag = (@@epoch & 1_u64) * IyiHeap::EPOCH_FLAG
        @@swept = 0_u64
        @@kept = 0_u64
        @@bytes_freed = 0_u64
        @@bytes_kept = 0_u64
        @@bytes_walked = 0_u64
        debt = 0_u64
        index = 0
        while index < IyiHeap::CLASSES
          IyiHeap.central[IyiHeap::SWEEP_LEFT_AT + index] = 0_u64
          index = index + 1
        end
        arena = IyiHeap.first_arena
        while arena != 0
          debt = debt + 1_u64
          IyiHeap.sweep_left_add(IyiHeap.class_index(IyiHeap.arena_chunk(arena) - IyiHeap::HEADER), 1_i64)
          arena = IyiHeap.arena_next(arena)
        end
        @@unswept = debt
        @@sweep_left = debt
        @@collections = @@collections + 1_u64
      end

      @@epoch : UInt64 = 1_u64
      # `EPOCH_FLAG` or 0: the parity the allocator stamps on a chunk it
      # hands out, and the sweep compares against.
      @@epoch_flag : UInt64 = 16_u64
      # Arenas whose sweep for this epoch has not begun, and arenas with
      # any of it left - the second is the allocator's fast answer.
      @@unswept : UInt64 = 0_u64
      @@sweep_left : UInt64 = 0_u64
      @@debt_paid_in_pause : UInt64 = 0_u64
      @@debt_paid_before_stop : UInt64 = 0_u64
      @@swept_by_allocator : UInt64 = 0_u64
      @@swept_by_helpers : UInt64 = 0_u64
      @@bytes_marked : UInt64 = 0_u64

      def self.epoch : UInt64
        @@epoch
      end

      def self.epoch_flag : UInt64
        @@epoch_flag
      end

      # Arenas whose sweep this epoch has not begun: what the next pause
      # would have to sweep first, less the ones begun and unfinished.
      def self.debt : UInt64
        @@unswept
      end

      # Arenas the pauses swept before marking, in all — the lazy sweep's
      # honest failure count, printed by the exercise.
      # Arenas a concurrent collection's triggering thread swept before its
      # first stop: paid by the program, but by nobody else's clock.
      def self.debt_paid_before_stop : UInt64
        @@debt_paid_before_stop
      end

      def self.debt_paid_in_pause : UInt64
        @@debt_paid_in_pause
      end

      # Arenas the allocator began sweeping on its own time, outside any
      # pause; and the ones the helpers began.
      def self.swept_by_allocator : UInt64
        @@swept_by_allocator
      end

      def self.swept_by_helpers : UInt64
        @@swept_by_helpers
      end

      def self.bytes_marked : UInt64
        @@bytes_marked
      end

      # The allocation-pressure trigger — what makes this a collector rather
      # than a verb the exercises call. `IyiHeap.take` reports every
      # allocation's requested size here, and when the bytes allocated since
      # the last collection cross the budget, one collection runs — *before*
      # the carve, so the object about to be born cannot be swept while it
      # has no root. The budget after a collection is twice what survived
      # it, floored at a MiB: a program whose live set is L pays one
      # collection per L bytes of garbage, which is the amortised O(1) every
      # tracing collector prices at, and a program that never crosses a MiB
      # never pays at all. The guard is against re-entry: nothing in mark or
      # sweep allocates from this heap (the queue is its own mapping), and
      # the flag is what keeps that a fact the trigger does not depend on.
      #
      # `auto = false` is the phase exercises' door: a test choreographing
      # colours across explicit collections cannot have a string
      # interpolation's allocation running one in the middle. It is the same
      # switch Boehm spells GC_disable, and a program that turns it off owns
      # its own memory until it turns it back on.
      MIN_BUDGET = 4194304_u64

      @@budget : UInt64 = 0_u64
      @@collecting : Bool = false
      @@auto : Bool = true

      # The next budget as a percentage of what survived - Go's GOGC,
      # with the same meaning: what the program may allocate before the
      # next collection, in hundredths of the live set. Go's default is
      # 100, a heap twice the live set at its peak; iyi's is 200, a heap
      # three times it, because its collections are concurrent and its
      # allocation path is where it pays - at 100, binary trees was 35 MB
      # resident to 30 for a fifth more wall time. A program sets it
      # once, the way it sets `workers`.
      @@growth : UInt64 = 200_u64

      def self.growth=(percent : UInt64) : Nil
        @@growth = percent
      end

      def self.growth : UInt64
        @@growth
      end

      # The survivors grown by the percentage, floored at MIN_BUDGET so a
      # small program pays nothing.
      def self.next_budget(survived : UInt64) : UInt64
        grown = survived.unsafe_div(100_u64) * @@growth
        grown < MIN_BUDGET ? MIN_BUDGET : grown
      end

      def self.auto=(value : Bool) : Nil
        @@auto = value
      end

      # Bytes allocated since the last collection: the centre's atomic
      # word, which every cache folds a slice into (`IyiHeap.take`).
      def self.allocated_since : UInt64
        IyiHeap.allocated_word.value.get
      end

      # A slice of one cache's allocation arrives; the collection it may
      # trigger is decided twice — here on the count as seen, and again
      # under the lock, because two threads can cross the budget in the
      # same instant and the second must not collect a heap the first just
      # swept.
      def self.pressure(size : UInt64) : Nil
        total = IyiHeap.allocated_word.value.add(size) + size
        return if @@collecting
        return unless @@auto
        return if total < budget
        collect_if_due
      end

      def self.collect_if_due : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          # Helper 0 takes a concurrent mark's second stop, and a stop
          # names registered threads only: a program that never started a
          # thread has a main thread with no line until here, and the
          # helper would have stopped nobody and swept beside it. Before
          # the lock, because registering takes it.
          decide_helpers
          if concurrent_possible?
            IyiThread.register_current
            IyiThread.install_handler
          end
        {% end %}
        IyiRuntimeLock.lock
        if allocated_since < budget || @@collecting
          IyiRuntimeLock.unlock
          return
        end
        @@collecting = true
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          start_helpers(@@helpers_wanted)
          close_sweep_round
          if concurrent_possible?
            # The mark starts stopped and goes beside the program if the
            # live set turns out past the bound: then this thread goes
            # back to its allocation and helper 0 finishes the collection
            # and clears `@@collecting`. Inside the bound the mark is
            # over already and this thread owns the rest.
            if start_concurrent
              IyiRuntimeLock.unlock
              return
            end
            @@collecting = false
            IyiRuntimeLock.unlock
            wake_sweep_round
            return
          end
        {% end %}
        collect_locked(false)
        @@collecting = false
        IyiRuntimeLock.unlock
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          wake_sweep_round
        {% end %}
      end

      # One collection: decide, reclaim, and set the next budget. Explicit
      # calls reset the pressure clock too — a collection is a collection,
      # whoever asked for it. The lock is taken before anything stops, so
      # no stopped thread holds it (thread.iyi says why that matters), and
      # released after every stopped thread has counted itself out.
      # The verb: a program that calls this wants its memory back now, so
      # the sweep is eager here — every arena, the large list — where the
      # trigger's collections leave the sweep to the allocator.
      def self.collect : Nil
        IyiRuntimeLock.lock
        # A collection already running beside the program is finished by
        # its helper; this one waits for it rather than racing it.
        while @@collecting
          IyiRuntimeLock.unlock
          spin_pause
          IyiRuntimeLock.lock
        end
        @@collecting = true
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          close_sweep_round
        {% end %}
        collect_locked(true)
        @@collecting = false
        IyiRuntimeLock.unlock
      end

      # Wait out a collection running beside the program, if one is. The
      # count below is of finished collections — a mark in flight has not
      # swept, so it is not one yet — and a program that reads the count
      # after churn wants the one it triggered included.
      def self.settle : Nil
        while @@collecting
          spin_pause
        end
      end

      # How many helpers a mark may use, decided once, at the first
      # collection: what the program set, or the core count's default.
      def self.decide_helpers : Nil
        return if @@helpers_decided
        @@helpers_decided = true
        @@helpers_wanted = default_helpers unless @@workers_set
      end

      def self.collect_locked(eager : Bool) : Nil
        decide_helpers
        # Debt left from the last epoch: an unswept arena wears the last
        # mark's colours, and a mark over them would call last cycle's
        # black this cycle's live — and, worse, never re-count it, so an
        # arena of live objects would read as empty to the scavenge. Paid
        # here, every arena behind the epoch and not a counted number of
        # them, and counted, because a pause that sweeps is the thing the
        # lazy sweep exists to end. Paid before the stop, arena by arena
        # under a claim, the lock released for the walk: the triggering
        # thread's time, as an allocation's sweep is, and no other
        # thread's. What a thread was inside a slice of is finished under
        # the stop, where no slice is in flight.
        while sweep_one_before_stop
          @@debt_paid_before_stop = @@debt_paid_before_stop + 1_u64
        end
        started = now_ns
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          others = IyiThread.stop_others
        {% end %}
        while sweep_one_held
          @@debt_paid_in_pause = @@debt_paid_in_pause + 1_u64
        end
        mark
        scavenge
        begin_sweep
        sweep_large
        while eager && sweep_one_held
        end
        IyiHeap.allocated_word.value.set(0_u64)
        # The next budget: twice what the mark found live (Go's GOGC=100),
        # floored at MIN_BUDGET so a small program pays nothing. The mark
        # knows the live bytes — it added each object's size as it
        # blackened it — which is what lets the sweep be lazy: the budget
        # no longer waits on a sweep to count.
        @@budget = next_budget(@@bytes_marked)
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          open_sweep_round
          IyiThread.resume_others(others)
        {% end %}
        pause = now_ns - started
        IyiHeap.unmap_released
        @@pause_last = pause
        @@pause_max = pause if pause > @@pause_max
        @@pause_total = @@pause_total + pause
      end

      def self.budget : UInt64
        budget = @@budget
        budget == 0 ? MIN_BUDGET : budget
      end

      {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
        # ── The mark beside the program — GC_DESIGN.md Stage 9 ──────────────
        #
        # Two stops instead of one. The first is the roots: every thread
        # stopped, the debt paid, the roots grayed onto the pool, the
        # marking flag raised, the helpers woken, and the program resumed
        # — while it runs, every pointer-bearing store it makes goes through
        # the write barrier the compiler emitted, which grays what the
        # store put where it put it (Dijkstra's insertion barrier), and
        # every object it allocates is born gray. The helpers drain the
        # pool beside it. When helper 0 finds the pool empty and every
        # worker idle, it takes the second stop: the roots again (a pointer
        # a thread loaded from the heap since the first stop may sit in a
        # register that no store ever wrote), every mutator's barrier
        # stack flushed, the remainder drained, the flag lowered, and the
        # epoch turned. Both stops are proportional to roots and to what
        # the program changed under the mark, never to the live set — the
        # live set is walked between them, by the helpers, while the
        # program runs.
        @@concurrent : Bool = false
        @@stw_first_ns : UInt64 = 0_u64

        # Concurrent needs a thread to finish on: at least one helper.
        # Whether a mark *uses* one is not decided here and not from an
        # estimate: every collection starts stopped and marks up to
        # STW_MARK_BOUND objects on the triggering thread, and a mark
        # that ends inside the bound was the whole mark - one stop, no
        # helper woken, tens of microseconds (churn's 122 collections are
        # all of them). One that does not is a large live set, and it
        # goes beside the program from there.
        #
        # The estimate is what this replaces. It was the last mark's live
        # bytes against PARALLEL_FROM, and it was wrong in both
        # directions: binary trees' second mark read sixteen bytes - the
        # stretch tree was gone - and marked a three-megabyte tree
        # stopped, a 2 ms pause in a table of tens of microseconds; and
        # churn's tiny live set read as tiny for a mark that had four
        # megabytes of fresh allocation to walk. What the program did
        # since the last mark is not in any estimate, and the bounded
        # mark does not need one: it measures.
        STW_MARK_BOUND = 1024_u64

        def self.concurrent_possible? : Bool
          {% if flag?(:linux) %}
            @@helpers_wanted > 0_u64
          {% else %}
            # darwin keeps the estimate, and the platform is the reason: a
            # stop there is `pthread_kill` and a pipe per thread, and on
            # CI's three-core runner it measures tens of microseconds at
            # best and milliseconds under load (`bench/thread_floor.sh`
            # prints both). A collection that starts stopped to find out
            # how much is live pays that toll every time, and churn's 122
            # collections paid it: 0.49 s against 0.075. Where a stop is
            # cheap the measurement is better than any estimate; where it
            # is not, the estimate is what there is.
            @@helpers_wanted > 0_u64 && (@@last_marked >= PARALLEL_FROM || @@collections == 0_u64)
          {% end %}
        end

        # The first stop, on the triggering thread, under the runtime lock.
        # The helpers are started before it: their first spawn is half a
        # millisecond, which is no part of a stop. Answers whether the
        # mark went beside the program; false means it finished inside
        # this stop and the caller owns the rest of the collection.
        def self.start_concurrent : Bool
          # The last epoch's debt — an unswept arena wears the last mark's
          # colours, which this mark cannot read — is paid here, under the
          # lock the allocator's own sweep takes, before the world stops:
          # the triggering thread's time, as an allocation's sweep is, and
          # no other thread's. It was the first stop's largest part (500 us
          # of sweeping against 20 us of roots), and it is what Stage 8's
          # sweep beside the program is for.
          while sweep_one_before_stop
            @@debt_paid_before_stop = @@debt_paid_before_stop + 1_u64
          end
          started = now_ns
          others = IyiThread.stop_others
          while sweep_one_held
            @@debt_paid_in_pause = @@debt_paid_in_pause + 1_u64
          end
          w = worker
          @@collector_worker = w
          IyiHeap.write64(w + W_LEN, 0_u64)
          IyiHeap.write64(w + W_BYTES, 0_u64)
          @@bytes_marked = 0_u64
          @@helper_black = 0_u64
          arena = IyiHeap.first_arena
          while arena != 0
            IyiHeap.arena_live_reset(arena)
            arena = IyiHeap.arena_next(arena)
          end
          IyiHeap.write64(pool + POOL_HEAD, 0_u64)
          IyiHeap.write64(pool + POOL_CURSOR, IyiHeap.read64(pool + POOL_REGION_BASE))
          # The roots, and then the mark up to the bound on this thread
          # with the world still stopped: no barrier is needed for it,
          # nothing is running.
          @@workers = 1_u64
          IyiHeap.write64(pool + POOL_ASKED, 0_u64)
          pool_word(POOL_MARK_PERMITS).value.set(0_u64)
          pool_word(POOL_FINISH).value.set(0_u64)
          pool_word(POOL_ACTIVE).value.set(0_u64)
          pool_word(POOL_HELPERS_DONE).value.set(0_u64)
          IyiRoots.each_root(->(base : UInt64) { shade(base) })
          flush_mutator(w)
          # The bound is Linux's: darwin's `concurrent_possible?` decided
          # from the estimate before it stopped anything, and a mark that
          # got here there is one it wants beside the program.
          bounded = {% if flag?(:linux) %}drain_bounded(w, STW_MARK_BOUND){% else %}false{% end %}
          if bounded
            # The whole live set, inside the bound: this stop is the
            # collection. The tail is `collect_locked`'s, and the caller
            # is told so.
            @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
            @@last_marked = @@bytes_marked
            @@workers = 0_u64
            pool_word(POOL_ACTIVE).value.set(0_u64)
            # The live counts this thread was holding into their arenas
            # before the scavenge reads them: `drain` flushes them where
            # it ends, and a bounded drain does not end there. An arena
            # whose only live objects sat in this page's pending count
            # read as empty and was unmapped under them.
            flush_live(w)
            finish_stopped(started, others)
            return false
          end
          # A large live set. Every helper there is, and the reason is the
          # opposite of the stop's: a mark inside a pause pays for waking
          # and for detecting its end on the critical path, so fifteen
          # helpers over a three-megabyte heap cost twice what three did;
          # beside the program the mark's length is what the mutator pays
          # for - in barrier work, in assists and in a budget it cannot
          # reset - and the cores are otherwise idle. Sized by the last
          # mark's live bytes here, binary trees ran a tenth slower than
          # with all of them.
          helpers = @@helpers
          @@workers = helpers + 1_u64
          IyiHeap.write64(pool + POOL_ASKED, helpers)
          pool_word(POOL_MARK_PERMITS).value.set(helpers)
          pool_word(POOL_FINISH).value.set(1_u64)
          # Every helper counts itself in when it starts draining; the
          # triggering thread is not a worker after this.
          pool_word(POOL_ACTIVE).value.set(0_u64)
          # What the bounded mark left on this thread's stack goes to the
          # pool: from here this thread is a mutator, and its stack is
          # only its barrier's.
          donate_all(w)
          @@concurrent = true
          LibIyiGCTable.__iyi_marking = 1_u8
          pool_word(POOL_GENERATION).value.add(1_u64)
          IyiThread.resume_others(others)
          @@stw_first_ns = now_ns - started
          # The wake after the release: threads woken inside the stop were
          # the stop's largest part under load, and a helper's first
          # microseconds are the futex's either way.
          wake_helpers
          true
        end

        # Every entry on this stack into the pool, in batches: a stack
        # this thread will not drain, whose objects are gray and have to
        # be somebody's.
        def self.donate_all(w : UInt64) : Nil
          stack = IyiHeap.read64(w + W_STACK)
          left = IyiHeap.read64(w + W_LEN)
          while left > 0_u64
            count = left < BATCH ? left : BATCH
            left = left - count
            publish(stack + left * 8_u64, count)
          end
          IyiHeap.write64(w + W_LEN, 0_u64)
        end

        # A collection whose mark ended inside the first stop: the tail of
        # `collect_locked`, with the threads released and the pause
        # recorded. The caller holds the lock and clears `@@collecting`.
        def self.finish_stopped(started : UInt64, others : Int64) : Nil
          scavenge
          begin_sweep
          sweep_large
          IyiHeap.allocated_word.value.set(0_u64)
          @@budget = next_budget(@@bytes_marked)
          open_sweep_round
          IyiThread.resume_others(others)
          pause = now_ns - started
          IyiHeap.unmap_released
          @@stw_first_ns = pause
          @@stop_second_ns = 0_u64
          @@pause_last = pause
          @@pause_max = pause if pause > @@pause_max
          @@pause_total = @@pause_total + pause
        end

        # The second stop, on helper 0, once every helper found nothing.
        # Answers the generation helper 0 waits past next.
        #
        # The stop rescans the roots and flushes every mutator's barrier
        # stack, and what that finds is not always small: a pointer a
        # thread loaded from a white object into a register is a whole
        # structure the marker never reached — 200 000 nodes of a chain,
        # 2 ms walked inside the stop, longer than the mark it was meant to
        # hide — and what the program published between the helpers
        # finding the pool empty and the stop can be as large (a batch
        # holding the old head of a million-item list, 5 ms). So the stop
        # scans what it found for FINISH_SCAN objects and no more: a
        # thread walking a list holds one white node whose children are
        # black, and that finishes in one; what does not finish is a
        # structure, and the stop resumes the program, marks beside it
        # once more, and stops again, up to FINISH_RETRIES times - Go's
        # mark termination makes the same check and the same retreat.
        # Only when the retries are spent is the rest drained inside the
        # stop, with the helpers.
        FINISH_RETRIES = 8_u64
        FINISH_SCAN = 256_u64

        def self.finish_concurrent : UInt64
          attempts = 0_u64
          retries_ns = 0_u64
          longest_retry = 0_u64
          while true
            IyiRuntimeLock.lock
            started = now_ns
            others = IyiThread.stop_others
            w = worker
            @@collector_worker = w
            IyiHeap.write64(w + W_LEN, 0_u64)
            @@workers = @@helpers
            page = @@worker_pages
            while page != 0
              if page != w
                flush_mutator(page)
                # What the assists blackened on this mutator: its bytes
                # into the collection's, its live counts into the arenas.
                flush_live(page)
                @@bytes_marked = @@bytes_marked + IyiHeap.read64(page + W_BYTES)
                IyiHeap.write64(page + W_BYTES, 0_u64)
              end
              page = IyiHeap.read64(page + W_NEXT)
            end
            IyiRoots.each_root_of_others(->(base : UInt64) { shade(base) })
            # What the roots found white is tried inside the stop first,
            # for a bounded number of objects: a thread walking a list
            # holds one white node at every stop, whose children are
            # black already, and that is a scan, not a retreat - thirty-two
            # such threads made every second stop eight. What does not
            # finish within the bound is a structure hanging off a
            # register, and that is the retreat's case.
            @@workers = 1_u64
            pool_word(POOL_ACTIVE).value.set(1_u64)
            unfinished = !drain_bounded(w, FINISH_SCAN)
            # The probe's live counts into their arenas before the
            # scavenge reads them: an arena whose only live objects sat in
            # this page's pending count read as empty and was unmapped
            # under them.
            flush_live(w)
            if attempts < FINISH_RETRIES && unfinished
              IyiThread.resume_others(others)
              IyiRuntimeLock.unlock
              retry = now_ns - started
              retries_ns = retries_ns + retry
              longest_retry = retry if retry > longest_retry
              remainder_round(w)
              attempts = attempts + 1_u64
              next
            end
            # The retreats are spent and work remains: with the helpers,
            # inside the stop, the one case the stop is not bounded.
            remainder_round(w) if unfinished
            @@bytes_marked = @@bytes_marked + IyiHeap.read64(w + W_BYTES)
            @@last_marked = @@bytes_marked
            LibIyiGCTable.__iyi_marking = 0_u8
            @@concurrent = false
            @@workers = 0_u64
            scavenge
            begin_sweep
            sweep_large
            # What the program allocated under the mark was born black and
            # not scanned, so it is not in the marked bytes; it survived
            # nothing, and those bytes are the first of the next budget's,
            # allocated after the survivors were measured. Counted as
            # survivors, a program allocating through every mark doubled
            # its heap each cycle (churn: 16 MB resident stopped, 70 MB
            # beside).
            born = 0_u64
            page = @@worker_pages
            while page != 0
              born = born + IyiHeap.read64(page + W_BORN)
              IyiHeap.write64(page + W_BORN, 0_u64)
              page = IyiHeap.read64(page + W_NEXT)
            end
            survived = @@bytes_marked
            IyiHeap.allocated_word.value.set(born)
            @@budget = next_budget(survived)
            # The round opened before the threads are released: a thread
            # that refilled first found no round and swept the arena it
            # wanted - the largest - itself, a millisecond on the
            # allocating thread the round exists to spare.
            open_sweep_round
            IyiThread.resume_others(others)
            pause = now_ns - started
            IyiHeap.unmap_released
            @@stop_second_ns = pause
            @@finish_retries = @@finish_retries + attempts
            # Every stop is the collection's pause: the longest of them is
            # the number a program feels, and the sum is what it paid.
            total = pause + @@stw_first_ns + retries_ns
            longest = pause > @@stw_first_ns ? pause : @@stw_first_ns
            longest = longest_retry if longest_retry > longest
            @@pause_last = longest
            @@pause_max = longest if longest > @@pause_max
            @@pause_total = @@pause_total + total
            @@concurrent_collections = @@concurrent_collections + 1_u64
            @@collecting = false
            IyiRuntimeLock.unlock
            wake_sweep_round
            # Helper 0 takes its own turn at the round before it parks.
            # The generation as it stands - turned for the remainder and
            # again for the round - is the one it waits past.
            return pool_word(POOL_GENERATION).value.get
          end
        end

        # The pool's remainder and helper 0's own stack, drained by helper
        # 0 and the helpers together — inside the stop or beside the
        # program, the caller's choice. Answers the generation it turned.
        def self.remainder_round(w : UInt64) : UInt64
          helpers = @@helpers
          @@workers = helpers
          # This helper is inside the finish and drains below without a
          # permit; every other may take one.
          IyiHeap.write64(pool + POOL_ASKED, helpers - 1_u64)
          pool_word(POOL_MARK_PERMITS).value.set(helpers - 1_u64)
          pool_word(POOL_FINISH).value.set(0_u64)
          pool_word(POOL_ACTIVE).value.set(0_u64)
          pool_word(POOL_HELPERS_DONE).value.set(0_u64)
          generation = pool_word(POOL_GENERATION).value.add(1_u64) + 1_u64
          wake_helpers
          drain(w)
          while pool_word(POOL_HELPERS_DONE).value.get < mark_takers
            spin_pause
          end
          generation
        end

        @@finish_retries : UInt64 = 0_u64

        # How many times a second stop found the pool full and retreated,
        # across every collection, for the exercises.
        def self.finish_retries : UInt64
          @@finish_retries
        end

        @@concurrent_collections : UInt64 = 0_u64

        # The last concurrent collection's two stops, for the exercises:
        # the roots stop on the triggering thread, and helper 0's finish.
        @@stop_second_ns : UInt64 = 0_u64

        def self.stop_first_ns : UInt64
          @@stw_first_ns
        end

        def self.stop_second_ns : UInt64
          @@stop_second_ns
        end

        # Whether a mark is running beside the program right now: the byte
        # the barrier checks, for an exercise that wants to act under one.
        def self.marking? : Bool
          LibIyiGCTable.__iyi_marking != 0_u8
        end

        # Collections that ran beside the program, for the exercises.
        def self.concurrent_collections : UInt64
          @@concurrent_collections
        end
      {% end %}

      # What the last sweep did. GC_DESIGN.md Stage 6 asks for statistics and
      # this is the honest subset: counted as the walk went rather than sampled
      # afterwards. Pause time and a cumulative allocation total want a clock
      # and a hook in the hot path, and neither is worth adding before there is
      # something that reads them.
      def self.swept : UInt64
        @@swept
      end

      def self.kept : UInt64
        @@kept
      end

      def self.bytes_freed : UInt64
        @@bytes_freed
      end

      def self.bytes_kept : UInt64
        @@bytes_kept
      end

      def self.collections : UInt64
        @@collections
      end

      def self.arenas_released : UInt64
        @@arenas_released
      end

      def self.pause_last_ns : UInt64
        @@pause_last
      end

      def self.pause_max_ns : UInt64
        @@pause_max
      end

      def self.pause_total_ns : UInt64
        @@pause_total
      end
    end
  {% elsif flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
    # iyi: The default heap on Linux is a bump pointer over `mmap` regions:
    # allocate, never free, which is the contract the libc path below already
    # has (`free` is not bound there for the same reason, and a program that
    # outlives its memory is what allocating without collecting asks for).
    # `MAP_ANONYMOUS` guarantees zero-fill, so `__crystal_malloc64`'s
    # documented clear comes from the mapping itself rather than a second pass
    # over the bytes: nothing is handed out twice, so nothing can be dirtier
    # than the kernel left it, and the atomic variant is therefore the same
    # memory on this path too. Each pointer carries its size in the eight
    # bytes under it, because `realloc` has no other way to know how much to
    # copy, and the eight bytes also keep every user pointer 8-aligned.
    #
    # One MiB a chunk, and an allocation bigger than that gets a chunk of its
    # own. The kernel rounds `length` up to a page, so the chunk size is not
    # rounded here.
    #
    # The cursor and what is left of the chunk are the allocator's whole
    # state, held as class variables on `IyiHeap` because the language has
    # nothing else to hold them in: `$` globals are refused outright, and a
    # `fun` body cannot reach `@@` state. Both are `UInt64` with literal
    # initializers, which codegen folds into the LLVM global's static zero
    # rather than a runtime init call, so what a plain global would have
    # meant is kept: both start at zero, which means "mmap on the first
    # allocation", not a value any startup code has to install. The
    # allocation entry points below must stay `fun`s because codegen calls
    # them by C name, so they forward one frame deep into class methods;
    # that frame is the price of the only state-carrying construct the
    # language offers.
    class IyiHeap
      @@cursor : UInt64 = 0_u64
      @@left : UInt64 = 0_u64

      def self.alloc(size : UInt64) : Void*
        bytes = size.to_i64
        remainder = bytes % 8
        bytes = bytes + (8 - remainder) if remainder > 0
        # Two words under the pointer: the size for `realloc` at P-16, and
        # at P-8 the object header word every mode leaves, whose high half
        # codegen fills with the type id.
        bytes = bytes + 16

        if @@left < bytes.to_u64
          chunk = 1048576_i64
          chunk = bytes if bytes > chunk
          @@cursor = __iyi_mmap(chunk.to_u64).address
          @@left = chunk.to_u64
        end

        block = Pointer(Void).new(@@cursor)
        @@cursor = @@cursor + bytes.to_u64
        @@left = @@left - bytes.to_u64
        block.as(Pointer(UInt64)).value = size
        block + 16_i64
      end

      # Allocate-and-copy rather than growth in place, because nothing frees
      # and the old size rides in the sixteen bytes under the pointer, which
      # is the only place that knows it.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        old_size = Pointer(UInt64).new(pointer.address - 16).value
        new_pointer = alloc(size)
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        new_pointer
      end
    end

    fun __iyi_mmap(length : UInt64) : Pointer(Void)
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22.
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(9_i64), "{rdi}"(0_i64), "{rsi}"(length), "{rdx}"(3_i64),
                        "{r10}"(34_i64), "{r8}"(-1_i64), "{r9}"(0_i64)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(222_i64), "{x0}"(0_i64), "{x1}"(length), "{x2}"(3_i64),
                       "{x3}"(34_i64), "{x4}"(-1_i64), "{x5}"(0_i64)
                     : "memory"
                     : "volatile")
      {% end %}
      # A failed raw syscall answers with -errno in the result register rather
      # than a flag: -4095..-1 is errno's whole range.
      if result < 0 && result >= -4095
        __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
        __iyi_exit(1)
      end
      Pointer(Void).new(result.to_u64)
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is libc's on the other paths, and here it is the one libc name
    # left that codegen itself reaches for: `pre_initialize_aggregate` and
    # `generic_array_malloc` lower to the LLVM `llvm.memset` intrinsic, which
    # LLVM expands inline only while the size is a constant it can see; with
    # a runtime size it emits a call to C `memset` anyway. A definition with
    # the same name and signature is the only thing that can intercept that,
    # so the name, the types and the return are libc's rather than ours. The
    # bulk goes eight bytes at a time because every cleared allocation
    # funnels through here; the byte loop carries only the tail, and the
    # pattern word is the byte tiled eight wide.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!
      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% elsif flag?(:darwin) %}
    # iyi: The allocator on macOS is libSystem's `malloc` and `realloc`, which
    # is the explicit choice rather than a fallback: Apple documents libSystem
    # as the platform's only supported interface, it ships with the machine,
    # and its allocator is the best one available here by any measure. No
    # collection at all, which is what `src/gc/none.cr` is: the entry points
    # below carry `malloc`/`realloc` and none of the parts 0.1.0 has nothing
    # to say to (threads, finalizers, statistics).
    #
    # The clear after `malloc` is the entry point's contract rather than a fix
    # for something seen: `GC.malloc` is documented as allocating *and clearing*,
    # libc's `malloc` does not clear, and `gc/none.cr` clears for exactly that
    # reason (crystal-lang/crystal#14678). Nothing here would notice it missing
    # today, because codegen clears what it routes through this name anyway
    # (`pre_initialize_aggregate` and `generic_array_malloc` both memset), so the
    # clear is a second pass over the same bytes. It stays because the name is
    # reachable from any `.iyi` file and a swapped allocator that quietly weakens
    # the contract is the failure this default is being watched for, in miniature.
    #
    # `malloc_atomic` is that call without the clear, which is what the atomic
    # variant means on both sides: `GC_malloc_atomic` does not clear either, so
    # this is the same memory the collector's build hands back. `free` is not
    # bound because nothing frees, and a program that outlives its memory is
    # what allocating without collecting asks for.
    lib LibC
      fun malloc(size : UInt64) : Void*
      fun realloc(pointer : Void*, size : UInt64) : Void*
      fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    # Every mode leaves the object header word under the pointer, for the
    # type id codegen stores in its high half.
    fun __crystal_malloc64(size : UInt64) : Void*
      pointer = LibC.malloc(size + 8_u64)
      LibC.memset(pointer, 0, size + 8_u64)
      pointer + 8_i64
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      LibC.malloc(size + 8_u64) + 8_i64
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      return __crystal_malloc64(size) if pointer.address == 0
      LibC.realloc(Pointer(Void).new(pointer.address - 8_u64), size + 8_u64) + 8_i64
    end
  {% elsif flag?(:win32) %}
    # iyi: The allocator on Windows is the Win32 process heap: `HeapAlloc` and
    # `HeapReAlloc` on `GetProcessHeap`'s handle, all kernel32, which is the
    # platform's own interface and ships with the machine. No CRT is involved,
    # because a C runtime is a person-installed choice rather than the
    # platform's contract. The names and signatures are the ones
    # `src/lib_c/x86_64-windows-msvc/c/heapapi.cr` carries for the compiler's
    # own runtime.
    #
    # `HEAP_ZERO_MEMORY` (0x8) gives `__crystal_malloc64` its documented clear
    # in the allocator itself rather than a second pass over the bytes, and the
    # atomic variant passes 0 because not clearing is exactly what atomic
    # means (`GC_malloc_atomic` does not clear either). `HeapReAlloc` keeps
    # the old contents and grows in place where it can, which is the same
    # contract libc's `realloc` has on the other paths; a null pointer cannot
    # be handed to it, so it routes to a plain `HeapAlloc`. `free` is not
    # bound because nothing frees, and a program that outlives its memory is
    # what allocating without collecting asks for. `-Dgc_iyi` does not reach
    # this branch, deliberately rather than unfinished: the size-class arena
    # allocator is POSIX-only in its stage. This target once printed memory
    # it was never given: the memset below strode eight elements per eight
    # bytes, trampling `HeapAlloc`'s packed neighbours and clearing at
    # one-eighth coverage. Fixed, and CI's twenty-run watch retired the
    # diagnosis after thirty-six clean builds; it is a gate now.
    # Same reason as the block above: an LLVM-emitted object names no library
    # for itself, so the three heap functions have to name theirs.
    @[Link("kernel32")]
    lib LibC
      fun GetProcessHeap : Void*
      fun HeapAlloc(heap : Void*, flags : UInt32, bytes : UInt64) : Void*
      fun HeapReAlloc(heap : Void*, flags : UInt32, memory : Void*, bytes : UInt64) : Void*
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    # Every mode leaves the object header word under the pointer, for the
    # type id codegen stores in its high half.
    fun __crystal_malloc64(size : UInt64) : Void*
      LibC.HeapAlloc(LibC.GetProcessHeap, 0x8_u32, size + 8_u64) + 8_i64
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      LibC.HeapAlloc(LibC.GetProcessHeap, 0_u32, size + 8_u64) + 8_i64
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      if pointer.address == 0
        LibC.HeapAlloc(LibC.GetProcessHeap, 0x8_u32, size + 8_u64) + 8_i64
      else
        LibC.HeapReAlloc(LibC.GetProcessHeap, 0_u32, Pointer(Void).new(pointer.address - 8_u64), size + 8_u64) + 8_i64
      end
    end

    # `memset` is defined locally rather than bound because the C runtime is
    # not this platform's interface, and codegen itself reaches for the name:
    # `pre_initialize_aggregate` and `generic_array_malloc` lower to the LLVM
    # `llvm.memset` intrinsic, which LLVM expands inline only while the size is
    # a constant it can see; with a runtime size it emits a call to C `memset`
    # anyway, and on win64 that call carries a 64-bit size_t. A definition
    # with the same name, types and return is the only thing that can intercept
    # it. The bulk goes eight bytes at a time; the byte loop carries the tail.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!
      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% elsif flag?(:wasm32) %}
    # iyi: The default heap on wasm32-wasi is a bump pointer over
    # `memory.grow` pages, the same arena shape as the Linux branch, and it
    # closes the dependency floor's last finding on this target (SPEC.md
    # III.9): `malloc` and `realloc` were the two undefined names in a wasm32
    # object that are not the platform's own imports, and they came from
    # wasi-libc, which is a libc a toolchain brings rather than an interface
    # the platform guarantees. The linear memory is the platform's allocator
    # here, so the arena grows it the same way the Linux branch mmaps.
    # Allocate, never free; `free` is bound nowhere on any path, and a
    # program that outlives its memory is what allocating without collecting
    # asks for.
    #
    # Reaching `memory.grow` needed one binding, written below rather than in
    # `src/intrinsics.cr` for two measured reasons. `LibIntrinsics` there
    # proves a plain `fun` whose external name is an `llvm.` name reaches a
    # real LLVM intrinsic (`llvm.debugtrap`, `llvm.memcpy` and
    # `llvm.x86.sse2.pause` all bind exactly that way), but this prelude
    # requires nothing outside `src/iyi/` ("0.1.0", item 3), so a binding in
    # compiler source would be unreachable from here. The signature is the
    # other finding, measured against this tree's LLVM with hand-written IR:
    # the intrinsic registers as `i32 (i32, i32)`, memory index then page
    # delta, and the one-argument form the earlier probe tried is an arity
    # error the verifier words as "Callsite was not defined with variable
    # arguments!", which that probe recorded as a `fun` being unable to bind
    # an LLVM intrinsic at all. It can, with both arguments. An
    # `@[Primitive]` is the rejected alternative: a compiler rebuild and a
    # declaration in `primitives.iyi`, a language-surface file, for what this
    # C-shaped binding reaches. `memory.size` is not bound because
    # `memory.grow` answers the only fact it carries: its result is the
    # previous size in pages, which is exactly where the grown region
    # starts. The index argument is 0 because a wasm32-wasi module has
    # exactly one linear memory and 0 names it; the backend turns it into
    # the instruction's memarg immediate, so it is not even a runtime
    # operand.
    lib LibWasmMem
      fun memory_grow = "llvm.wasm.memory.grow.i32"(memory_index : Int32, delta_pages : Int32) : Int32
    end

    # Pages are 64 KiB. A request larger than one page rounds up to the whole
    # pages it needs and gets a region of its own; `memory.grow` answers -1
    # when the engine refuses the growth, and a failure is answered rather
    # than wrapped, because read as a page count -1 would seat the cursor
    # 64 KiB below any memory the engine ever handed out, which is heap
    # corruption wearing a success, so it takes the same write-and-exit the
    # Linux branch's failed `mmap` takes. Every size rides in the eight bytes
    # under the pointer exactly as on Linux, because `realloc` has no other
    # way to know how much to copy, and the eight bytes keep every user
    # pointer 8-aligned; grow regions are page-aligned and the bump is always
    # a multiple of 8, so the header store stays aligned too. Fresh pages are
    # zeroed by the wasm spec itself, so `__crystal_malloc64`'s documented
    # clear comes from the engine rather than a second pass over the bytes,
    # the same standing Linux's `MAP_ANONYMOUS` zero-fill has there: nothing
    # is handed out twice, so nothing can be dirtier than the engine left it,
    # and the atomic variant is the same memory for the same reason. The
    # cursor and what is left of the region are `UInt64` class variables on
    # `IyiHeap` for the Linux branch's reasons, which hold here word for
    # word: `$` globals are refused, a `fun` body cannot reach `@@` state,
    # and literal initializers fold into the LLVM global's static zero, so
    # zero means "grow on the first allocation" rather than a value startup
    # code installs. `-Dgc_iyi` does not reach this branch either, by design
    # rather than omission: wasm32 has no mmap, and its arena is a watermark
    # over linear memory, a separate design that GC_DESIGN.md's Stage 2
    # defers, so the flag keeps this allocator.
    class IyiHeap
      @@cursor : UInt64 = 0_u64
      @@left : UInt64 = 0_u64

      def self.alloc(size : UInt64) : Void*
        bytes = size.to_i64
        remainder = bytes % 8
        bytes = bytes + (8 - remainder) if remainder > 0
        # Two words under the pointer: the size for `realloc` at P-16, and
        # at P-8 the object header word every mode leaves, whose high half
        # codegen fills with the type id.
        bytes = bytes + 16

        if @@left < bytes.to_u64
          pages = bytes // 65536
          pages = pages + 1 if bytes % 65536 > 0
          previous = LibWasmMem.memory_grow(0, pages.to_i32)
          if previous < 0
            __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
            __iyi_exit(1)
          end
          @@cursor = previous.to_u64.unsafe_shl(16)
          @@left = pages.to_u64.unsafe_shl(16)
        end

        block = Pointer(Void).new(@@cursor)
        @@cursor = @@cursor + bytes.to_u64
        @@left = @@left - bytes.to_u64
        block.as(Pointer(UInt64)).value = size
        block + 16_i64
      end

      # Allocate-and-copy rather than growth in place, because nothing frees
      # and the old size rides in the sixteen bytes under the pointer, which
      # is the only place that knows it.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        old_size = Pointer(UInt64).new(pointer.address - 16).value
        new_pointer = alloc(size)
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        new_pointer
      end
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is defined locally because codegen itself reaches for the name
    # (`pre_initialize_aggregate` and `generic_array_malloc` lower to the LLVM
    # `llvm.memset` intrinsic, which becomes a C `memset` call once the size is
    # not a constant), and wasm32's size_t is 32-bit, so the signature LLVM
    # expects here is `void(i8*, i32, i32)` rather than the 64-bit count the
    # Linux and win32 paths carry. A definition with the matching name, types
    # and return is the only thing that can intercept it. The bulk goes four
    # bytes at a time because the pointers are 4-aligned at best on wasm32;
    # the byte loop carries the tail.
    fun memset(destination : Void*, value : Int32, count : Int32) : Void*
      byte = value.to_u8!
      word = (byte.to_u64 * 0x01010101_u64).to_i32
      words = destination.as(Pointer(Int32))
      total = count.to_i64.to_u64
      filled = 0_u64
      while filled + 4_u64 <= total
        words.value = word
        words = words + 1_i64
        filled = filled + 4_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < total
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% else %}
    {% raise "iyi: this target has no allocator binding in iyi's prelude. " \
             "Teach src/iyi/prelude.iyi a branch for this platform rather than " \
             "linking something absent." %}
  {% end %}
{% end %}

{% if flag?(:arm) || flag?(:wasm32) %}
  # `__multi3` is compiler-rt's 128-bit multiply helper, and LLVM emits calls
  # to it behind the program's back: on a 32-bit target a checked 64-bit
  # multiply legalizes by widening to an `i128` multiply, and neither arm nor
  # wasm32 has that instruction, so the multiply becomes a call to `__multi3`.
  # This prelude has two such multiplies on the wasm32 path alone — `memset`'s
  # word pattern and `Int64#to_s`'s power-of-ten count — and measured, that
  # helper is the one compiler-rt name in the wasm32 object's undefined list.
  # The mirror of `src/crystal/compiler_rt.cr` is exact on the flag: it
  # requires `compiler_rt/multi3.cr` precisely when `flag?(:arm) ||
  # flag?(:wasm32)`, so the same gate is here, and nothing else from that
  # file is pulled in. `shift.cr` (`__ashlti3` and kin) and `pow.cr`
  # (`__powisf2`, `__powidf2`) are wasm32 needs of Int128 shifts and `**`,
  # and iyi's primitives cross Int32/Int64/UInt8/UInt64/Float64 only, so no
  # codegen path emits those calls; fixint, float, mul and divmod128 serve
  # the Int128 division and conversion surface, which the same five types
  # lower natively.
  #
  # Written out rather than required, although `src/crystal/compiler_rt/` is
  # Crystal and pulling it in costs no library: `multi3.cr` is written against
  # Crystal's full primitives — `~`, `to_i128!`, arithmetic on Int128 — which
  # this prelude's five-type surface does not carry, so the file does not
  # compile under it. The algorithm is compiler-rt's (multi3.c over mulddi3.c,
  # which Crystal's port carries); the expression of it is iyi's. The halves
  # are read out of the operands as UInt64 words through a pointer — wasm32
  # and the arm targets Crystal builds are little-endian, so word 0 is the low
  # half — because the language has no i128 arithmetic to split with. Every
  # operation below is the wrapping form, which is exactly the mod 2^64 the
  # algorithm is written in, and the signed result falls out of the two's
  # complement words with no case analysis, the same way compiler-rt's does.
  fun __multi3(a : Int128, b : Int128) : Int128
    x = a
    y = b
    x_words = pointerof(x).as(Pointer(UInt64))
    y_words = pointerof(y).as(Pointer(UInt64))
    a_low = x_words.value
    a_high = (x_words + 1_i64).value
    b_low = y_words.value
    b_high = (y_words + 1_i64).value

    # mask keeps the low 32 bits of a word.
    mask = 0xFFFFFFFF_u64

    # mulddi3: the unsigned 64x64 -> 128 product of the two low words, kept
    # as a (low, high) pair rather than packed into an Int128.
    low = (a_low & mask) &* (b_low & mask)
    t = low.unsafe_shr(32)
    low = low & mask
    t = t &+ ((a_low.unsafe_shr(32)) &* (b_low & mask))
    low = low &+ ((t & mask).unsafe_shl(32))
    high = t.unsafe_shr(32)
    t = low.unsafe_shr(32)
    low = low & mask
    t = t &+ ((b_low.unsafe_shr(32)) &* (a_low & mask))
    low = low &+ ((t & mask).unsafe_shl(32))
    high = high &+ t.unsafe_shr(32)
    high = high &+ ((a_low.unsafe_shr(32)) &* (b_low.unsafe_shr(32)))

    # multi3's own step: the high word adds the cross products, mod 2^64.
    high = high &+ (a_high &* b_low)
    high = high &+ (a_low &* b_high)

    result = uninitialized Int128
    result_words = pointerof(result).as(Pointer(UInt64))
    result_words.value = low
    (result_words + 1_i64).value = high
    result
  end
{% end %}

# Codegen emits a call to this on every overflowing operation, so a program
# cannot link without it. It aborts rather than raising: 0.1.0's `raise` is a
# panic (SPEC.md III.1.4) and there is no unwinder under it.
# Every function with an `ensure` names a personality function, so a program
# with a `defer` in it does not link without this symbol. It is not reachable:
# reaching it would mean something is unwinding, and nothing here unwinds.
fun __crystal_personality
  print "iyi: __crystal_personality called, which cannot happen\n"
  __iyi_exit(1)
end

# Reached from the same landing pad, for the same reason, and just as
# unreachable: `ensure` compiles a path that would ask the unwinder what was
# thrown, and nothing here throws.
fun __crystal_get_exception(exception : Void*) : UInt64
  print "iyi: __crystal_get_exception called, which cannot happen\n"
  __iyi_exit(1)
  0_u64
end

# Codegen emits a call to this wherever a `rescue` would re-raise. Nothing in
# this prelude can reach it either — `raise` panics rather than unwinding —
# but a program with an `ensure` in it names the symbol.
@[Raises]
fun __crystal_raise(exception : Void*) : NoReturn
  print "iyi: __crystal_raise called, which cannot happen\n"
  __iyi_exit(1)
end

# Codegen emits a call to this on every overflowing checked operation.
# It is a `fun` — the name is the ABI — but the body just steps into the
# ordinary panic def, so an overflow in a task dies at the task
# boundary like any other bug instead of taking the process (III.1.4).
fun __crystal_raise_overflow : NoReturn
  raise "arithmetic overflow"
end

struct Pointer(T)
  def [](offset : Int32) : T
    (self + offset.to_i64).value
  end

  def []=(offset : Int32, value : T) : T
    (self + offset.to_i64).value = value
  end

  # Bytes, not elements: every caller here is copying string contents.
  def copy_from(source : Pointer(T), count : Int32) : Nil
    index = 0
    while index < count
      self[index] = source[index]
      index = index + 1
    end
  end
end

# ── Panics — SPEC.md III.1.4, built ───────────────────────────────────
#
# A panic is for bugs, not control flow, and it unwinds without an
# unwinder: `defer` registers its cleanup on the way in (the normalizer
# emits `__iyi_defer_push`/`__iyi_defer_pop_run` around every deferred
# scope), so the panic path *walks a list* instead of walking frames —
# the whole Itanium machinery stays unlinked and the dependency floor
# stays where it is.
#
# On the concurrency targets the registry lives on the current fiber and
# a panicking task dies alone: its defers run, its group is told, its
# siblings are cancelled, and the group's join re-panics in the owner —
# a panicking fiber cannot die silently (III.1.4), and an uncaught panic
# still reaches main and exits 1, after every defer on the path ran.
# Elsewhere there are no tasks, so the registry is one global stack and
# a panic is a clean exit that ran the pending cleanups first.

# One registered cleanup. A class rather than a struct: the stack is an
# intrusive linked list, and a node must be a reference to link.
class IyiDeferNode
  @proc : Proc(Nil)
  property next_node : IyiDeferNode?

  def initialize(@proc : Proc(Nil))
    @next_node = nil
  end

  def run : Nil
    @proc.call
  end
end

{% unless (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
  # No fibers on this target, so one global stack is exact: a single
  # thread of control pushes and pops in strict block-nesting order.
  class IyiDefers
    @@head : IyiDeferNode?

    def self.push(node : IyiDeferNode) : Nil
      node.next_node = @@head
      @@head = node
    end

    def self.pop_run : Nil
      node = @@head
      return unless node.is_a?(IyiDeferNode)
      @@head = node.next_node
      node.run
    end

    def self.drain : Nil
      while true
        node = @@head
        return unless node.is_a?(IyiDeferNode)
        @@head = node.next_node
        node.run
      end
    end
  end

  def __iyi_defer_push(cleanup : Proc(Nil)) : Nil
    IyiDefers.push(IyiDeferNode.new(cleanup))
  end

  def __iyi_defer_pop_run : Nil
    IyiDefers.pop_run
  end
{% end %}

# `raise` is a panic. It prints once, at the point of the bug, then
# unwinds by registry: pending defers run innermost-first, and on the
# concurrency targets the current *task* dies rather than the process —
# the group boundary re-raises in the owner, which is where III.1.4
# says a panic is caught. `NoReturn` is a type-system fact `.or_panic`
# depends on (III.1.3): the fiber never resumes.
def raise(message : String) : NoReturn
  print "iyi: panic: "
  print message
  print "\n"
  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
    IyiScheduler.panic_current(message)
  {% else %}
    IyiDefers.drain
    __iyi_exit(1)
  {% end %}
end

# What a failed `.as` names. `.as` reaches an iyi program through one door
# only — `select`'s expansion casts the winning arm's value — and a failed
# cast there is a compiler bug, so this is a panic wearing the constant's
# name, not an exception type.
class TypeCastError
  @message : String

  def initialize(@message : String)
  end

  def message : String
    @message
  end
end

def raise(error : TypeCastError) : NoReturn
  raise error.message
end

def print(text : String) : Nil
  __iyi_write(1, text.to_unsafe.as(Void*), text.bytesize.to_u64)
end

def print(value) : Nil
  print value.to_s
end

def puts(text : String) : Nil
  print text
  print "\n"
end

# Everything on standard input, asked for by `samples/iyi/calc`: a program that
# only runs the source built into it is a demonstration, and one that reads is
# a tool.
#
# All of it rather than a line at a time, and that is the honest shape of what
# this prelude can do — `gets` in Crystal's library returns one line and keeps
# the rest in a buffered `IO`, and there is no `IO` here to keep it in. A name
# that means less than Crystal's would be worse than a different name, so this
# one is its own (SPEC.md III.1.7a is the same rule from the other side).
def read_input : String
  chunk = 8192_u64
  buffer = Pointer(UInt8).malloc(chunk)
  filled = 0_i64
  capacity = chunk

  while true
    if filled.to_u64 == capacity
      capacity = capacity * 2_u64
      buffer = buffer.realloc(capacity)
    end

    count = 0_i64
    # On the concurrency targets the read parks the fiber rather than the
    # thread: III.4.8 named this exact call as the one that had to stop
    # being a direct blocking syscall once a poller existed. A fiber
    # reading stdin no longer stalls its siblings; a program with no
    # other fiber blocks in `epoll_pwait` (`kevent` on darwin) instead of
    # `read`, which is the same wait. `Cancelled` ends the read the way
    # EOF does — a cancelled task wants out, and what was read so far is
    # still the honest answer.
    {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
      outcome = iyi_read(0, (buffer + filled).as(Void*), capacity - filled.to_u64)
      break unless outcome.is_a?(Int64)
      count = outcome
    {% else %}
      count = __iyi_read(0, (buffer + filled).as(Void*), capacity - filled.to_u64)
    {% end %}
    break if count <= 0_i64
    filled = filled + count
  end

  String.new(filled.to_i) do |target|
    target.copy_from(buffer, filled.to_i)
  end
end

def puts(value) : Nil
  puts value.to_s
end

# The program's own name-plate: arguments and environment, read on
# demand from what already exists — no captured state, no boot order to
# get wrong. `ARGC_UNSAFE`/`ARGV_UNSAFE` are the compiler's predefined
# constants, initialised from `main`'s own parameters before anything
# else runs (codegen/const.cr); `environ` is the C runtime's exported
# global. A first draft captured argv in class variables from `main` and
# read zeros: `__crystal_main` runs the class-variable initialisers
# *after* `main`'s prologue stored, wiping it — symbols do not have that
# ordering problem.
#
# On wasm32 there is no environment to read and `env` answers nil for
# every name: the sandbox story (SPEC.md III.12) is that the runtime
# hands the program nothing, and an absent surface beats a permission.
{% unless flag?(:wasm32) %}
  lib LibIyiEnv
    $environ : UInt8**
  end
{% end %}

class Program
  # The arguments after the program's own name, the way every shell
  # hands them over.
  def self.args : Array(String)
    result = [] of String
    index = 1
    while index < ARGC_UNSAFE
      result << string_from(ARGV_UNSAFE[index])
      index = index + 1
    end
    result
  end

  # One variable, or nil. No map of everything: the asking program names
  # what it wants, and a tool that dumps its whole environment into a
  # structure was one `puts` away from leaking it.
  def self.env(name : String) : String | Nil
    {% if flag?(:wasm32) %}
      nil
    {% else %}
      pointer = LibIyiEnv.environ
      return nil if pointer.address == 0_u64

      length = name.bytesize
      bytes = name.to_unsafe
      index = 0
      while (entry = pointer[index]).address != 0_u64
        offset = 0
        while offset < length && entry[offset] == bytes[offset]
          offset = offset + 1
        end
        # 61 is '=': the byte that ends the name in `NAME=value`.
        if offset == length && entry[length] == 61_u8
          return string_from(entry + (length + 1))
        end
        index = index + 1
      end
      nil
    {% end %}
  end

  private def self.string_from(entry : UInt8*) : String
    length = 0
    while entry[length] != 0_u8
      length = length + 1
    end
    String.new(length) do |target|
      target.copy_from(entry, length)
    end
  end
end

lib LibCrystalMain
  @[Raises]
  fun __crystal_main(argc : Int32, argv : UInt8**)
end

fun main(argc : Int32, argv : UInt8**) : Int32
  # There is nothing to start under the default allocator, and nothing missing
  # either: `gc/none.cr`'s `GC.init` sets up thread suspend and resume, and
  # 0.1.0 has one thread. Only Boehm has an `init` worth calling.
  {% if flag?(:gc_boehm) %}
    LibGC.init
  {% end %}
  LibCrystalMain.__crystal_main(argc, argv)
  0
end

{% if flag?(:wasm32) %}
  # iyi: wasi-libc's `crt1-command.o` is what exports `_start`, and what it
  # calls is not `main`. Clang renames a C `main` to `__main_argc_argv` or
  # `__main_void` depending on its parameters, and the entry stub calls that
  # name; `main` itself is left as a weak undefined reference, so a module that
  # only defines `main` links without complaint and traps on `unreachable` the
  # moment the entry calls through it.
  #
  # Defining the name the entry actually calls is the whole fix. It is declared
  # here rather than emitted by codegen because the prelude is where this
  # platform's contract already lives, and because `main` above stays exactly as
  # it is for every other target.
  fun __main_argc_argv(argc : Int32, argv : UInt8**) : Int32
    LibCrystalMain.__crystal_main(argc, argv)
    0
  end
{% end %}
