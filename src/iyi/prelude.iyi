# iyi's prelude — SPEC.md, "0.1.0", item 3.
#
#   ./bin/crystal build --prelude=iyi/prelude program.iyi
#
# Not a standard library. The prelude an iyi program gets is deliberately the
# smallest thing that runs the samples, because while an iyi program requires
# Crystal's 107,719-line prelude the benchmark measures a workaround rather
# than the thesis: the front end spends 886 ms of its 901 ms analysing it, and
# `.iyimod` saves 15 ms of the remainder (SPEC.md IV.1f).
#
# **What is in here is decided by what a sample calls.** A method enters
# because an existing program needs it, never because it belongs in a standard
# library. The ceiling is 3,734 lines — Crystal's own 0.1.0 core with its concurrency,
# measured in the same language family and for the same purpose.
#
# `primitives.iyi` under it is the list of machine operations iyi admits —
# arithmetic, conversions, comparisons and `Pointer`. It is iyi's own rather
# than Crystal's, and the reason is measured there.
require "./primitives"

require "./macros"
require "./object"
require "./number"
require "./string"
require "./array"
require "./range"
require "./hash"

# iyi: the concurrency runtime — a cooperative scheduler, cancellable
# blocking primitives, `group`/`spawn` and `Channel`, in exactly III.4.8's
# order. Required here rather than gated inside itself, because iyi-only
# syntax (`!`, `defer`, `impl`) does not survive a macro expansion's
# re-parse; the platforms that cannot carry the model are given nothing
# rather than a sequential imitation, which III.4.8 refused by name.
# darwin rides the aarch64 arm of the same runtime through libSystem —
# its own branch below says why libSystem — and the Linux pair keeps its
# raw syscalls.
{% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
  require "./concurrency"
{% end %}

{% if flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
  # iyi: On Linux, libc is not bound at all. The dependency floor (SPEC.md
  # III.9) named seven undefined symbols in a default program and five of them
  # were libc's; the kernel's syscall ABI is a stable contract, so `write` and
  # `exit` are one `syscall` instruction each rather than a PLT hop. Same move
  # Go makes with CGO_ENABLED=0. The numbers and register conventions are the
  # ones `src/syscall/x86_64-linux.cr` and `src/syscall/aarch64-linux.cr`
  # carry for the compiler's own runtime, written out here rather than
  # required because the prelude is iyi's own world ("0.1.0", item 3) and
  # requiring compiler source into a program would be a dependency of exactly
  # the kind this removes.
  #
  # `exit_group` rather than `exit`: the kernel's `exit` retires one thread,
  # `exit_group` retires the process. 0.1.0 has one thread, so the difference
  # is unobservable, and exit_group is what a program that grows threads
  # wants its panic path to mean.
  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(1_i64), "{rdi}"(fd.to_i64), "{rsi}"(buffer), "{rdx}"(count)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(64_i64), "{x0}"(fd.to_i64), "{x1}"(buffer), "{x2}"(count)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  # `read`, for `read_input` below. Syscall 0 on x86_64 and 63 on aarch64,
  # the same numbers `src/syscall/*-linux.cr` carries. Binding libc's `read`
  # here for one call would put the whole library back on the link line and
  # undo the floor III.9 measures.
  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(0_i64), "{rdi}"(fd.to_i64), "{rsi}"(buffer), "{rdx}"(count)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(63_i64), "{x0}"(fd.to_i64), "{x1}"(buffer), "{x2}"(count)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  # `openat`/`close` for `File`. Syscall 257/3 on x86_64, 56/57 on aarch64.
  # `AT_FDCWD` (-100) so a relative path does not need a directory fd.
  # The fourth syscall argument on x86_64 is `r10`, not `rcx`.
  def __iyi_open_read(path : UInt8*) : Int64
    __iyi_openat(path, 0, 0)
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # O_WRONLY|O_CREAT|O_TRUNC = 1|64|512, mode 0644.
    __iyi_openat(path, 577, 420)
  end

  def __iyi_openat(path : UInt8*, flags : Int32, mode : Int32) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(257_i64), "{rdi}"(-100_i64), "{rsi}"(path),
                      "{rdx}"(flags.to_i64), "{r10}"(mode.to_i64)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(56_i64), "{x0}"(-100_i64), "{x1}"(path),
                     "{x2}"(flags.to_i64), "{x3}"(mode.to_i64)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  def __iyi_close(fd : Int64) : Nil
    {% if flag?(:x86_64) %}
      asm("syscall" :: "{rax}"(3_i64), "{rdi}"(fd) : "rcx", "r11", "memory" : "volatile")
    {% else %}
      asm("svc #0" :: "{x8}"(57_i64), "{x0}"(fd) : "memory" : "volatile")
    {% end %}
  end

  # `unlinkat`, with AT_FDCWD and no flags. Syscall 263 on x86_64 and 35 on
  # aarch64.
  def __iyi_unlink(path : UInt8*) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(263_i64), "{rdi}"(-100_i64), "{rsi}"(path), "{rdx}"(0_i64)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(35_i64), "{x0}"(-100_i64), "{x1}"(path), "{x2}"(0_i64)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_read(fd.to_i32, buffer, count)
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    __iyi_write(fd.to_i32, buffer, count)
  end

  def __iyi_exit(status : Int32) : NoReturn
    {% if flag?(:x86_64) %}
      asm("syscall" :: "{rax}"(231_i64), "{rdi}"(status.to_i64) : "rcx", "r11", "memory" : "volatile")
    {% else %}
      asm("svc #0" :: "{x8}"(94_i64), "{x0}"(status.to_i64) : "memory" : "volatile")
    {% end %}
    while true
    end
  end
{% elsif flag?(:darwin) %}
  # iyi: macOS is not a fallback that happened to work; it is a chosen branch,
  # because it is the machine most developers sit in front of. Apple documents
  # libSystem as the only supported interface and raw syscalls as explicitly
  # not a stable ABI on Darwin, so binding `write` and `exit` here is Apple's
  # rule rather than a compromise this design settled for: libSystem ships
  # with the machine, it is not something a person installs, and Go links it
  # on darwin for the same reason (CGO_ENABLED=0 buys nothing there either).
  lib LibC
    fun write(fd : Int32, buf : Void*, count : UInt64) : Int64
    fun read(fd : Int32, buf : Void*, count : UInt64) : Int64
    fun open(path : UInt8*, oflag : Int32, ...) : Int32
    fun chmod(path : UInt8*, mode : Int32) : Int32
    fun close(fd : Int32) : Int32
    fun unlink(path : UInt8*) : Int32
    fun exit(status : Int32) : NoReturn
  end

  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    LibC.write(fd, buffer, count)
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    LibC.read(fd, buffer, count)
  end

  def __iyi_open_read(path : UInt8*) : Int64
    LibC.open(path, 0).to_i64
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # O_WRONLY|O_CREAT|O_TRUNC = 1|0x0200|0x0400. `open` is variadic for the
    # mode, and `chmod` sets 0644 afterwards because a missing mode on create
    # has produced an unreadable file (execute-only) on this machine.
    fd = LibC.open(path, 1537, 420).to_i64
    LibC.chmod(path, 420) if fd >= 0
    fd
  end

  def __iyi_close(fd : Int64) : Nil
    LibC.close(fd.to_i32)
  end

  def __iyi_unlink(path : UInt8*) : Int64
    LibC.unlink(path).to_i64
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.read(fd.to_i32, buffer, count)
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    LibC.write(fd.to_i32, buffer, count)
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibC.exit(status)
  end
{% elsif flag?(:win32) %}
  # iyi: On Windows the platform's own interface is the Win32 API in
  # kernel32, which ships with the machine; Go links kernel32 for the same
  # set of operations. There is no libc `write` to fall back to: the C
  # runtime's POSIX shims are a person-installed choice of CRT, not the
  # platform's contract, so stdout is `WriteFile` on the standard handle and
  # exit is `ExitProcess`. The names and signatures are the ones
  # `src/lib_c/x86_64-windows-msvc/c/` carries for the compiler's own
  # runtime, declared locally rather than required for the same reason as the
  # Linux syscalls above: the prelude is iyi's own world.
  # iyi primitives carry arithmetic on Int32/Int64/UInt8/UInt64 only, so the
  # DWORD-width parameters are declared Int32: same 32 bits at the ABI, and
  # no UInt32 value ever exists in this file to convert.
  #
  # The link is named here because an object LLVM emits carries no
  # `/DEFAULTLIB` directives, which an MSVC-compiled one would: without this,
  # `--cross-compile` prints a command that cannot link what it just produced,
  # and every one of these six functions comes back as an unresolved external.
  #
  # `msvcrt`, `ucrt` and `vcruntime` are the *dynamic* CRT, and they are here
  # for one symbol: this program's entry point is `main`, so something has to
  # supply `mainCRTStartup` to call it. The static CRT (`libcmt`) links just as
  # cleanly and the binary then exits `0xC0000005` before `main` runs, which is
  # why the choice is written down rather than left to whoever links. Emitting
  # an entry point of iyi's own would remove all three, and would be the honest
  # form of "kernel32 and nothing else".
  @[Link("kernel32")]
  @[Link(ldflags: "msvcrt.lib ucrt.lib vcruntime.lib")]
  lib LibC
    fun GetStdHandle(n_std_handle : Int32) : Void*
    fun WriteFile(handle : Void*, buffer : Void*, number_of_bytes_to_write : Int32,
                  number_of_bytes_written : Int32*, overlapped : Void*) : Int32
    fun ReadFile(handle : Void*, buffer : Void*, number_of_bytes_to_read : Int32,
                 number_of_bytes_read : Int32*, overlapped : Void*) : Int32
    fun CreateFileA(name : UInt8*, access : Int32, share : Int32, security : Void*,
                    disposition : Int32, flags : Int32, template : Void*) : Void*
    fun DeleteFileA(name : UInt8*) : Int32
    fun CloseHandle(handle : Void*) : Int32
    fun ExitProcess(exit_code : Int32) : NoReturn
  end

  # GetStdHandle's constants, by their Win32 names: STD_INPUT_HANDLE (-10),
  # STD_OUTPUT_HANDLE (-11), STD_ERROR_HANDLE (-12). They are negative
  # identifiers reinterpreted as DWORD; as Int32 they spell themselves.
  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    std_handle = -11
    std_handle = -12 if fd == 2
    std_handle = -10 if fd == 0
    written = uninitialized Int32
    if LibC.WriteFile(LibC.GetStdHandle(std_handle), buffer,
         count.to_i32, pointerof(written), nil) == 0
      return -1_i64
    end
    written.to_i64
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    std_handle = -10
    read = uninitialized Int32
    if LibC.ReadFile(LibC.GetStdHandle(std_handle), buffer,
         count.to_i32, pointerof(read), nil) == 0
      return 0_i64
    end
    read.to_i64
  end

  # HANDLE is pointer-sized; File carries it as Int64. INVALID_HANDLE_VALUE
  # is all bits set, which as an unsigned address plus one wraps to zero.
  def __iyi_open_read(path : UInt8*) : Int64
    # GENERIC_READ, FILE_SHARE_READ, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL.
    handle = LibC.CreateFileA(path, -2147483648, 1, nil, 3, 128, Pointer(Void).new(0_u64))
    return -1_i64 if handle.address &+ 1_u64 == 0_u64
    handle.address.to_i64
  end

  def __iyi_open_write(path : UInt8*) : Int64
    # GENERIC_WRITE, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL.
    handle = LibC.CreateFileA(path, 1073741824, 0, nil, 2, 128, Pointer(Void).new(0_u64))
    return -1_i64 if handle.address &+ 1_u64 == 0_u64
    handle.address.to_i64
  end

  def __iyi_close(fd : Int64) : Nil
    LibC.CloseHandle(Pointer(Void).new(fd.to_u64))
  end

  def __iyi_unlink(path : UInt8*) : Int64
    return 0_i64 if LibC.DeleteFileA(path) != 0
    -1_i64
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    read = uninitialized Int32
    if LibC.ReadFile(Pointer(Void).new(fd.to_u64), buffer,
         count.to_i32, pointerof(read), nil) == 0
      return 0_i64
    end
    read.to_i64
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    written = uninitialized Int32
    if LibC.WriteFile(Pointer(Void).new(fd.to_u64), buffer,
         count.to_i32, pointerof(written), nil) == 0
      return -1_i64
    end
    written.to_i64
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibC.ExitProcess(status)
  end
{% elsif flag?(:wasm32) %}
  # iyi: On wasm32-wasi the platform's own interface is the WASI import set,
  # which the runtime (wasmtime, wasmer, a browser shim) provides; that is
  # the same standing libSystem and kernel32 have on the other platforms, and
  # the reason the imports are bound by their `__wasi_` names rather than
  # through wasi-libc's POSIX shims. `fd_write` takes an iovec, so one call
  # covers the whole buffer; `proc_exit` is NoReturn the same way `exit`
  # elsewhere is. The declarations mirror `src/crystal/system/wasi/lib_wasi.cr`,
  # which binds `proc_exit` this way too.
  # WASI's own types are fd/size/errno as u32; iyi's primitives carry
  # arithmetic on Int32/Int64/UInt8/UInt64 only, so the u32-width parameters
  # are declared Int32, which is the same 32 bits at the ABI, and no UInt32
  # value ever exists in this file to convert.
  lib LibWasi
    struct Ciovec
      buf : UInt8*
      buf_len : Int32
    end

    fun fd_write = __wasi_fd_write(fd : Int32, iovs : Ciovec*,
                                   iovs_len : Int32, nwritten : Int32*) : Int32
    fun fd_read = __wasi_fd_read(fd : Int32, iovs : Ciovec*,
                                 iovs_len : Int32, nread : Int32*) : Int32
    fun proc_exit = __wasi_proc_exit(code : Int32) : NoReturn
  end

  def __iyi_write(fd : Int32, buffer : Void*, count : UInt64) : Int64
    iov = LibWasi::Ciovec.new(buf: buffer.as(UInt8*), buf_len: count.to_i32)
    written = uninitialized Int32
    if LibWasi.fd_write(fd, pointerof(iov), 1, pointerof(written)) != 0
      return -1_i64
    end
    written.to_i64
  end

  def __iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64
    iov = LibWasi::Ciovec.new(buf: buffer.as(UInt8*), buf_len: count.to_i32)
    read = uninitialized Int32
    if LibWasi.fd_read(fd, pointerof(iov), 1, pointerof(read)) != 0
      return 0_i64
    end
    read.to_i64
  end

  # WASI's `path_open` takes a preopened directory fd, a rights bitfield and
  # a path. This prelude has none of those, and pretending a relative path
  # opens would be a silent wrong answer. File methods raise through these.
  def __iyi_open_read(path : UInt8*) : Int64
    raise "File is not available on wasm32-wasi: path_open needs a preopened directory fd"
  end

  def __iyi_open_write(path : UInt8*) : Int64
    raise "File is not available on wasm32-wasi: path_open needs a preopened directory fd"
  end

  def __iyi_close(fd : Int64) : Nil
  end

  # Like path_open, path_unlink_file needs a preopened directory fd and a path
  # relative to it. This prelude has no directory capability to pass.
  def __iyi_unlink(path : UInt8*) : Int64
    raise "File.delete is not available on wasm32-wasi: path_unlink_file needs a preopened directory fd"
  end

  def __iyi_file_read(fd : Int64, buffer : Void*, count : UInt64) : Int64
    0_i64
  end

  def __iyi_file_write(fd : Int64, buffer : Void*, count : UInt64) : Int64
    -1_i64
  end

  def __iyi_exit(status : Int32) : NoReturn
    LibWasi.proc_exit(status)
  end
{% else %}
  {% raise "iyi: this target is not one iyi's prelude has platform bindings for. " \
           "iyi supports Linux (x86_64, aarch64) via raw syscalls, macOS via " \
           "libSystem, Windows via the Win32 API and wasm32-wasi via the WASI " \
           "imports. Teach src/iyi/prelude.iyi a branch for this platform rather " \
           "than linking something absent." %}
{% end %}

require "./file"

# The allocator, selected rather than declared, because the selection has to be
# a real seam a different allocator is swapped in at. Boehm was the default and
# `-Dgc_none`, a flag this compiler already answers to (`src/gc.cr` reads it to
# require `gc/none` instead of `gc/boehm`), only opted out of it: a prelude
# that bound `GC_malloc` conditionally accepted the flag, linked the collector
# anyway and said nothing about it, and a flag that is accepted and ignored is
# worse than one that is refused. The dependency floor then measured the
# collector as the last library a default `iyi build` could not refuse (SPEC.md
# III.9), so the default is inverted: a plain build allocates and never
# collects, which is the exact contract `-Dgc_none` already had, and
# `-Dgc_boehm` restores the twelve lines of binding below along with the
# collection they buy. `-Dgc_none` still selects the default, so nothing that
# passes it changes meaning. A real collector is not dropped by this, it is
# III.9's open item: adopt one and pay it back in layouts (SPEC.md B.1, table
# row 20).
#
# Written out in full rather than put behind a `GC` module the way the standard
# library has it. There are four call sites and all of them are in this file,
# so the module would buy nothing but a frame on every allocation of a build
# that is not optimised.
{% if flag?(:gc_boehm) %}
  # `pkg_config: "bdw-gc"` is how Crystal's own `gc/boehm.cr` names the
  # library, and it is what lets a homebrew-installed collector link on
  # darwin, where `-lgc` alone has no search path that finds it.
  @[Link("gc", pkg_config: "bdw-gc")]
  lib LibGC
    fun init = GC_init
    fun malloc = GC_malloc(size : UInt64) : Void*
    fun malloc_atomic = GC_malloc_atomic(size : UInt64) : Void*
    fun realloc = GC_realloc(pointer : Void*, size : UInt64) : Void*
  end

  # Codegen emits calls to these by name for every allocation, so they are not
  # optional and their names are not ours to choose.
  fun __crystal_malloc64(size : UInt64) : Void*
    LibGC.malloc(size)
  end

  fun __crystal_malloc_atomic64(size : UInt64) : Void*
    LibGC.malloc_atomic(size)
  end

  fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
    LibGC.realloc(pointer, size)
  end
{% else %}
  {% if flag?(:gc_iyi) && ((flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || flag?(:darwin)) %}
    # iyi: `-Dgc_iyi` selects the size-class arena allocator of GC_DESIGN.md's
    # Stage 2, the heap the collector's later stages grow from. It is opt-in:
    # the default on every target stays the allocator below, and moving the
    # default is a separate decision backed by measurement, not a thing to
    # slip in beside the allocator itself. The flag names the collector it
    # belongs to, but nothing here marks, scans or collects: this stage is
    # allocation, explicit free and realloc. An object comes back only when a
    # caller passes it to `IyiHeap.free`, which exists now precisely so it can
    # be called explicitly and tested; Stage 6's sweep is the caller it is
    # waiting for.
    #
    # The flag reaches POSIX and stops there, which is deliberate rather than
    # unfinished. Linux binds it over raw syscalls and darwin over libSystem,
    # the two interfaces this file already calls the platform's own. win32 and
    # wasm32 keep the allocators they have under the flag: win32's diagnosis
    # for printing memory it was never given now has a fixed suspect — the
    # memset stride defect recorded at that definition below — and the watch
    # in CI is what retires it, not a new allocator landing in the same
    # change; wasm32 has no mmap, and its watermark arena is a separate
    # design.
    #
    # Requests are rounded to size classes: 16, 32, 64 and doubling to 1 MiB,
    # seventeen classes. A small fixed set is what keeps allocation and free
    # O(1) list operations, and pure doubling is what keeps the per-class
    # table to one page; the waste against the request is under half in the
    # worst case, the standing trade for never splitting or coalescing. The
    # class is the payload: a chunk is the class plus the twenty-four bytes
    # under the user pointer, and every user pointer stays 8-aligned. A
    # request over 1 MiB is large and gets a mapping of its own.
    #
    # Those twenty-four bytes are the object header, and GC_DESIGN.md's Stage
    # 5 is where they became real. With `P` the pointer the program holds:
    #
    #     P-24   size       u64   the requested size, `realloc`'s contract
    #     P-16   type_id    u32   index into the program's layout table
    #     P-12   pad        u32
    #     P-8    mark_word  u64   colour, flags, reserved; zero is white
    #     P      user data
    #
    # The eight-byte size is Stage 2's, moved down rather than changed: it is
    # still the only place that knows how much to copy when `realloc` crosses
    # a class, and it is still read from under the pointer. The sixteen bytes
    # above it are `Iyi::Collector::ObjectHeader` laid out exactly as
    # `src/compiler/iyi/object_header.cr` defines it, because the compiler
    # emits the type id into that word and this file reads it back.
    #
    # `malloc` cannot write the type id: it is handed a size and nothing
    # else. Codegen writes it at the allocation site, right after the call
    # returns, for every object allocated as an instance of a type. Every
    # other allocation — a `Pointer(T).malloc` buffer, a closure's
    # environment — keeps the zero the allocator leaves there, and zero is
    # the sentinel for "no layout": the mark loop word-scans such an object
    # conservatively instead of trusting a map it does not have. Zero is safe
    # to spend that way because the compiler's numbering gives it to `Nil`
    # alone, which is never allocated and never has a layout.
    #
    # One arena is one contiguous 16 MiB mmap region holding chunks of a
    # single class. Sixteen rather than thirty-two because address space is
    # the cheap half of a mapping (pages commit when touched, on Linux and
    # darwin alike) and a small program pays one arena per class it uses. The
    # first 64 bytes of an arena are its header: the next arena in the heap's
    # list, the mapped length, the chunk size, and the fill cursor with the
    # count of chunks never handed out. Everything that varies per class
    # lives in the directory, one mapped page holding seventeen free-list
    # heads and seventeen fill-arena pointers: the language has no array
    # class variable, so seventeen scalars would mean a seventeen-way branch
    # on every allocation, and one zeroed page is the whole table.
    #
    # Allocation pops the class's free list; with the list empty it carves
    # the next fresh chunk from the class's fill arena, and with the arena
    # spent it maps another and links it in. Free reads the class back out of
    # the size the header carries and pushes the chunk onto that class's
    # list. Neither walks the arena list: the list exists to be
    # traversed, not to serve the hot path.
    #
    # The clearing contract is the stage's correctness point, because reuse
    # is what is new here. `__crystal_malloc64` is documented to allocate
    # *and clear*, and until now the clear was free: every byte any path
    # handed out came from a fresh mapping, zero-filled by the kernel, and
    # nothing was handed out twice. A free list hands memory back out, so a
    # reused chunk is dirty, and a dirty chunk returned as cleared is the
    # exact shape of the defect that has a win32 binary printing memory it
    # was never given. A chunk popped from a free list is therefore cleared
    # before it is returned; a chunk carved fresh from an arena is not,
    # because the kernel already zeroed it and no second pass is owed. What
    # is cleared is the whole class payload, not the requested size: the
    # class rounds up, and the bytes past the request go to the caller with
    # the chunk, reachable through the size header the next time a realloc
    # grows into them. Zeroed slack keeps a reused chunk indistinguishable
    # from a fresh mapping, the invariant every path in this file provided
    # for free until now. `__crystal_malloc_atomic64` does not clear,
    # matching `GC_malloc_atomic`: atomic means the collector never scans
    # those bytes, so their initial value is no one's contract, and a reused
    # chunk may come back dirty on that path on purpose.
    #
    # The header's own two words are the exception, and they are cleared on
    # every reuse whichever path asked. They are not the caller's bytes, they
    # are the collector's: a stale type id names the layout of whoever held
    # the chunk last, which is a map read over an object that does not have
    # that shape, and a stale mark word hands out an object that is already
    # black and will never be scanned again. Both are false negatives, which
    # is the one class of error this collector cannot tolerate, so the clear
    # is unconditional there.
    #
    # `realloc` keeps the size-header contract: within one class, growing or
    # shrinking, it returns the same chunk with the header rewritten; across
    # classes it allocates, copies the smaller of the two requested sizes,
    # and frees the old chunk. A null pointer still means allocate, through
    # the clearing path, which is what `GC_realloc`'s null means.
    #
    # Large objects, over the top class, get one mmap region each and a node
    # on a separate list: the list's next pointer and the mapped length in
    # the sixteen bytes under the object header, so the forty bytes below a
    # large object's user pointer are next, mapped, then the same
    # size/type_id/mark_word header a class chunk carries. `realloc` and
    # `free` therefore read one layout for both.
    # Free unlinks the node and releases the mapping with `munmap`, checked
    # the way `__iyi_mmap` is checked, because a release that failed quietly
    # would leak the mapping with the node that named it already gone.
    #
    # Addressability is a question Stage 3's root scanning asks of every
    # word, and it is a requirement now: `IyiHeap.containing(pointer)` walks
    # the arena list and answers the containing arena's header address, or 0
    # for a pointer in no arena, and the header's chunk field then names the
    # size class. `IyiHeap.containing_large(pointer)` asks the same of the
    # large-object list. A large object answers 0 from `containing`, because
    # it is in no arena and the answer must never be a wrong arena; 0 from
    # both is how a pointer that is not the heap's is reported. The walk is
    # linear in arenas of 16 MiB each, so it is short; a page directory is
    # Stage 3's optimization if profiles say so, not a Stage 2 requirement.
    # Traversability is the same shape: `first_arena` and `arena_next`
    # enumerate the arenas for Stage 6's sweep, `first_large` and
    # `large_next` the large objects, and a list nothing can enumerate would
    # fail the next stage.
    #
    # The state is three class variables with literal zero initializers plus
    # the directory page, under the bump branch's rule: `$` globals are
    # refused, a `fun` body cannot reach `@@` state, and literal initializers
    # fold into the LLVM global's static zero, so zero means "not yet mapped"
    # rather than a value startup installs. The entry points below stay
    # `fun`s forwarding one frame into the class, the price of the only
    # state-carrying construct the language offers.
    {% if flag?(:darwin) %}
      # `mmap` and `munmap` are libSystem's here, the same standing `write`
      # has at the top of this file: Apple documents libSystem as the
      # platform's interface and raw syscalls as not a stable ABI.
      # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x1002 on
      # darwin, and a failed `mmap` answers MAP_FAILED rather than -errno.
      lib LibC
        fun mmap(addr : Void*, len : UInt64, prot : Int32, flags : Int32, fd : Int32, offset : Int64) : Void*
        fun munmap(address : Void*, length : UInt64) : Int32
      end

      fun __iyi_mmap(length : UInt64) : Pointer(Void)
        result = LibC.mmap(Pointer(Void).new(0_u64), length, 3, 0x1002, -1, 0_i64)
        if result.address == 0xFFFFFFFFFFFFFFFF_u64
          __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
        result
      end

      fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
        if LibC.munmap(Pointer(Void).new(address), length) != 0
          __iyi_write(1, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
      end
    {% else %}
      # `mmap` the way the bump branch binds it, a raw syscall with the
      # numbers `src/syscall/x86_64-linux.cr` and `aarch64-linux.cr` carry.
      # `munmap` joins it here because large objects are released in this
      # stage: syscall 11 on x86_64 and 215 on aarch64, checked rather than
      # assumed for `__iyi_mmap`'s reason, a failure answered with -errno in
      # the result register rather than a flag.
      fun __iyi_mmap(length : UInt64) : Pointer(Void)
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22.
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(9_i64), "{rdi}"(0_i64), "{rsi}"(length), "{rdx}"(3_i64),
                          "{r10}"(34_i64), "{r8}"(-1_i64), "{r9}"(0_i64)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(222_i64), "{x0}"(0_i64), "{x1}"(length), "{x2}"(3_i64),
                         "{x3}"(34_i64), "{x4}"(-1_i64), "{x5}"(0_i64)
                       : "memory"
                       : "volatile")
        {% end %}
        # A failed raw syscall answers with -errno in the result register
        # rather than a flag: -4095..-1 is errno's whole range.
        if result < 0 && result >= -4095
          __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
        Pointer(Void).new(result.to_u64)
      end

      fun __iyi_munmap(address : UInt64, length : UInt64) : Nil
        result = uninitialized Int64
        {% if flag?(:x86_64) %}
          asm("syscall" : "={rax}"(result)
                        : "{rax}"(11_i64), "{rdi}"(address), "{rsi}"(length)
                        : "rcx", "r11", "memory"
                        : "volatile")
        {% else %}
          asm("svc #0" : "={x0}"(result)
                       : "{x8}"(215_i64), "{x0}"(address), "{x1}"(length)
                       : "memory"
                       : "volatile")
        {% end %}
        if result < 0 && result >= -4095
          __iyi_write(1, "iyi: munmap failed\n".to_unsafe.as(Void*), 19_u64)
          __iyi_exit(1)
        end
      end
    {% end %}

    class IyiHeap
      MAP = 16777216_u64
      TOP = 1048576_u64
      HEAD = 64_u64
      DIR_LEN = 4096_u64
      FILL = 17

      # The object header, named once. `HEADER` is what sits between a chunk's
      # head and the pointer the program holds: the eight-byte size plus the
      # sixteen-byte `ObjectHeader`. `OFF_TYPE` and `OFF_MARK` are the type id
      # and the mark word, as offsets from the chunk head, which is the same
      # thing as P-16 and P-8 read from the other end. `LARGE_USER` is the
      # distance from a large object's node to its user pointer: the node's
      # next and mapped words, then the same header.
      HEADER = 24_u64
      OFF_SIZE = 0_u64
      OFF_TYPE = 8_u64
      OFF_MARK = 16_u64
      LARGE_USER = 40_u64

      OFF_NEXT = 0_u64
      OFF_MAP = 8_u64
      OFF_CHUNK = 16_u64
      OFF_CURSOR = 24_u64
      OFF_LEFT = 32_u64

      @@directory : UInt64 = 0_u64
      @@arenas : UInt64 = 0_u64
      @@large : UInt64 = 0_u64

      def self.read64(address : UInt64) : UInt64
        Pointer(UInt64).new(address).value
      end

      def self.write64(address : UInt64, value : UInt64) : Nil
        Pointer(UInt64).new(address).value = value
      end

      def self.directory : Pointer(UInt64)
        if @@directory == 0
          @@directory = __iyi_mmap(DIR_LEN).address
        end
        Pointer(UInt64).new(@@directory)
      end

      def self.class_index(size : UInt64) : Int32
        index = 0
        capacity = 16_u64
        while capacity < size
          capacity = capacity + capacity
          index = index + 1
        end
        index
      end

      def self.payload(index : Int32) : UInt64
        16_u64.unsafe_shl(index)
      end

      def self.class_for(size : UInt64) : UInt64
        payload(class_index(size))
      end

      def self.alloc(size : UInt64) : Void*
        Pointer(Void).new(take(size, true) + HEADER)
      end

      def self.alloc_atomic(size : UInt64) : Void*
        Pointer(Void).new(take(size, false) + HEADER)
      end

      def self.take(size : UInt64, clear : Bool) : UInt64
        return take_large(size) if size > TOP
        index = class_index(size)
        table = directory
        head = table[index]
        if head != 0
          table[index] = read64(head)
          # The type id and the mark word go first, on both paths: they are
          # the collector's words rather than the caller's, and a stale one
          # is a live object the mark loop misses.
          write64(head + OFF_TYPE, 0_u64)
          write64(head + OFF_MARK, 0_u64)
          clear_block(head + HEADER, payload(index)) if clear
          write64(head + OFF_SIZE, size)
          return head
        end
        carve(table, size, index)
      end

      def self.carve(table : Pointer(UInt64), size : UInt64, index : Int32) : UInt64
        arena = table[FILL + index]
        if arena == 0 || read64(arena + OFF_LEFT) == 0
          arena = map_arena(index)
          table[FILL + index] = arena
        end
        cursor = read64(arena + OFF_CURSOR)
        write64(arena + OFF_CURSOR, cursor + read64(arena + OFF_CHUNK))
        write64(arena + OFF_LEFT, read64(arena + OFF_LEFT) - 1)
        write64(cursor + OFF_SIZE, size)
        cursor
      end

      def self.map_arena(index : Int32) : UInt64
        base = __iyi_mmap(MAP).address
        chunk = payload(index) + HEADER
        write64(base + OFF_NEXT, @@arenas)
        write64(base + OFF_MAP, MAP)
        write64(base + OFF_CHUNK, chunk)
        write64(base + OFF_CURSOR, base + HEAD)
        write64(base + OFF_LEFT, (MAP - HEAD).unsafe_div(chunk))
        @@arenas = base
        base
      end

      def self.take_large(size : UInt64) : UInt64
        mapped = size + LARGE_USER
        base = __iyi_mmap(mapped).address
        write64(base + OFF_NEXT, @@large)
        write64(base + OFF_MAP, mapped)
        write64(base + 16 + OFF_SIZE, size)
        @@large = base
        base + 16
      end

      def self.free(pointer : Void*) : Nil
        return if pointer.address == 0
        head = pointer.address - HEADER
        size = read64(head)
        if size <= TOP
          index = class_index(size)
          table = directory
          write64(head, table[index])
          table[index] = head
        else
          free_large(head)
        end
      end

      def self.free_large(head : UInt64) : Nil
        base = head - 16
        previous = 0_u64
        node = @@large
        while node != 0
          if node == base
            if previous == 0
              @@large = read64(node)
            else
              write64(previous, read64(node))
            end
            break
          end
          previous = node
          node = read64(node)
        end
        __iyi_munmap(base, read64(base + 8))
      end

      # Same-chunk growth within a class, allocate-and-copy across one,
      # because the old size rides under the object header, which is the only
      # place that knows it. The new chunk's type id stays zero, which is
      # right: a reallocated buffer is raw memory whose old map, if it had
      # one, described a different number of bytes, and zero means the mark
      # loop word-scans it conservatively instead.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        head = pointer.address - HEADER
        old_size = read64(head)
        if old_size <= TOP && size <= TOP && class_index(old_size) == class_index(size)
          write64(head + OFF_SIZE, size)
          return pointer
        end
        new_pointer = alloc(size)
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        free(pointer)
        new_pointer
      end

      # The whole payload, word at a time: pointer arithmetic counts
      # elements here, so eight bytes is one step, not eight.
      def self.clear_block(start : UInt64, count : UInt64) : Nil
        words = Pointer(UInt64).new(start)
        filled = 0_u64
        while filled + 8 <= count
          words.value = 0_u64
          words = words + 1_i64
          filled = filled + 8
        end
        bytes = Pointer(UInt8).new(start + filled)
        while filled < count
          bytes.value = 0_u8
          bytes = bytes + 1_i64
          filled = filled + 1
        end
      end

      def self.containing(pointer : Void*) : UInt64
        address = pointer.address
        arena = @@arenas
        while arena != 0
          if address >= arena + HEAD && address < arena + read64(arena + OFF_MAP)
            return arena
          end
          arena = read64(arena + OFF_NEXT)
        end
        0_u64
      end

      def self.containing_large(pointer : Void*) : UInt64
        address = pointer.address
        node = @@large
        while node != 0
          if address >= node + LARGE_USER && address < node + read64(node + OFF_MAP)
            return node
          end
          node = read64(node)
        end
        0_u64
      end

      def self.first_arena : UInt64
        @@arenas
      end

      def self.arena_next(arena : UInt64) : UInt64
        read64(arena + OFF_NEXT)
      end

      def self.arena_map(arena : UInt64) : UInt64
        read64(arena + OFF_MAP)
      end

      def self.arena_chunk(arena : UInt64) : UInt64
        read64(arena + OFF_CHUNK)
      end

      # The fill cursor names where carving stopped, which is what tells a
      # chunk that was handed out from the untouched tail of an arena. Stage 3
      # asks it of every candidate pointer and Stage 6's sweep will ask it of
      # every arena, so it is an accessor beside the others rather than a
      # thing either stage reaches into the header for.
      def self.arena_cursor(arena : UInt64) : UInt64
        read64(arena + OFF_CURSOR)
      end

      def self.first_large : UInt64
        @@large
      end

      def self.large_next(node : UInt64) : UInt64
        read64(node)
      end

      def self.large_mapped(node : UInt64) : UInt64
        read64(node + 8)
      end
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc_atomic(size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is defined locally for the bump branch's reason: codegen itself
    # reaches for the name (`pre_initialize_aggregate` and
    # `generic_array_malloc` lower to the LLVM `llvm.memset` intrinsic, which
    # becomes a C `memset` call once the size is not a constant), and a
    # definition with the same name, types and return is the only thing that
    # can intercept that. The bulk goes eight bytes at a time, and the word
    # store advances one word per store, because pointer arithmetic here
    # counts elements: eight bytes is one step, not eight. The byte loop
    # carries the tail, and the pattern word is the byte tiled eight wide.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!

      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end

    # GC_DESIGN.md's Stage 3: the root set, made enumerable. Nothing marks and
    # nothing collects here. What lands is the answer to "where could a
    # pointer to a live object be", asked of the one thread this language has,
    # and the answer to "is this word one", asked of the heap Stage 2 built.
    # Stage 5 passes a marking function to `IyiRoots.each_root` and that is
    # the whole interface it needs; `bench/root_exercise.iyi` is the only
    # caller until then, and it is what says the mechanism works.
    #
    # Conservative, and deliberately biased toward retaining. A word that is
    # not a pointer but lands inside an allocated chunk keeps that chunk alive
    # for one cycle, which costs memory. A word that IS a pointer and is not
    # reported frees a live object, which costs correctness. Every decision
    # below is made in that direction: when in doubt, retain.
    #
    # Three places a root can be, and the second is the one that gets missed:
    #
    # 1. The stack, word by word between the current stack pointer and the
    #    base. Both targets grow the stack downward, so the stack pointer is
    #    the low end and the base is the high one, and the scan runs upward
    #    from the first 8-aligned address. Only aligned words are candidates:
    #    a pointer the compiler stored is 8-aligned on both targets, so an
    #    unaligned word is a coincidence of neighbouring bytes and not a
    #    reference anything can follow.
    #
    # 2. The registers. A root can sit in a callee-saved register and appear
    #    nowhere on the stack, so a collector that scans only the stack frees
    #    a live object. This is the part of GC_DESIGN.md's Stage 4 that is
    #    real without threads: there is no thread to suspend and no register
    #    state to read out of one, but the register file of the thread that
    #    is running still holds references. They are spilled to memory before
    #    the scan and that memory is a root range of its own.
    #
    # 3. The globals, whose ranges come from the platform rather than from a
    #    guess. A range that cannot be obtained is fatal rather than empty,
    #    because a missing root range is a collector that frees live objects
    #    and an empty range looks exactly like a clean scan.
    #
    # 4. Every suspended fiber's stack (Stage 3's fourth task, closed).
    #    The scheduler keeps an all-fibers registry precisely because its
    #    wait queues cannot serve this walk — a channel-parked fiber lives
    #    in the channel's own nodes — and `each_fiber_root` scans each
    #    suspended fiber from its saved stack pointer to its stack top.
    #    This was a recorded gap between 0.4.0's scheduler landing and
    #    this walk: an object reachable only from a parked fiber's stack
    #    would have been freed live, latent only because nothing but the
    #    exercises triggers a collection.
    #
    # What is NOT here, for the same reason: nothing suspends a thread. Stage
    # 4's `SIGSTOP` on Linux and Mach `thread_suspend` on darwin stop threads
    # this runtime cannot create, and code that stops nothing cannot be
    # tested for stopping the right things.
    {% if flag?(:darwin) %}
      # The stack base and the global segments, from libSystem, which has the
      # same standing here that `write` and `mmap` do: Apple documents it as
      # the platform's interface and raw syscalls as not a stable ABI.
      # `pthread_get_stackaddr_np` is the sanctioned answer for the highest
      # address of a thread's stack, and dyld's image list is the sanctioned
      # answer for where a Mach-O image's segments landed after sliding.
      lib LibC
        fun pthread_self : Void*
        fun pthread_get_stackaddr_np(thread : Void*) : Void*
        fun _dyld_get_image_header(index : Int32) : Void*
        fun _dyld_get_image_vmaddr_slide(index : Int32) : Int64
      end
    {% else %}
      # The static data span on Linux, from the two symbols the link already
      # defines: `__data_start` at the front of `.data` and `_end` past the
      # back of `.bss`, which is GC_DESIGN.md's "`__data_start` to
      # `__bss_end`" written the way the linker spells it. Declaring them and
      # taking their addresses costs no library: `_end` comes from the linker
      # itself and `__data_start` from the C runtime object every link
      # template already adds, so they arrive as two undefined symbols and no
      # new `-l`. A binary whose link provides neither fails at the link
      # rather than scanning nothing at run time.
      lib LibIyiImage
        $__data_start : UInt8
        $_end : UInt8
      end
    {% end %}

    class IyiRoots
      # Six callee-saved registers on x86_64 and twelve on aarch64, named
      # where they are spilled.
      {% if flag?(:x86_64) %}
        SPILL = 48_u64
      {% else %}
        SPILL = 96_u64
      {% end %}
      PAGE = 4096_u64
      MAPS = 65536_u64

      # The same rule the allocator's state lives under: `$` globals are
      # refused, a `fun` body cannot reach `@@` state, and a literal
      # initializer folds into the LLVM global's static zero, so zero means
      # "not discovered yet" rather than a value startup code installs. There
      # is no array class variable either, which is why the register spill
      # buffer is a mapped page named by one of these rather than a field.
      @@spill : UInt64 = 0_u64
      @@stack_base : UInt64 = 0_u64
      @@data_low : UInt64 = 0_u64
      @@data_high : UInt64 = 0_u64
      @@const_low : UInt64 = 0_u64
      @@const_high : UInt64 = 0_u64
      @@found_globals : UInt64 = 0_u64

      # A root range that cannot be obtained ends the program. The whole
      # point of the range is that missing it frees live objects, so a
      # diagnosis now is cheaper than a corrupted heap later.
      def self.fatal(message : String) : NoReturn
        __iyi_write(1, message.to_unsafe.as(Void*), message.bytesize.to_u64)
        __iyi_exit(1)
      end

      # One page of its own for the register spill, mapped on first use the
      # way the allocator's directory is. It is deliberately not heap memory:
      # a spill buffer taken from `IyiHeap` would be a chunk the scan then
      # reports as a live object, and a chunk holding a raw pointer to
      # everything every register held.
      def self.spill : UInt64
        @@spill = __iyi_mmap(PAGE).address if @@spill == 0
        @@spill
      end

      # The callee-saved registers, stored where the scan can see them.
      # x86_64 System V preserves rbx, rbp and r12 through r15 across a call;
      # aarch64 AAPCS64 preserves x19 through x28, x29 the frame pointer and
      # x30 the link register. The caller-saved registers are not captured
      # and do not need to be: their convention is that a caller keeps
      # nothing live in them across a call, so any value still wanted was
      # written to the frame that the stack scan already covers. The
      # floating-point callee-saved registers (d8 to d15, xmm on Windows) are
      # not captured either, because nothing in this language puts an object
      # pointer in one.
      #
      # The destination is pinned to a caller-saved register, rdi or x0, so
      # that the register holding it can never be one of the registers being
      # captured. Slots left over from an earlier spill stay as they were,
      # which retains a little more than it must and never less.
      def self.spill_registers : Nil
        buffer = spill
        {% if flag?(:x86_64) %}
          asm("movq %rbx, 0($0)
               movq %rbp, 8($0)
               movq %r12, 16($0)
               movq %r13, 24($0)
               movq %r14, 32($0)
               movq %r15, 40($0)" :: "{rdi}"(buffer) : "memory" : "volatile")
        {% else %}
          asm("stp x19, x20, [$0, #0]
               stp x21, x22, [$0, #16]
               stp x23, x24, [$0, #32]
               stp x25, x26, [$0, #48]
               stp x27, x28, [$0, #64]
               stp x29, x30, [$0, #80]" :: "{x0}"(buffer) : "memory" : "volatile")
        {% end %}
      end

      # The low end of the stack, read out of the register that names it.
      # Taken here rather than from the address of a local because a local's
      # address is above whatever the current frame has already pushed, and
      # the difference is exactly the words a compiler spills a pointer into.
      def self.stack_pointer : UInt64
        value = uninitialized UInt64
        {% if flag?(:x86_64) %}
          asm("movq %rsp, $0" : "=r"(value) :: : "volatile")
        {% else %}
          asm("mov $0, sp" : "=r"(value) :: : "volatile")
        {% end %}
        value
      end

      # The high end, discovered once. The main thread's stack grows down
      # from a fixed top on both targets, so the number does not change over
      # a run and reading it lazily is the same answer as recording it at
      # startup, without the startup cost for a program that never collects.
      def self.stack_base : UInt64
        @@stack_base = discover_stack_base if @@stack_base == 0
        @@stack_base
      end

      {% if flag?(:darwin) %}
        # What this number is: the address one past the highest byte of the
        # main thread's stack, which is what `pthread_get_stackaddr_np`
        # returns and is the true base rather than an approximation of it.
        def self.discover_stack_base : UInt64
          base = LibC.pthread_get_stackaddr_np(LibC.pthread_self).address
          fatal("iyi: stack base unavailable\n") if base == 0
          base
        end
      {% else %}
        # What this number is: the end address of the kernel's `[stack]`
        # mapping for this process, read out of `/proc/self/maps`, which is
        # the true base and not an approximation. The address of a local in
        # `main` was the alternative and it is not the same number: it sits
        # below argv, envp and the auxiliary vector, which the kernel places
        # at the top of that mapping, so a base taken there is too low and a
        # base that is too low silently loses roots.
        #
        # Reading a file is three syscalls this file already issues. The
        # buffer is a mapping of its own rather than a heap chunk, because
        # the heap is the thing being described and a scratch chunk in it
        # would be one more object every later scan has to reason about.
        def self.discover_stack_base : UInt64
          buffer = __iyi_mmap(MAPS).address
          handle = __iyi_open_read("/proc/self/maps".to_unsafe)
          fatal("iyi: /proc/self/maps unreadable\n") if handle < 0
          filled = 0_u64
          while filled < MAPS
            count = __iyi_read(handle.to_i32, Pointer(Void).new(buffer + filled), MAPS - filled)
            break if count <= 0
            filled = filled + count.to_u64
          end
          __iyi_close(handle)
          base = stack_end_in_maps(buffer, filled)
          __iyi_munmap(buffer, MAPS)
          # The `[stack]` line is near the end of the file, so a read that
          # filled the buffer and stopped short reports no line rather than a
          # wrong one, and this is where that becomes a diagnosis.
          fatal("iyi: no [stack] line in /proc/self/maps\n") if base == 0
          base
        end
      {% end %}

      # `/proc/self/maps` is a line per mapping, "low-high perms ..." in hex,
      # with the region's name last. The line whose name is `[stack]` is the
      # main thread's, and the number after the dash is its end. Kept off the
      # platform branch and reachable on both, because parsing text is the
      # half of this that a test can exercise anywhere and the syscalls are
      # the half that cannot leave Linux.
      def self.stack_end_in_maps(buffer : UInt64, length : UInt64) : UInt64
        bytes = Pointer(UInt8).new(buffer)
        start = 0_u64
        index = 0_u64
        while index <= length
          if index == length || (bytes + index.to_i64).value == 10_u8
            return line_stack_end(bytes, start, index) if line_names_stack?(bytes, start, index)
            start = index + 1
          end
          index = index + 1
        end
        0_u64
      end

      def self.line_names_stack?(bytes : Pointer(UInt8), start : UInt64, stop : UInt64) : Bool
        return false if stop < start + 7
        name = "[stack]".to_unsafe
        cursor = stop - 7
        index = 0
        while index < 7
          return false if (bytes + (cursor + index.to_u64).to_i64).value != name[index]
          index = index + 1
        end
        true
      end

      def self.line_stack_end(bytes : Pointer(UInt8), start : UInt64, stop : UInt64) : UInt64
        cursor = start
        # 45 is '-', which separates the two addresses.
        while cursor < stop && (bytes + cursor.to_i64).value != 45_u8
          cursor = cursor + 1
        end
        return 0_u64 if cursor >= stop
        cursor = cursor + 1
        value = 0_u64
        digits = 0
        while cursor < stop
          digit = hex_digit((bytes + cursor.to_i64).value)
          break if digit > 15
          value = value * 16_u64 + digit
          digits = digits + 1
          cursor = cursor + 1
        end
        return 0_u64 if digits == 0
        value
      end

      # 16 for anything that is not a hex digit, which is the terminator the
      # caller reads rather than a second return value it has nowhere to put.
      def self.hex_digit(byte : UInt8) : UInt64
        return (byte - 48_u8).to_u64 if byte >= 48_u8 && byte <= 57_u8
        return (byte - 97_u8).to_u64 + 10_u64 if byte >= 97_u8 && byte <= 102_u8
        return (byte - 65_u8).to_u64 + 10_u64 if byte >= 65_u8 && byte <= 70_u8
        16_u64
      end

      {% if flag?(:darwin) %}
        # The main executable's `__DATA` and `__DATA_CONST`, walked out of its
        # Mach header. Image 0 is the main executable, and it is the only
        # image asked: nothing outside this program allocates from this heap,
        # so no other image's data segment can hold a pointer into it. The
        # segment addresses in the file are unslid, so the slide is added.
        # `__DATA_CONST` is optional because a binary may genuinely have none;
        # `__DATA` is not, because every binary has one and its absence means
        # the walk is wrong rather than the binary unusual.
        def self.discover_globals : Nil
          header = LibC._dyld_get_image_header(0).address
          fatal("iyi: no Mach header for the main image\n") if header == 0
          fatal("iyi: main image is not 64-bit Mach-O\n") if IyiHeap.read64(header) & 0xFFFFFFFF_u64 != 0xFEEDFACF_u64
          slide = LibC._dyld_get_image_vmaddr_slide(0).to_u64
          count = IyiHeap.read64(header + 16) & 0xFFFFFFFF_u64
          cursor = header + 32_u64
          seen = 0_u64
          while seen < count
            word = IyiHeap.read64(cursor)
            size = word.unsafe_shr(32)
            fatal("iyi: zero-length Mach load command\n") if size == 0
            # LC_SEGMENT_64. The name is sixteen bytes at offset 8, compared
            # as two words rather than a loop: "__DATA" padded with zeros,
            # and "__DATA_CONST" the same.
            if word & 0xFFFFFFFF_u64 == 0x19_u64
              first = IyiHeap.read64(cursor + 8)
              second = IyiHeap.read64(cursor + 16)
              if first == 0x415441445F5F_u64 && second == 0_u64
                @@data_low = IyiHeap.read64(cursor + 24) &+ slide
                @@data_high = @@data_low &+ IyiHeap.read64(cursor + 32)
              elsif first == 0x435F415441445F5F_u64 && second == 0x54534E4F_u64
                @@const_low = IyiHeap.read64(cursor + 24) &+ slide
                @@const_high = @@const_low &+ IyiHeap.read64(cursor + 32)
              end
            end
            cursor = cursor + size
            seen = seen + 1_u64
          end
          fatal("iyi: no __DATA segment in the main image\n") if @@data_high <= @@data_low
          @@found_globals = 1_u64
        end
      {% else %}
        # `.data` and `.bss`, which are contiguous in every ELF layout the
        # link templates produce, so the two symbols bound one range rather
        # than two. There is no second range on this target, which is why
        # `@@const_low` and `@@const_high` stay zero here and the scan skips
        # an empty range rather than needing a flag to tell it to.
        def self.discover_globals : Nil
          low = pointerof(LibIyiImage.__data_start).address
          high = pointerof(LibIyiImage._end).address
          fatal("iyi: __data_start.._end is not a range\n") if high <= low
          @@data_low = low
          @@data_high = high
          @@found_globals = 1_u64
        end
      {% end %}

      def self.globals : Nil
        discover_globals if @@found_globals == 0
      end

      def self.data_low : UInt64
        globals
        @@data_low
      end

      def self.data_high : UInt64
        globals
        @@data_high
      end

      def self.const_low : UInt64
        globals
        @@const_low
      end

      def self.const_high : UInt64
        globals
        @@const_high
      end

      # Is this word a pointer to a live object, and if so where does that
      # object start? One answer for both questions, because a root usually
      # points into the middle of an object and the marker needs the base.
      # Zero means "not a heap pointer", which is also the answer for a null
      # word, for a word in no arena, for a word in the part of an arena that
      # was never carved, and for a word in a chunk that has been freed.
      #
      # Stage 2 answers the first half already: `containing` names the arena
      # a pointer is in, and the arena's header names its chunk size, so the
      # chunk a word falls in is arithmetic rather than a search. The rest is
      # the part Stage 2 had no reason to answer. A chunk at or past the fill
      # cursor was never handed out, which is also how the tail of an arena
      # too short for one more chunk is rejected. A chunk on its class's free
      # list was handed out and given back, and reporting it live would keep
      # a dead object alive forever, since nothing would ever free it twice.
      #
      # The free-list walk is linear in the chunks freed for that one class,
      # and it is only reached by a word that already landed inside an arena,
      # which a word that is not a pointer almost never does. A per-arena
      # allocation bitmap is the O(1) form and it is Stage 6's to add if
      # sweeping wants one, not a thing to build before a profile asks.
      def self.base_of(word : UInt64) : UInt64
        return 0_u64 if word == 0
        candidate = Pointer(Void).new(word)
        arena = IyiHeap.containing(candidate)
        if arena != 0
          first = arena + IyiHeap::HEAD
          chunk = IyiHeap.arena_chunk(arena)
          head = first + (word - first).unsafe_div(chunk) * chunk
          return 0_u64 if head >= IyiHeap.arena_cursor(arena)
          return 0_u64 if free_listed?(head, chunk)
          return head + IyiHeap::HEADER
        end
        node = IyiHeap.containing_large(candidate)
        return node + IyiHeap::LARGE_USER if node != 0
        0_u64
      end

      def self.free_listed?(head : UInt64, chunk : UInt64) : Bool
        node = IyiHeap.directory[IyiHeap.class_index(chunk - IyiHeap::HEADER)]
        while node != 0
          return true if node == head
          node = IyiHeap.read64(node)
        end
        false
      end

      # Every 8-aligned word in [low, high), with the ones that validate
      # handed to the callback as the base of the object they reach. The same
      # base can be reported more than once, because more than one root can
      # reach one object; marking is idempotent, so deduplicating is the
      # caller's business and not worth a set here.
      def self.scan_range(low : UInt64, high : UInt64, visit : Proc(UInt64, Nil)) : Nil
        return if high <= low
        cursor = low
        remainder = cursor.unsafe_mod(8_u64)
        cursor = cursor + (8_u64 - remainder) if remainder != 0
        while cursor + 8_u64 <= high
          base = base_of(IyiHeap.read64(cursor))
          visit.call(base) if base != 0
          cursor = cursor + 8_u64
        end
      end

      # The running stack. Its high end is the thread's own base unless a
      # spawned fiber is executing, in which case it is that fiber's mmap'd
      # top — scanning up to the thread base from a fiber stack would walk
      # the unmapped gap between the two mappings and fault.
      def self.each_stack_root(visit : Proc(UInt64, Nil)) : Nil
        top = stack_base
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          fiber_top = IyiScheduler.current_stack_top
          top = fiber_top if fiber_top != 0
        {% end %}
        scan_range(stack_pointer, top, visit)
      end

      # Every suspended fiber's stack, from its saved stack pointer to its
      # top (GC_DESIGN.md Stage 3's fourth task, closed). The registry is
      # the scheduler's all-fibers list, because the wait queues cannot
      # serve this walk: a channel-parked fiber lives in the channel's own
      # nodes. Skipped by state: the running fiber is `each_stack_root`'s
      # business, a done fiber's stack holds nothing live, and a fiber that
      # never suspended has no saved pointer to scan from. The main fiber's
      # top is 0 in the registry, standing for the thread base this module
      # discovered. On the targets with no scheduler there is nothing to
      # walk and this is the empty walk it looks like.
      def self.each_fiber_root(visit : Proc(UInt64, Nil)) : Nil
        {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
          fiber = IyiScheduler.first_fiber
          while fiber.is_a?(IyiFiber)
            if fiber.state != 0 && fiber.state != 6 && fiber.saved_sp != 0
              top = fiber.stack_top
              top = stack_base if top == 0
              scan_range(fiber.saved_sp, top, visit)
            end
            fiber = fiber.next_fiber
          end
        {% end %}
      end

      # The spill buffer as a root range. Writing the registers somewhere the
      # scan does not reach would be the same as not capturing them.
      def self.each_register_root(visit : Proc(UInt64, Nil)) : Nil
        buffer = spill
        scan_range(buffer, buffer + SPILL, visit)
      end

      def self.each_global_root(visit : Proc(UInt64, Nil)) : Nil
        scan_range(data_low, data_high, visit)
        scan_range(const_low, const_high, visit)
      end

      # The whole root set: the running stack, the spilled registers, the
      # globals, and every suspended fiber's stack — the gap the block
      # above used to record, closed by the scheduler's registry. The
      # spill happens first and before anything calls back into user code,
      # because the callback is user code and user code uses registers.
      def self.each_root(visit : Proc(UInt64, Nil)) : Nil
        spill_registers
        each_register_root(visit)
        each_stack_root(visit)
        each_fiber_root(visit)
        each_global_root(visit)
      end
    end

    # iyi: GC_DESIGN.md Stage 5, the mark phase. Roots go gray, the queue
    # drains, and what is still white when it stops is unreachable. Nothing
    # sweeps yet: this stage decides what is garbage, Stage 6 reclaims it.
    #
    # Colour lives in bits 0 and 1 of the mark word at `base - 8`, matching
    # `Iyi::Collector::ObjectHeader` in the compiler: 0 white, 1 gray, 2 black,
    # and a fresh chunk is zero, so a newly allocated object is white without
    # anyone writing anything. The bits above are left alone on every write,
    # because they are the flag and reserved bits the header promises to a
    # forwarding pointer later.
    #
    # **Conservative, on purpose, for now.** Every object is word-scanned
    # between its user pointer and its size, rather than by the pointer
    # offsets its `TypeLayout` names. The table those offsets live in IS
    # emitted into the binary (`__iyi_gc_layouts`, `codegen/gc_layouts.cr`),
    # and this loop does not read it, because nothing writes an object's
    # `type_id` yet: `malloc` is handed a size and cannot know the type, so
    # the store belongs at the allocation site in codegen and that is the next
    # step. Reading a table keyed by an id that is always zero would be a
    # lookup no test could reach, so it is not written until the id is real.
    # Conservative marking is not a placeholder either way: it is what Boehm
    # does in production, and it is safe in the direction that matters, since
    # a false positive retains a dead object and only a false negative frees a
    # live one.
    #
    # Plain loads and stores rather than compare-and-swap: one mutator
    # thread, and the scheduler's fibers yield only at suspension points,
    # never inside the marker. `ObjectHeader`'s CAS helpers exist and are
    # tested for when Stage 7 has threads to contend, and with a single
    # mutator a CAS and a load-store pair decide the same thing.
    class IyiMark
      WHITE = 0_u64
      GRAY  = 1_u64
      BLACK = 2_u64
      COLOUR = 3_u64

      # The queue is its own mapping, never the heap being marked. A mark
      # phase that allocated from that heap could carve a chunk, or hand back
      # one it is about to decide the liveness of, which is a collector
      # reasoning about memory it is mutating. It starts at one page of words
      # and doubles into a fresh mapping when it fills; the old mapping is
      # released, because a mark phase that leaked its own queue every cycle
      # would outgrow the heap it was collecting.
      @@queue : UInt64 = 0_u64
      @@queue_words : UInt64 = 0_u64
      @@queue_len : UInt64 = 0_u64

      # What the last sweep reclaimed and kept, and how many collections have
      # run. Literal initializers, so codegen folds them to a static zero the
      # way every other piece of state in this file does.
      @@swept : UInt64 = 0_u64
      @@kept : UInt64 = 0_u64
      @@bytes_freed : UInt64 = 0_u64
      @@collections : UInt64 = 0_u64

      def self.colour(base : UInt64) : UInt64
        IyiHeap.read64(base - 8_u64) & COLOUR
      end

      # Set the colour and leave every other bit of the word as it was, because
      # those are the flag and reserved bits the header promises to a forwarding
      # pointer later.
      #
      # `word - (word & COLOUR)` is how the low two bits get cleared, and the
      # shape is dictated by what this prelude actually defines on `UInt64`.
      # Neither `~` nor `>>` is there, and the literal 2^64-4 as a mask invited
      # a question about whether a literal that large round-trips exactly, which
      # is not a question worth carrying in the one line that decides an
      # object's colour. Subtracting the low bits from the word needs only `&`
      # and `-`, both of which this file already relies on everywhere.
      def self.recolour(base : UInt64, colour : UInt64) : Nil
        word = IyiHeap.read64(base - 8_u64)
        IyiHeap.write64(base - 8_u64, (word - (word & COLOUR)) | colour)
      end

      def self.queue_reserve : Nil
        return if @@queue_len < @@queue_words
        words = @@queue_words == 0 ? 512_u64 : @@queue_words * 2_u64
        fresh = __iyi_mmap(words * 8_u64).address
        IyiRoots.fatal("iyi: the mark queue could not grow\n") if fresh == 0
        moved = 0_u64
        while moved < @@queue_len
          IyiHeap.write64(fresh + moved * 8_u64, IyiHeap.read64(@@queue + moved * 8_u64))
          moved = moved + 1_u64
        end
        __iyi_munmap(@@queue, @@queue_words * 8_u64) if @@queue != 0
        @@queue = fresh
        @@queue_words = words
      end

      # Gray it and enqueue it, once. A base that is already gray or black has
      # been claimed, and enqueuing it again would scan it twice and, on a
      # cycle, never stop.
      def self.shade(base : UInt64) : Nil
        return if base == 0
        return if colour(base) != WHITE
        recolour(base, GRAY)
        queue_reserve
        IyiHeap.write64(@@queue + @@queue_len * 8_u64, base)
        @@queue_len = @@queue_len + 1_u64
      end

      # Scan one object's payload and blacken it. The bound is the size the
      # header carries, which is the requested size rather than the chunk's:
      # the bytes past the request belong to the caller only through a later
      # realloc, and scanning them would read whatever the last owner left.
      def self.scan(base : UInt64) : Nil
        size = IyiHeap.read64(base - IyiHeap::HEADER)
        cursor = base
        limit = base + size
        while cursor + 8_u64 <= limit
          shade(IyiRoots.base_of(IyiHeap.read64(cursor)))
          cursor = cursor + 8_u64
        end
        recolour(base, BLACK)
      end

      # One mark phase. Returns how many objects came out black, which is the
      # live count the exercise checks and the number Stage 6 will sweep
      # against.
      def self.mark : UInt64
        @@queue_len = 0_u64
        IyiRoots.each_root(->(base : UInt64) { shade(base) })
        black = 0_u64
        while @@queue_len > 0_u64
          @@queue_len = @@queue_len - 1_u64
          base = IyiHeap.read64(@@queue + @@queue_len * 8_u64)
          scan(base)
          black = black + 1_u64
        end
        black
      end

      # Put every live object back to white, so a second phase starts from
      # where the first one did. Stage 6 does this as it sweeps, one walk
      # instead of two; until then the exercise needs a way to run the phase
      # more than once.
      def self.unmark : Nil
        arena = IyiHeap.first_arena
        while arena != 0
          chunk = IyiHeap.arena_chunk(arena)
          cursor = arena + IyiHeap::HEAD
          stop = IyiHeap.arena_cursor(arena)
          while cursor < stop
            recolour(cursor + IyiHeap::HEADER, WHITE)
            cursor = cursor + chunk
          end
          arena = IyiHeap.arena_next(arena)
        end
        node = IyiHeap.first_large
        while node != 0
          recolour(node + IyiHeap::LARGE_USER, WHITE)
          node = IyiHeap.large_next(node)
        end
      end

      # iyi: GC_DESIGN.md Stage 6, the sweep. Stage 5 decided what is garbage;
      # this is where the memory comes back. One walk over every chunk that has
      # been carved: a white object is unreachable, so its chunk goes on its
      # class's free list, and a black one survives and is repainted white for
      # the next cycle. Repainting as it goes is why sweep does not need a
      # second pass, and why `unmark` above is only the exercise's tool.
      #
      # A chunk already on a free list is skipped rather than freed again. It is
      # white, because nothing marked it and nothing owns it, and freeing it
      # twice would put one chunk on the list twice, which is the same memory
      # handed to two callers. `free_listed?` is that check, and it is why this
      # loop cannot simply trust the colour.
      #
      # A large object's `next` is read before the node is released, because
      # releasing it unmaps the memory the link lives in.
      #
      # What is not here, and why. **Finalizers**: nothing in this language
      # defines one. There is no `def finalize` anywhere in `src/iyi` or
      # `samples/iyi`, so a finalizer queue would be a mechanism no program
      # could put an entry in, which is the shape SPEC.md III.4.8 refused for a
      # concurrency marker and the shape this collector has refused twice
      # already. **Weak references**: the same answer. They are registration
      # based and the standard library's `WeakRef` lives on the `--crystal`
      # side, so there is no table here to walk and null out. Both wait on the
      # language having the feature rather than on the collector.
      def self.sweep : Nil
        @@swept = 0_u64
        @@kept = 0_u64
        @@bytes_freed = 0_u64

        arena = IyiHeap.first_arena
        while arena != 0
          chunk = IyiHeap.arena_chunk(arena)
          cursor = arena + IyiHeap::HEAD
          stop = IyiHeap.arena_cursor(arena)
          while cursor < stop
            base = cursor + IyiHeap::HEADER
            unless IyiRoots.free_listed?(cursor, chunk)
              if colour(base) == WHITE
                @@bytes_freed = @@bytes_freed + IyiHeap.read64(cursor + IyiHeap::OFF_SIZE)
                @@swept = @@swept + 1_u64
                IyiHeap.free(Pointer(Void).new(base))
              else
                recolour(base, WHITE)
                @@kept = @@kept + 1_u64
              end
            end
            cursor = cursor + chunk
          end
          arena = IyiHeap.arena_next(arena)
        end

        node = IyiHeap.first_large
        while node != 0
          following = IyiHeap.large_next(node)
          base = node + IyiHeap::LARGE_USER
          if colour(base) == WHITE
            @@bytes_freed = @@bytes_freed + IyiHeap.read64(node + 16_u64 + IyiHeap::OFF_SIZE)
            @@swept = @@swept + 1_u64
            IyiHeap.free(Pointer(Void).new(base))
          else
            recolour(base, WHITE)
            @@kept = @@kept + 1_u64
          end
          node = following
        end

        @@collections = @@collections + 1_u64
      end

      # One collection: decide, then reclaim.
      def self.collect : Nil
        mark
        sweep
      end

      # What the last sweep did. GC_DESIGN.md Stage 6 asks for statistics and
      # this is the honest subset: counted as the walk went rather than sampled
      # afterwards. Pause time and a cumulative allocation total want a clock
      # and a hook in the hot path, and neither is worth adding before there is
      # something that reads them.
      def self.swept : UInt64
        @@swept
      end

      def self.kept : UInt64
        @@kept
      end

      def self.bytes_freed : UInt64
        @@bytes_freed
      end

      def self.collections : UInt64
        @@collections
      end
    end
  {% elsif flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64)) %}
    # iyi: The default heap on Linux is a bump pointer over `mmap` regions:
    # allocate, never free, which is the contract the libc path below already
    # has (`free` is not bound there for the same reason, and a program that
    # outlives its memory is what allocating without collecting asks for).
    # `MAP_ANONYMOUS` guarantees zero-fill, so `__crystal_malloc64`'s
    # documented clear comes from the mapping itself rather than a second pass
    # over the bytes: nothing is handed out twice, so nothing can be dirtier
    # than the kernel left it, and the atomic variant is therefore the same
    # memory on this path too. Each pointer carries its size in the eight
    # bytes under it, because `realloc` has no other way to know how much to
    # copy, and the eight bytes also keep every user pointer 8-aligned.
    #
    # One MiB a chunk, and an allocation bigger than that gets a chunk of its
    # own. The kernel rounds `length` up to a page, so the chunk size is not
    # rounded here.
    #
    # The cursor and what is left of the chunk are the allocator's whole
    # state, held as class variables on `IyiHeap` because the language has
    # nothing else to hold them in: `$` globals are refused outright, and a
    # `fun` body cannot reach `@@` state. Both are `UInt64` with literal
    # initializers, which codegen folds into the LLVM global's static zero
    # rather than a runtime init call, so what a plain global would have
    # meant is kept: both start at zero, which means "mmap on the first
    # allocation", not a value any startup code has to install. The
    # allocation entry points below must stay `fun`s because codegen calls
    # them by C name, so they forward one frame deep into class methods;
    # that frame is the price of the only state-carrying construct the
    # language offers.
    class IyiHeap
      @@cursor : UInt64 = 0_u64
      @@left : UInt64 = 0_u64

      def self.alloc(size : UInt64) : Void*
        bytes = size.to_i64
        remainder = bytes % 8
        bytes = bytes + (8 - remainder) if remainder > 0
        bytes = bytes + 8

        if @@left < bytes.to_u64
          chunk = 1048576_i64
          chunk = bytes if bytes > chunk
          @@cursor = __iyi_mmap(chunk.to_u64).address
          @@left = chunk.to_u64
        end

        block = Pointer(Void).new(@@cursor)
        @@cursor = @@cursor + bytes.to_u64
        @@left = @@left - bytes.to_u64
        block.as(Pointer(UInt64)).value = size
        block + 8_i64
      end

      # Allocate-and-copy rather than growth in place, because nothing frees
      # and the old size rides in the eight bytes under the pointer, which is
      # the only place that knows it.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        old_size = Pointer(UInt64).new(pointer.address - 8).value
        new_pointer = alloc(size)
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        new_pointer
      end
    end

    fun __iyi_mmap(length : UInt64) : Pointer(Void)
      result = uninitialized Int64
      {% if flag?(:x86_64) %}
        # PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 0x22.
        asm("syscall" : "={rax}"(result)
                      : "{rax}"(9_i64), "{rdi}"(0_i64), "{rsi}"(length), "{rdx}"(3_i64),
                        "{r10}"(34_i64), "{r8}"(-1_i64), "{r9}"(0_i64)
                      : "rcx", "r11", "memory"
                      : "volatile")
      {% else %}
        asm("svc #0" : "={x0}"(result)
                     : "{x8}"(222_i64), "{x0}"(0_i64), "{x1}"(length), "{x2}"(3_i64),
                       "{x3}"(34_i64), "{x4}"(-1_i64), "{x5}"(0_i64)
                     : "memory"
                     : "volatile")
      {% end %}
      # A failed raw syscall answers with -errno in the result register rather
      # than a flag: -4095..-1 is errno's whole range.
      if result < 0 && result >= -4095
        __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
        __iyi_exit(1)
      end
      Pointer(Void).new(result.to_u64)
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is libc's on the other paths, and here it is the one libc name
    # left that codegen itself reaches for: `pre_initialize_aggregate` and
    # `generic_array_malloc` lower to the LLVM `llvm.memset` intrinsic, which
    # LLVM expands inline only while the size is a constant it can see; with
    # a runtime size it emits a call to C `memset` anyway. A definition with
    # the same name and signature is the only thing that can intercept that,
    # so the name, the types and the return are libc's rather than ours. The
    # bulk goes eight bytes at a time because every cleared allocation
    # funnels through here; the byte loop carries only the tail, and the
    # pattern word is the byte tiled eight wide.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!
      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% elsif flag?(:darwin) %}
    # iyi: The allocator on macOS is libSystem's `malloc` and `realloc`, which
    # is the explicit choice rather than a fallback: Apple documents libSystem
    # as the platform's only supported interface, it ships with the machine,
    # and its allocator is the best one available here by any measure. No
    # collection at all, which is what `src/gc/none.cr` is: the entry points
    # below carry `malloc`/`realloc` and none of the parts 0.1.0 has nothing
    # to say to (threads, finalizers, statistics).
    #
    # The clear after `malloc` is the entry point's contract rather than a fix
    # for something seen: `GC.malloc` is documented as allocating *and clearing*,
    # libc's `malloc` does not clear, and `gc/none.cr` clears for exactly that
    # reason (crystal-lang/crystal#14678). Nothing here would notice it missing
    # today, because codegen clears what it routes through this name anyway
    # (`pre_initialize_aggregate` and `generic_array_malloc` both memset), so the
    # clear is a second pass over the same bytes. It stays because the name is
    # reachable from any `.iyi` file and a swapped allocator that quietly weakens
    # the contract is the failure this default is being watched for, in miniature.
    #
    # `malloc_atomic` is that call without the clear, which is what the atomic
    # variant means on both sides: `GC_malloc_atomic` does not clear either, so
    # this is the same memory the collector's build hands back. `free` is not
    # bound because nothing frees, and a program that outlives its memory is
    # what allocating without collecting asks for.
    lib LibC
      fun malloc(size : UInt64) : Void*
      fun realloc(pointer : Void*, size : UInt64) : Void*
      fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      pointer = LibC.malloc(size)
      LibC.memset(pointer, 0, size)
      pointer
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      LibC.malloc(size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      LibC.realloc(pointer, size)
    end
  {% elsif flag?(:win32) %}
    # iyi: The allocator on Windows is the Win32 process heap: `HeapAlloc` and
    # `HeapReAlloc` on `GetProcessHeap`'s handle, all kernel32, which is the
    # platform's own interface and ships with the machine. No CRT is involved,
    # because a C runtime is a person-installed choice rather than the
    # platform's contract. The names and signatures are the ones
    # `src/lib_c/x86_64-windows-msvc/c/heapapi.cr` carries for the compiler's
    # own runtime.
    #
    # `HEAP_ZERO_MEMORY` (0x8) gives `__crystal_malloc64` its documented clear
    # in the allocator itself rather than a second pass over the bytes, and the
    # atomic variant passes 0 because not clearing is exactly what atomic
    # means (`GC_malloc_atomic` does not clear either). `HeapReAlloc` keeps
    # the old contents and grows in place where it can, which is the same
    # contract libc's `realloc` has on the other paths; a null pointer cannot
    # be handed to it, so it routes to a plain `HeapAlloc`. `free` is not
    # bound because nothing frees, and a program that outlives its memory is
    # what allocating without collecting asks for. `-Dgc_iyi` does not reach
    # this branch, deliberately rather than unfinished: the size-class arena
    # allocator is POSIX-only in its stage. This target's diagnosis for
    # printing memory it was never given has a fixed suspect — the memset
    # below strode eight elements per eight bytes, trampling `HeapAlloc`'s
    # packed neighbours and clearing at one-eighth coverage — and CI's
    # twenty-run watch is what retires the diagnosis, not a new allocator.
    # Same reason as the block above: an LLVM-emitted object names no library
    # for itself, so the three heap functions have to name theirs.
    @[Link("kernel32")]
    lib LibC
      fun GetProcessHeap : Void*
      fun HeapAlloc(heap : Void*, flags : UInt32, bytes : UInt64) : Void*
      fun HeapReAlloc(heap : Void*, flags : UInt32, memory : Void*, bytes : UInt64) : Void*
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      LibC.HeapAlloc(LibC.GetProcessHeap, 0x8_u32, size)
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      LibC.HeapAlloc(LibC.GetProcessHeap, 0_u32, size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      if pointer.address == 0
        LibC.HeapAlloc(LibC.GetProcessHeap, 0x8_u32, size)
      else
        LibC.HeapReAlloc(LibC.GetProcessHeap, 0_u32, pointer, size)
      end
    end

    # `memset` is defined locally rather than bound because the C runtime is
    # not this platform's interface, and codegen itself reaches for the name:
    # `pre_initialize_aggregate` and `generic_array_malloc` lower to the LLVM
    # `llvm.memset` intrinsic, which LLVM expands inline only while the size is
    # a constant it can see; with a runtime size it emits a call to C `memset`
    # anyway, and on win64 that call carries a 64-bit size_t. A definition
    # with the same name, types and return is the only thing that can intercept
    # it. The bulk goes eight bytes at a time; the byte loop carries the tail.
    fun memset(destination : Void*, value : Int32, count : UInt64) : Void*
      byte = value.to_u8!
      word = byte.to_u64 * 0x0101010101010101_u64
      words = destination.as(Pointer(UInt64))
      filled = 0_u64
      while filled + 8_u64 <= count
        words.value = word
        words = words + 1_i64
        filled = filled + 8_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < count
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% elsif flag?(:wasm32) %}
    # iyi: The default heap on wasm32-wasi is a bump pointer over
    # `memory.grow` pages, the same arena shape as the Linux branch, and it
    # closes the dependency floor's last finding on this target (SPEC.md
    # III.9): `malloc` and `realloc` were the two undefined names in a wasm32
    # object that are not the platform's own imports, and they came from
    # wasi-libc, which is a libc a toolchain brings rather than an interface
    # the platform guarantees. The linear memory is the platform's allocator
    # here, so the arena grows it the same way the Linux branch mmaps.
    # Allocate, never free; `free` is bound nowhere on any path, and a
    # program that outlives its memory is what allocating without collecting
    # asks for.
    #
    # Reaching `memory.grow` needed one binding, written below rather than in
    # `src/intrinsics.cr` for two measured reasons. `LibIntrinsics` there
    # proves a plain `fun` whose external name is an `llvm.` name reaches a
    # real LLVM intrinsic (`llvm.debugtrap`, `llvm.memcpy` and
    # `llvm.x86.sse2.pause` all bind exactly that way), but this prelude
    # requires nothing outside `src/iyi/` ("0.1.0", item 3), so a binding in
    # compiler source would be unreachable from here. The signature is the
    # other finding, measured against this tree's LLVM with hand-written IR:
    # the intrinsic registers as `i32 (i32, i32)`, memory index then page
    # delta, and the one-argument form the earlier probe tried is an arity
    # error the verifier words as "Callsite was not defined with variable
    # arguments!", which that probe recorded as a `fun` being unable to bind
    # an LLVM intrinsic at all. It can, with both arguments. An
    # `@[Primitive]` is the rejected alternative: a compiler rebuild and a
    # declaration in `primitives.iyi`, a language-surface file, for what this
    # C-shaped binding reaches. `memory.size` is not bound because
    # `memory.grow` answers the only fact it carries: its result is the
    # previous size in pages, which is exactly where the grown region
    # starts. The index argument is 0 because a wasm32-wasi module has
    # exactly one linear memory and 0 names it; the backend turns it into
    # the instruction's memarg immediate, so it is not even a runtime
    # operand.
    lib LibWasmMem
      fun memory_grow = "llvm.wasm.memory.grow.i32"(memory_index : Int32, delta_pages : Int32) : Int32
    end

    # Pages are 64 KiB. A request larger than one page rounds up to the whole
    # pages it needs and gets a region of its own; `memory.grow` answers -1
    # when the engine refuses the growth, and a failure is answered rather
    # than wrapped, because read as a page count -1 would seat the cursor
    # 64 KiB below any memory the engine ever handed out, which is heap
    # corruption wearing a success, so it takes the same write-and-exit the
    # Linux branch's failed `mmap` takes. Every size rides in the eight bytes
    # under the pointer exactly as on Linux, because `realloc` has no other
    # way to know how much to copy, and the eight bytes keep every user
    # pointer 8-aligned; grow regions are page-aligned and the bump is always
    # a multiple of 8, so the header store stays aligned too. Fresh pages are
    # zeroed by the wasm spec itself, so `__crystal_malloc64`'s documented
    # clear comes from the engine rather than a second pass over the bytes,
    # the same standing Linux's `MAP_ANONYMOUS` zero-fill has there: nothing
    # is handed out twice, so nothing can be dirtier than the engine left it,
    # and the atomic variant is the same memory for the same reason. The
    # cursor and what is left of the region are `UInt64` class variables on
    # `IyiHeap` for the Linux branch's reasons, which hold here word for
    # word: `$` globals are refused, a `fun` body cannot reach `@@` state,
    # and literal initializers fold into the LLVM global's static zero, so
    # zero means "grow on the first allocation" rather than a value startup
    # code installs. `-Dgc_iyi` does not reach this branch either, by design
    # rather than omission: wasm32 has no mmap, and its arena is a watermark
    # over linear memory, a separate design that GC_DESIGN.md's Stage 2
    # defers, so the flag keeps this allocator.
    class IyiHeap
      @@cursor : UInt64 = 0_u64
      @@left : UInt64 = 0_u64

      def self.alloc(size : UInt64) : Void*
        bytes = size.to_i64
        remainder = bytes % 8
        bytes = bytes + (8 - remainder) if remainder > 0
        bytes = bytes + 8

        if @@left < bytes.to_u64
          pages = bytes // 65536
          pages = pages + 1 if bytes % 65536 > 0
          previous = LibWasmMem.memory_grow(0, pages.to_i32)
          if previous < 0
            __iyi_write(1, "iyi: out of memory\n".to_unsafe.as(Void*), 19_u64)
            __iyi_exit(1)
          end
          @@cursor = previous.to_u64.unsafe_shl(16)
          @@left = pages.to_u64.unsafe_shl(16)
        end

        block = Pointer(Void).new(@@cursor)
        @@cursor = @@cursor + bytes.to_u64
        @@left = @@left - bytes.to_u64
        block.as(Pointer(UInt64)).value = size
        block + 8_i64
      end

      # Allocate-and-copy rather than growth in place, because nothing frees
      # and the old size rides in the eight bytes under the pointer, which is
      # the only place that knows it.
      def self.realloc(pointer : Void*, size : UInt64) : Void*
        return alloc(size) if pointer.address == 0
        old_size = Pointer(UInt64).new(pointer.address - 8).value
        new_pointer = alloc(size)
        source = pointer.as(Pointer(UInt8))
        destination = new_pointer.as(Pointer(UInt8))
        limit = old_size < size ? old_size : size
        index = 0_u64
        while index < limit
          (destination + index.to_i64).value = (source + index.to_i64).value
          index = index + 1
        end
        new_pointer
      end
    end

    # Codegen emits calls to these by name for every allocation, so they are not
    # optional and their names are not ours to choose.
    fun __crystal_malloc64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_malloc_atomic64(size : UInt64) : Void*
      IyiHeap.alloc(size)
    end

    fun __crystal_realloc64(pointer : Void*, size : UInt64) : Void*
      IyiHeap.realloc(pointer, size)
    end

    # `memset` is defined locally because codegen itself reaches for the name
    # (`pre_initialize_aggregate` and `generic_array_malloc` lower to the LLVM
    # `llvm.memset` intrinsic, which becomes a C `memset` call once the size is
    # not a constant), and wasm32's size_t is 32-bit, so the signature LLVM
    # expects here is `void(i8*, i32, i32)` rather than the 64-bit count the
    # Linux and win32 paths carry. A definition with the matching name, types
    # and return is the only thing that can intercept it. The bulk goes four
    # bytes at a time because the pointers are 4-aligned at best on wasm32;
    # the byte loop carries the tail.
    fun memset(destination : Void*, value : Int32, count : Int32) : Void*
      byte = value.to_u8!
      word = (byte.to_u64 * 0x01010101_u64).to_i32
      words = destination.as(Pointer(Int32))
      total = count.to_i64.to_u64
      filled = 0_u64
      while filled + 4_u64 <= total
        words.value = word
        words = words + 1_i64
        filled = filled + 4_u64
      end
      bytes = words.as(Pointer(UInt8))
      while filled < total
        bytes.value = byte
        bytes = bytes + 1_i64
        filled = filled + 1_u64
      end
      destination
    end
  {% else %}
    {% raise "iyi: this target has no allocator binding in iyi's prelude. " \
             "Teach src/iyi/prelude.iyi a branch for this platform rather than " \
             "linking something absent." %}
  {% end %}
{% end %}

{% if flag?(:arm) || flag?(:wasm32) %}
  # `__multi3` is compiler-rt's 128-bit multiply helper, and LLVM emits calls
  # to it behind the program's back: on a 32-bit target a checked 64-bit
  # multiply legalizes by widening to an `i128` multiply, and neither arm nor
  # wasm32 has that instruction, so the multiply becomes a call to `__multi3`.
  # This prelude has two such multiplies on the wasm32 path alone — `memset`'s
  # word pattern and `Int64#to_s`'s power-of-ten count — and measured, that
  # helper is the one compiler-rt name in the wasm32 object's undefined list.
  # The mirror of `src/crystal/compiler_rt.cr` is exact on the flag: it
  # requires `compiler_rt/multi3.cr` precisely when `flag?(:arm) ||
  # flag?(:wasm32)`, so the same gate is here, and nothing else from that
  # file is pulled in. `shift.cr` (`__ashlti3` and kin) and `pow.cr`
  # (`__powisf2`, `__powidf2`) are wasm32 needs of Int128 shifts and `**`,
  # and iyi's primitives cross Int32/Int64/UInt8/UInt64/Float64 only, so no
  # codegen path emits those calls; fixint, float, mul and divmod128 serve
  # the Int128 division and conversion surface, which the same five types
  # lower natively.
  #
  # Written out rather than required, although `src/crystal/compiler_rt/` is
  # Crystal and pulling it in costs no library: `multi3.cr` is written against
  # Crystal's full primitives — `~`, `to_i128!`, arithmetic on Int128 — which
  # this prelude's five-type surface does not carry, so the file does not
  # compile under it. The algorithm is compiler-rt's (multi3.c over mulddi3.c,
  # which Crystal's port carries); the expression of it is iyi's. The halves
  # are read out of the operands as UInt64 words through a pointer — wasm32
  # and the arm targets Crystal builds are little-endian, so word 0 is the low
  # half — because the language has no i128 arithmetic to split with. Every
  # operation below is the wrapping form, which is exactly the mod 2^64 the
  # algorithm is written in, and the signed result falls out of the two's
  # complement words with no case analysis, the same way compiler-rt's does.
  fun __multi3(a : Int128, b : Int128) : Int128
    x = a
    y = b
    x_words = pointerof(x).as(Pointer(UInt64))
    y_words = pointerof(y).as(Pointer(UInt64))
    a_low = x_words.value
    a_high = (x_words + 1_i64).value
    b_low = y_words.value
    b_high = (y_words + 1_i64).value

    # mask keeps the low 32 bits of a word.
    mask = 0xFFFFFFFF_u64

    # mulddi3: the unsigned 64x64 -> 128 product of the two low words, kept
    # as a (low, high) pair rather than packed into an Int128.
    low = (a_low & mask) &* (b_low & mask)
    t = low.unsafe_shr(32)
    low = low & mask
    t = t &+ ((a_low.unsafe_shr(32)) &* (b_low & mask))
    low = low &+ ((t & mask).unsafe_shl(32))
    high = t.unsafe_shr(32)
    t = low.unsafe_shr(32)
    low = low & mask
    t = t &+ ((b_low.unsafe_shr(32)) &* (a_low & mask))
    low = low &+ ((t & mask).unsafe_shl(32))
    high = high &+ t.unsafe_shr(32)
    high = high &+ ((a_low.unsafe_shr(32)) &* (b_low.unsafe_shr(32)))

    # multi3's own step: the high word adds the cross products, mod 2^64.
    high = high &+ (a_high &* b_low)
    high = high &+ (a_low &* b_high)

    result = uninitialized Int128
    result_words = pointerof(result).as(Pointer(UInt64))
    result_words.value = low
    (result_words + 1_i64).value = high
    result
  end
{% end %}

# Codegen emits a call to this on every overflowing operation, so a program
# cannot link without it. It aborts rather than raising: 0.1.0's `raise` is a
# panic (SPEC.md III.1.4) and there is no unwinder under it.
# Every function with an `ensure` names a personality function, so a program
# with a `defer` in it does not link without this symbol. It is not reachable:
# reaching it would mean something is unwinding, and nothing here unwinds.
fun __crystal_personality
  print "iyi: __crystal_personality called, which cannot happen\n"
  __iyi_exit(1)
end

# Reached from the same landing pad, for the same reason, and just as
# unreachable: `ensure` compiles a path that would ask the unwinder what was
# thrown, and nothing here throws.
fun __crystal_get_exception(exception : Void*) : UInt64
  print "iyi: __crystal_get_exception called, which cannot happen\n"
  __iyi_exit(1)
  0_u64
end

# Codegen emits a call to this wherever a `rescue` would re-raise. Nothing in
# this prelude can reach it either — `raise` panics rather than unwinding —
# but a program with an `ensure` in it names the symbol.
@[Raises]
fun __crystal_raise(exception : Void*) : NoReturn
  print "iyi: __crystal_raise called, which cannot happen\n"
  __iyi_exit(1)
end

# Codegen emits a call to this on every overflowing checked operation.
# It is a `fun` — the name is the ABI — but the body just steps into the
# ordinary panic def, so an overflow in a task dies at the task
# boundary like any other bug instead of taking the process (III.1.4).
fun __crystal_raise_overflow : NoReturn
  raise "arithmetic overflow"
end

struct Pointer(T)
  def [](offset : Int32) : T
    (self + offset.to_i64).value
  end

  def []=(offset : Int32, value : T) : T
    (self + offset.to_i64).value = value
  end

  # Bytes, not elements: every caller here is copying string contents.
  def copy_from(source : Pointer(T), count : Int32) : Nil
    index = 0
    while index < count
      self[index] = source[index]
      index = index + 1
    end
  end
end

# ── Panics — SPEC.md III.1.4, built ───────────────────────────────────
#
# A panic is for bugs, not control flow, and it unwinds without an
# unwinder: `defer` registers its cleanup on the way in (the normalizer
# emits `__iyi_defer_push`/`__iyi_defer_pop_run` around every deferred
# scope), so the panic path *walks a list* instead of walking frames —
# the whole Itanium machinery stays unlinked and the dependency floor
# stays where it is.
#
# On the concurrency targets the registry lives on the current fiber and
# a panicking task dies alone: its defers run, its group is told, its
# siblings are cancelled, and the group's join re-panics in the owner —
# a panicking fiber cannot die silently (III.1.4), and an uncaught panic
# still reaches main and exits 1, after every defer on the path ran.
# Elsewhere there are no tasks, so the registry is one global stack and
# a panic is a clean exit that ran the pending cleanups first.

# One registered cleanup. A class rather than a struct: the stack is an
# intrusive linked list, and a node must be a reference to link.
class IyiDeferNode
  @proc : Proc(Nil)
  property next_node : IyiDeferNode?

  def initialize(@proc : Proc(Nil))
    @next_node = nil
  end

  def run : Nil
    @proc.call
  end
end

{% unless (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
  # No fibers on this target, so one global stack is exact: a single
  # thread of control pushes and pops in strict block-nesting order.
  class IyiDefers
    @@head : IyiDeferNode?

    def self.push(node : IyiDeferNode) : Nil
      node.next_node = @@head
      @@head = node
    end

    def self.pop_run : Nil
      node = @@head
      return unless node.is_a?(IyiDeferNode)
      @@head = node.next_node
      node.run
    end

    def self.drain : Nil
      while true
        node = @@head
        return unless node.is_a?(IyiDeferNode)
        @@head = node.next_node
        node.run
      end
    end
  end

  def __iyi_defer_push(cleanup : Proc(Nil)) : Nil
    IyiDefers.push(IyiDeferNode.new(cleanup))
  end

  def __iyi_defer_pop_run : Nil
    IyiDefers.pop_run
  end
{% end %}

# `raise` is a panic. It prints once, at the point of the bug, then
# unwinds by registry: pending defers run innermost-first, and on the
# concurrency targets the current *task* dies rather than the process —
# the group boundary re-raises in the owner, which is where III.1.4
# says a panic is caught. `NoReturn` is a type-system fact `.or_panic`
# depends on (III.1.3): the fiber never resumes.
def raise(message : String) : NoReturn
  print "iyi: panic: "
  print message
  print "\n"
  {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
    IyiScheduler.panic_current(message)
  {% else %}
    IyiDefers.drain
    __iyi_exit(1)
  {% end %}
end

# What a failed `.as` names. `.as` reaches an iyi program through one door
# only — `select`'s expansion casts the winning arm's value — and a failed
# cast there is a compiler bug, so this is a panic wearing the constant's
# name, not an exception type.
class TypeCastError
  @message : String

  def initialize(@message : String)
  end

  def message : String
    @message
  end
end

def raise(error : TypeCastError) : NoReturn
  raise error.message
end

def print(text : String) : Nil
  __iyi_write(1, text.to_unsafe.as(Void*), text.bytesize.to_u64)
end

def print(value) : Nil
  print value.to_s
end

def puts(text : String) : Nil
  print text
  print "\n"
end

# Everything on standard input, asked for by `samples/iyi/calc`: a program that
# only runs the source built into it is a demonstration, and one that reads is
# a tool.
#
# All of it rather than a line at a time, and that is the honest shape of what
# this prelude can do — `gets` in Crystal's library returns one line and keeps
# the rest in a buffered `IO`, and there is no `IO` here to keep it in. A name
# that means less than Crystal's would be worse than a different name, so this
# one is its own (SPEC.md III.1.7a is the same rule from the other side).
def read_input : String
  chunk = 8192_u64
  buffer = Pointer(UInt8).malloc(chunk)
  filled = 0_i64
  capacity = chunk

  while true
    if filled.to_u64 == capacity
      capacity = capacity * 2_u64
      buffer = buffer.realloc(capacity)
    end

    count = 0_i64
    # On the concurrency targets the read parks the fiber rather than the
    # thread: III.4.8 named this exact call as the one that had to stop
    # being a direct blocking syscall once a poller existed. A fiber
    # reading stdin no longer stalls its siblings; a program with no
    # other fiber blocks in `epoll_pwait` (`kevent` on darwin) instead of
    # `read`, which is the same wait. `Cancelled` ends the read the way
    # EOF does — a cancelled task wants out, and what was read so far is
    # still the honest answer.
    {% if (flag?(:linux) && (flag?(:x86_64) || flag?(:aarch64))) || (flag?(:darwin) && flag?(:aarch64)) %}
      outcome = iyi_read(0, (buffer + filled).as(Void*), capacity - filled.to_u64)
      break unless outcome.is_a?(Int64)
      count = outcome
    {% else %}
      count = __iyi_read(0, (buffer + filled).as(Void*), capacity - filled.to_u64)
    {% end %}
    break if count <= 0_i64
    filled = filled + count
  end

  String.new(filled.to_i) do |target|
    target.copy_from(buffer, filled.to_i)
  end
end

def puts(value) : Nil
  puts value.to_s
end

# The program's own name-plate: arguments and environment, read on
# demand from what already exists — no captured state, no boot order to
# get wrong. `ARGC_UNSAFE`/`ARGV_UNSAFE` are the compiler's predefined
# constants, initialised from `main`'s own parameters before anything
# else runs (codegen/const.cr); `environ` is the C runtime's exported
# global. A first draft captured argv in class variables from `main` and
# read zeros: `__crystal_main` runs the class-variable initialisers
# *after* `main`'s prologue stored, wiping it — symbols do not have that
# ordering problem.
#
# On wasm32 there is no environment to read and `env` answers nil for
# every name: the sandbox story (SPEC.md III.12) is that the runtime
# hands the program nothing, and an absent surface beats a permission.
{% unless flag?(:wasm32) %}
  lib LibIyiEnv
    $environ : UInt8**
  end
{% end %}

class Program
  # The arguments after the program's own name, the way every shell
  # hands them over.
  def self.args : Array(String)
    result = [] of String
    index = 1
    while index < ARGC_UNSAFE
      result << string_from(ARGV_UNSAFE[index])
      index = index + 1
    end
    result
  end

  # One variable, or nil. No map of everything: the asking program names
  # what it wants, and a tool that dumps its whole environment into a
  # structure was one `puts` away from leaking it.
  def self.env(name : String) : String | Nil
    {% if flag?(:wasm32) %}
      nil
    {% else %}
      pointer = LibIyiEnv.environ
      return nil if pointer.address == 0_u64

      length = name.bytesize
      bytes = name.to_unsafe
      index = 0
      while (entry = pointer[index]).address != 0_u64
        offset = 0
        while offset < length && entry[offset] == bytes[offset]
          offset = offset + 1
        end
        # 61 is '=': the byte that ends the name in `NAME=value`.
        if offset == length && entry[length] == 61_u8
          return string_from(entry + (length + 1))
        end
        index = index + 1
      end
      nil
    {% end %}
  end

  private def self.string_from(entry : UInt8*) : String
    length = 0
    while entry[length] != 0_u8
      length = length + 1
    end
    String.new(length) do |target|
      target.copy_from(entry, length)
    end
  end
end

lib LibCrystalMain
  @[Raises]
  fun __crystal_main(argc : Int32, argv : UInt8**)
end

fun main(argc : Int32, argv : UInt8**) : Int32
  # There is nothing to start under the default allocator, and nothing missing
  # either: `gc/none.cr`'s `GC.init` sets up thread suspend and resume, and
  # 0.1.0 has one thread. Only Boehm has an `init` worth calling.
  {% if flag?(:gc_boehm) %}
    LibGC.init
  {% end %}
  LibCrystalMain.__crystal_main(argc, argv)
  0
end

{% if flag?(:wasm32) %}
  # iyi: wasi-libc's `crt1-command.o` is what exports `_start`, and what it
  # calls is not `main`. Clang renames a C `main` to `__main_argc_argv` or
  # `__main_void` depending on its parameters, and the entry stub calls that
  # name; `main` itself is left as a weak undefined reference, so a module that
  # only defines `main` links without complaint and traps on `unreachable` the
  # moment the entry calls through it.
  #
  # Defining the name the entry actually calls is the whole fix. It is declared
  # here rather than emitted by codegen because the prelude is where this
  # platform's contract already lives, and because `main` above stays exactly as
  # it is for every other target.
  fun __main_argc_argv(argc : Int32, argv : UInt8**) : Int32
    LibCrystalMain.__crystal_main(argc, argv)
    0
  end
{% end %}
