# Text — SPEC.md, "0.1.0", item 3.
#
# The compiler declares `String`'s fields itself — `@bytesize`, `@length` and
# `@c`, in that order, in `Program#initialize` — because codegen lays out
# string literals before any prelude is read. So this file reopens a type that
# already has its shape and only says what can be done with it.
class String
  # The two `Int32`s in front of the bytes: the byte count and the character
  # count. The type id is not in the object: it is the high half of the
  # header word under it, at P-4, where every object carries it (GC_DESIGN.md
  # Stage 5). Written by hand because that layout is codegen's, and a string
  # built here has to be indistinguishable from one it emitted.
  HEADER_SIZE = 8

  # Allocates *bytesize* bytes, hands the buffer to the block to fill, and
  # returns the string that results. The character count is scanned rather
  # than asked for: a caller that knew it would have to be trusted, and every
  # caller here is copying bytes it did not decode.
  def self.new(bytesize : Int32, & : Pointer(UInt8) -> Nil) : String
    memory = Pointer(UInt8).malloc((bytesize + HEADER_SIZE + 1).to_u64)
    buffer = memory + HEADER_SIZE
    yield buffer

    Pointer(Int32).new(memory.address - 4_u64).value = "".crystal_type_id
    header = memory.as(Pointer(Int32))
    header[0] = bytesize
    header[1] = character_count(buffer, bytesize)
    memory.as(String)
  end

  # UTF-8 continuation bytes are `10xxxxxx`; every other byte starts a
  # character. That is the whole of the decoding this prelude does.
  protected def self.character_count(buffer : Pointer(UInt8), bytesize : Int32) : Int32
    count = 0
    index = 0
    while index < bytesize
      count = count + 1 if (buffer[index] & 192_u8) != 128_u8
      index = index + 1
    end
    count
  end

  def bytesize : Int32
    @bytesize
  end

  # Crystal reads `@length == 0` on a non-empty string as "not counted yet" and
  # scans; a string it builds without knowing the count leaves the field at
  # zero. This prelude used to return the field, which was right for every
  # string it makes itself and wrong for one that arrived from Crystal's own
  # code — `to_json`'s result printed correctly here and answered `size` 0.
  #
  # No error, a wrong number, and the layout is shared on purpose (SPEC.md
  # Part V item 12), so the invariant has to be shared too.
  def size : Int32
    return @length if @length > 0 || @bytesize == 0

    @length = String.character_count(to_unsafe, @bytesize)
    @length
  end

  def empty? : Bool
    @bytesize == 0
  end

  # The character at *index*, and the substring that starts there, asked for by
  # `samples/iyi/calc`, which scans its input a character at a time and cannot
  # do it with `to_unsafe` without becoming a program about pointers.
  #
  # ASCII, like the rest of this file: a byte is a character here, which is true
  # of every string this prelude is asked to handle and false in general. The
  # place it stops being true is the place to make `Char` real, and `size`
  # already counts UTF-8 properly, so the two would disagree, noted rather than
  # hidden.
  #
  # A negative index counts from the end, so `s[-1]` is the last character.
  # Out of range after that wrap still raises rather than returning nil: the
  # caller knows the length. `[]?` is the question that allows absence.
  def [](index : Int32) : Char
    index = @bytesize + index if index < 0
    raise "index out of range" if index < 0 || index >= @bytesize
    to_unsafe[index].unsafe_chr
  end

  def []?(index : Int32) : Char?
    index = @bytesize + index if index < 0
    return nil if index < 0 || index >= @bytesize
    to_unsafe[index].unsafe_chr
  end

  # A negative *start* counts from the end, the same wrap as the one-index
  # form. *count* stays non-negative: a negative count is not a wrap, it is a
  # mistake, and it raises for that reason rather than being silently clamped.
  def [](start : Int32, count : Int32) : String
    raise "negative count" if count < 0
    start = @bytesize + start if start < 0
    raise "index out of range" if start < 0 || start > @bytesize

    available = @bytesize - start
    taken = count < available ? count : available

    String.new(taken) do |buffer|
      buffer.copy_from(to_unsafe + start, taken)
    end
  end

  # Pad on the left (rjust) or the right (ljust) to *width* bytes. The pad is
  # one ASCII byte, like the rest of this file. A width that already fits
  # returns the string unchanged.
  def rjust(width : Int32, pad : Char) : String
    return self if width <= @bytesize
    extra = width - @bytesize
    pad_byte = pad.ord.to_u8
    String.new(width) do |buffer|
      i = 0
      while i < extra
        buffer[i] = pad_byte
        i = i + 1
      end
      (buffer + extra).copy_from(to_unsafe, @bytesize)
    end
  end

  def rjust(width : Int32) : String
    rjust(width, ' ')
  end

  def ljust(width : Int32, pad : Char) : String
    return self if width <= @bytesize
    extra = width - @bytesize
    pad_byte = pad.ord.to_u8
    String.new(width) do |buffer|
      buffer.copy_from(to_unsafe, @bytesize)
      i = @bytesize
      while i < width
        buffer[i] = pad_byte
        i = i + 1
      end
    end
  end

  def ljust(width : Int32) : String
    ljust(width, ' ')
  end

  def *(count : Int32) : String
    return "" if count <= 0 || @bytesize == 0
    total = @bytesize * count
    String.new(total) do |buffer|
      i = 0
      while i < count
        (buffer + i * @bytesize).copy_from(to_unsafe, @bytesize)
        i = i + 1
      end
    end
  end

  def to_unsafe : Pointer(UInt8)
    pointerof(@c)
  end

  def to_s : String
    self
  end

  # The number this string spells, asked for by `samples/iyi/calc`, which reads
  # a token's text and needs the integer behind it.
  #
  # Raises on anything that is not a number, which is what Crystal's `to_i`
  # does — the same name has to mean the same thing in both libraries
  # (SPEC.md III.1.7a), and a silent 0 for `"oops"` is the kind of answer that
  # is wrong twice.
  def to_i : Int32
    raise "not a number" if empty?

    index = 0
    sign = 1
    if self[0] == '-'
      raise "not a number" if @bytesize == 1
      sign = -1
      index = 1
    end

    value = 0
    while index < @bytesize
      digit = to_unsafe[index].to_i - 48
      raise "not a number" if digit < 0 || digit > 9
      value = value * 10 + digit
      index = index + 1
    end

    value * sign
  end

  def +(other : String) : String
    return other if empty?
    return self if other.empty?

    String.new(bytesize + other.bytesize) do |buffer|
      buffer.copy_from(to_unsafe, bytesize)
      (buffer + bytesize).copy_from(other.to_unsafe, other.bytesize)
    end
  end

  # The three the Kemal port's path joining needs. ASCII again — a `Char`
  # argument here is always `\'/\'` — and byte-indexed, which is the same
  # thing while the strings are ASCII.
  def starts_with?(prefix : String) : Bool
    return false if prefix.bytesize > bytesize

    index = 0
    while index < prefix.bytesize
      return false unless to_unsafe[index] == prefix.to_unsafe[index]
      index = index + 1
    end
    true
  end

  def starts_with?(char : Char) : Bool
    bytesize > 0 && to_unsafe[0] == char.ord.to_u8
  end

  def chomp(char : Char) : String
    return self if bytesize == 0 || to_unsafe[bytesize - 1] != char.ord.to_u8
    byte_slice(0, bytesize - 1)
  end

  def lchop(char : Char) : String
    return self unless starts_with?(char)
    byte_slice(1, bytesize - 1)
  end

  private def byte_slice(start : Int32, count : Int32) : String
    String.new(count) do |buffer|
      buffer.copy_from(to_unsafe + start, count)
    end
  end

  # FNV-1a over the bytes: three lines, no table, and good enough for a
  # linear-probing table of a few dozen entries.
  def hash : Int32
    value = -2128831035
    index = 0
    while index < bytesize
      value = (value ^ to_unsafe[index].to_i32) &* 16777619
      index = index + 1
    end
    value
  end

  # ASCII only, and the samples are ASCII. A prelude that folded case for
  # every alphabet would be a Unicode table, which is more lines than this
  # whole file and not what any sample is about.
  def upcase : String
    String.new(bytesize) do |buffer|
      index = 0
      while index < bytesize
        byte = to_unsafe[index]
        byte = byte - 32_u8 if byte >= 97_u8 && byte <= 122_u8
        buffer[index] = byte
        index = index + 1
      end
    end
  end

  # The other half of `upcase`, ASCII for the same reason.
  def downcase : String
    String.new(bytesize) do |buffer|
      index = 0
      while index < bytesize
        byte = to_unsafe[index]
        byte = byte + 32_u8 if byte >= 65_u8 && byte <= 90_u8
        buffer[index] = byte
        index = index + 1
      end
    end
  end

  # Substring search, the naive way: the strings a sample holds are short
  # enough that the loop is the answer and an index would be the question.
  def includes?(other : String) : Bool
    return true if other.bytesize == 0
    return false if other.bytesize > bytesize

    start = 0
    limit = bytesize - other.bytesize
    while start <= limit
      index = 0
      while index < other.bytesize && to_unsafe[start + index] == other.to_unsafe[index]
        index = index + 1
      end
      return true if index == other.bytesize
      start = start + 1
    end
    false
  end

  def ==(other : String) : Bool
    return false unless bytesize == other.bytesize

    index = 0
    while index < bytesize
      return false unless to_unsafe[index] == other.to_unsafe[index]
      index = index + 1
    end
    true
  end

  # Interpolation is a call the compiler writes: `"a#{b}"` reaches here as
  # `String.interpolation("a", b)` (`LiteralExpander#expand`). The overloads
  # are what let the common shapes avoid work — a single string is itself.
  def self.interpolation(value : String) : String
    value
  end

  def self.interpolation(value) : String
    value.to_s
  end

  def self.interpolation(*values : *T) : String forall T
    result = ""
    {% for index in 0...T.size %}
      result = result + interpolation(values[{{ index }}])
    {% end %}
    result
  end
end

# `Char`'s own, and it lives here rather than in `primitives.iyi` because the
# one-byte string it builds needs `String.new`.
#
# Without it `puts s[0]` printed the text `Char`: `Object#to_s` answers with the
# type's name, so a type that never defined `to_s` prints its own name instead
# of its value and nothing says a method is missing. `samples/iyi/calc` scans
# with `String#[]` and compares the result, which is why nothing caught it —
# comparison was defined and printing was not.
#
# ASCII, on the same terms as the rest of this file: a `Char` here came out of a
# byte and goes back as one.
struct Char
  def to_s : String
    String.new(1) do |buffer|
      buffer[0] = ord.to_u8
    end
  end

  def inspect : String
    "'" + to_s + "'"
  end
end
