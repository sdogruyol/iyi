# iyi's concurrency runtime — SPEC.md III.4, built in the order III.4.8
# settled: a scheduler, cancellable blocking primitives, then `group` and
# `Channel`. Nothing here is a thread: one kernel thread runs every fiber,
# and what makes that concurrency rather than sequence is the poller — a
# fiber that would block parks itself and the scheduler runs another, so two
# tasks' waits overlap even though their instructions never do.
#
# The public surface, and it is deliberately all of it:
#
#   group do |g|              # III.4.1: concurrency is introduced by a scope
#     t = g.spawn { work() }  # a task; no bare spawn exists
#   end                       # the block cannot be left until every task is done
#   t.value                   # joins, then answers what the block returned
#   sleep(ms)                 # Nil | Cancelled
#   wait_readable(fd)         # Nil | Cancelled — the poller, made visible
#   iyi_read(fd, buf, n)      # Int64 | Cancelled — a read that parks, not blocks
#   Channel(T).new            # a rendezvous; .new(n) buffers n sends first
#   select / when / else      # over any mix of arms; the expansion's
#                             # library half is at the bottom of this file
#
# Cancellation (III.4.2) belongs to the group: the first task whose value is
# an error member cancels its siblings. A cancelled fiber is not torn down —
# nothing here unwinds — it is *woken*, and every blocking primitive answers
# `Cancelled` from then on. A task written with `!` therefore drains out of
# its own accord, which is III.1.2 doing cancellation's plumbing for free.
#
# What is deliberately absent, so nobody reads silence as an accident:
# `Share` (III.4.4) gates nothing until a second thread exists, because one
# thread interleaves at parks only and cannot race; and the typed
# `group do ... end!` return (III.4.1's final shape) is compiler work this
# runtime has to exist before anyone can build. Panics at task boundaries
# (III.1.4) are built and live at the bottom of the scheduler: a panicking
# task drains its defers, tells its group, and dies alone.
#
# Linux and darwin arm64, through each platform's own doorway: raw
# syscalls on Linux, libSystem on darwin, because Apple documents raw
# syscalls as explicitly not a stable ABI there (SPEC.md III.9). Either
# way the dependency floor named pthreads as the cost that must not be
# paid, and a fiber is exactly the thing that makes it unnecessary. The
# remaining platforms lose nothing they had: a program that names `group`
# on wasm32 fails to compile, which is honest — III.4.8 refused shipping
# a spelling without the feature.

# ── The switch ─────────────────────────────────────────────────────────
#
# A suspended context is one word: its stack pointer. Everything else the
# fiber will need is on the stack that pointer names, put there by the
# push half of the swap. Caller-saved registers are not saved and do not
# need to be: this is a call, and the convention already says a caller
# keeps nothing live in them across one.
#
# `@[Naked]` because the prologue of an ordinary function would move the
# very stack pointer being saved; `@[NoInline]` because an optimised build
# otherwise inlines the body and the push/ret discipline corrupts the
# caller — measured, not feared: the release build faulted until it said so.
@[NoInline]
@[Naked]
fun __iyi_ctx_swap(current : Pointer(UInt64), target : Pointer(UInt64)) : Nil
  {% if flag?(:x86_64) %}
    asm("pushq %rdi
         pushq %rbx
         pushq %rbp
         pushq %r12
         pushq %r13
         pushq %r14
         pushq %r15
         movq %rsp, (%rdi)
         movq (%rsi), %rsp
         popq %r15
         popq %r14
         popq %r13
         popq %r12
         popq %rbp
         popq %rbx
         popq %rdi
         retq" :::: "volatile")
  {% else %}
    asm("stp x19, x20, [sp, #-160]!
         stp x21, x22, [sp, #16]
         stp x23, x24, [sp, #32]
         stp x25, x26, [sp, #48]
         stp x27, x28, [sp, #64]
         stp x29, x30, [sp, #80]
         stp d8, d9, [sp, #96]
         stp d10, d11, [sp, #112]
         stp d12, d13, [sp, #128]
         stp d14, d15, [sp, #144]
         mov x2, sp
         str x2, [x0]
         ldr x2, [x1]
         mov sp, x2
         ldp x21, x22, [sp, #16]
         ldp x23, x24, [sp, #32]
         ldp x25, x26, [sp, #48]
         ldp x27, x28, [sp, #64]
         ldp x29, x30, [sp, #80]
         ldp d8, d9, [sp, #96]
         ldp d10, d11, [sp, #112]
         ldp d12, d13, [sp, #128]
         ldp d14, d15, [sp, #144]
         ldp x19, x20, [sp], #160
         ret" :::: "volatile")
  {% end %}
end

# Where a fresh fiber's first resume lands. No argument crosses the swap:
# the fiber to run is `IyiScheduler.current`, set by the switch that got
# here, so the two targets never have to agree on which register survives.
fun __iyi_fiber_main : Nil
  IyiScheduler.run_spawned_fiber
end

# The trampoline's address, taken by asm because a proc literal of a `fun`
# is not a thing an iyi file can write.
@[NoInline]
@[Naked]
fun __iyi_fiber_entry_address : UInt64
  {% if flag?(:x86_64) %}
    asm("leaq __iyi_fiber_main(%rip), %rax
         retq" :::: "volatile")
  {% elsif flag?(:darwin) %}
    # Mach-O spells the relocation pair @PAGE/@PAGEOFF where ELF says
    # :lo12:, and prefixes every C-level name with an underscore.
    asm("adrp x0, ___iyi_fiber_main@PAGE
         add x0, x0, ___iyi_fiber_main@PAGEOFF
         ret" :::: "volatile")
  {% else %}
    asm("adrp x0, __iyi_fiber_main
         add x0, x0, :lo12:__iyi_fiber_main
         ret" :::: "volatile")
  {% end %}
  0_u64
end

# ── The poller's syscalls ──────────────────────────────────────────────
#
# On Linux they are raw, like every other syscall in this prelude, and
# for the same III.9 reason. The numbers are the two targets' own;
# `epoll_pwait` rather than `epoll_wait` because aarch64 only has the
# former, and with a null sigmask they are the same call. On darwin the
# same operations are libSystem calls — Apple's raw-syscall ABI is
# explicitly not stable — and the poller is a kqueue, so the constants
# there describe the 32-byte `kevent` struct rather than a syscall table.
#
# The numbers live in top-level constants because a local born inside a
# `{% if %}` dies at its `{% end %}`: a macro expansion is re-parsed, and
# only declarations cross back out of one.
{% if flag?(:darwin) %}
  # A kevent's fd is its first field (`ident`), so the data offset is 0.
  IYI_POLL_DATA_OFFSET =  0_u64
  IYI_POLL_EVENT_BYTES = 32_i64
{% elsif flag?(:x86_64) %}
  IYI_SYS_MMAP          =   9_i64
  IYI_SYS_MPROTECT      =  10_i64
  IYI_SYS_CLOCK_GETTIME = 228_i64
  IYI_SYS_EPOLL_CTL     = 233_i64
  IYI_SYS_EPOLL_PWAIT   = 281_i64
  IYI_SYS_EPOLL_CREATE1 = 291_i64
  # The kernel packs epoll_event on x86_64: data sits at +4 of a 12-byte
  # struct. On aarch64 it is aligned: +8 of 16.
  IYI_POLL_DATA_OFFSET =  4_u64
  IYI_POLL_EVENT_BYTES = 12_i64
{% else %}
  IYI_SYS_MMAP          = 222_i64
  IYI_SYS_MPROTECT      = 226_i64
  IYI_SYS_CLOCK_GETTIME = 113_i64
  IYI_SYS_EPOLL_CTL     =  21_i64
  IYI_SYS_EPOLL_PWAIT   =  22_i64
  IYI_SYS_EPOLL_CREATE1 =  20_i64
  IYI_POLL_DATA_OFFSET  =   8_u64
  IYI_POLL_EVENT_BYTES  =  16_i64
{% end %}

{% if flag?(:darwin) %}
  # libSystem, reopened for the five calls the runtime makes. `__error`
  # is how darwin spells errno's address; the poller needs it to tell
  # EINTR from a real failure, because a library call answers -1 where a
  # raw syscall answers -errno.
  lib LibC
    fun mmap(addr : Void*, len : UInt64, prot : Int32, flags : Int32, fd : Int32, offset : Int64) : Void*
    fun mprotect(addr : Void*, len : UInt64, prot : Int32) : Int32
    fun kqueue : Int32
    fun kevent(kq : Int32, changelist : Void*, nchanges : Int32, eventlist : Void*, nevents : Int32, timeout : Void*) : Int32
    fun clock_gettime_nsec_np(clock_id : Int32) : UInt64
    fun error_location = __error : Int32*
  end

  # One kevent change, packed by hand for the reason the epoll_event is:
  # the prelude has no Int16 or UInt32 to declare the struct's middle
  # fields with. Bytes 8..15 hold filter (-1 = EVFILT_READ), flags and
  # fflags, which as one little-endian word are 0x1FFFF for EV_ADD and
  # 0x2FFFF for EV_DELETE; `data` and `udata` are zeroed explicitly so
  # no byte of the struct rides on what malloc left behind.
  def __iyi_kevent_change(fd : Int32, word : UInt64) : Pointer(UInt8)
    change = Pointer(UInt8).malloc(32_u64)
    change.as(Pointer(UInt64)).value = fd.to_u64
    Pointer(UInt64).new(change.address + 8_u64).value = word
    Pointer(UInt64).new(change.address + 16_u64).value = 0_u64
    Pointer(UInt64).new(change.address + 24_u64).value = 0_u64
    change
  end
{% else %}
  fun __iyi_conc_syscall3(number : Int64, a : Int64, b : Int64, c : Int64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end

  fun __iyi_conc_syscall6(number : Int64, a : Int64, b : Int64, c : Int64, d : Int64, e : Int64, f : Int64) : Int64
    result = uninitialized Int64
    {% if flag?(:x86_64) %}
      asm("syscall" : "={rax}"(result)
                    : "{rax}"(number), "{rdi}"(a), "{rsi}"(b), "{rdx}"(c), "{r10}"(d), "{r8}"(e), "{r9}"(f)
                    : "rcx", "r11", "memory"
                    : "volatile")
    {% else %}
      asm("svc #0" : "={x0}"(result)
                   : "{x8}"(number), "{x0}"(a), "{x1}"(b), "{x2}"(c), "{x3}"(d), "{x4}"(e), "{x5}"(f)
                   : "memory"
                   : "volatile")
    {% end %}
    result
  end
{% end %}
# CLOCK_MONOTONIC, in nanoseconds. The sleep queue's clock; never the
# wall. darwin's libSystem has the one-call form, and 6 is its
# CLOCK_MONOTONIC.
def __iyi_monotonic_ns : Int64
  {% if flag?(:darwin) %}
    LibC.clock_gettime_nsec_np(6).to_i64
  {% else %}
    spec = Pointer(UInt64).malloc(2_u64)
    result = __iyi_conc_syscall3(IYI_SYS_CLOCK_GETTIME, 1_i64, spec.address.to_i64, 0_i64)
    raise "clock_gettime failed" if result < 0
    spec[0].to_i64 * 1000000000_i64 + spec[1].to_i64
  {% end %}
end

# ── The error members cancellation and closing answer with ─────────────
#
# Ordinary error members (III.1.1): a blocking primitive that cannot give
# a value gives one of these, `!` propagates it, `case` handles it. That a
# *cancelled* wait is an error value rather than an unwound stack is the
# design's whole answer to III.4.2 — and panics (III.1.4) landing did not
# change it: cancellation is control flow, a panic is a bug.
pub struct Cancelled
  def initialize
  end
end

impl Error for Cancelled
  def message : String
    "cancelled"
  end
end

# What a *caught* panic answers as — III.1.4's "catchable at task
# boundaries", made literal: reading a panicked task's value delivers
# this instead of a re-raise, and III.1.3's machinery (`case`, `!`,
# `.or`) handles it like any other failure. A panic nobody reads still
# re-raises at the join: observed bugs are values, unobserved bugs are
# loud.
pub struct Panicked
  getter text : String

  def initialize(@text : String)
  end
end

impl Error for Panicked
  def message : String
    text
  end
end

pub struct ChannelClosed
  def initialize
  end
end

impl Error for ChannelClosed
  def message : String
    "channel closed"
  end
end

# ── A fiber ────────────────────────────────────────────────────────────
#
# Not user-facing (III.4.6): a raw spawn is the leak III.4.1 exists to
# make unrepresentable. `IyiTask` and `group` are the only doors.
class IyiFiber
  # States. An Int32 rather than an enum, which the prelude does not have.
  #
  #   0 running    the one fiber whose instructions are executing
  #   1 runnable   in the run queue
  #   2 sleeping   in the sleep list, by deadline
  #   3 waiting io in the io list, registered with the poller
  #   4 waiting ch parked in a channel's queue
  #   5 joining    parked on another fiber's completion
  #   6 done       never scheduled again; its stack is never reused
  property state : Int32
  property cancelled : Bool

  # Panics — III.1.4. The registry `defer` pushes onto and the panic
  # path drains; the flag and message a boundary reads after the join.
  property defers : IyiDeferNode?
  property panicked : Bool
  property panic_message : String
  # Set when a handle read delivered the panic as a `Panicked` value:
  # the join stops owing a re-raise for a bug somebody observed.
  property panic_delivered : Bool

  # The group that spawned this fiber, so a panic can tell it directly:
  # the trampoline's own notification lives after `block.call`, and a
  # panicking block never returns there.
  property group : IyiGroup?

  # The saved stack pointer, meaningful only while suspended.
  @sp : UInt64

  # The spawned body. The main fiber has none.
  property proc : Proc(Nil)?

  # Intrusive links. A fiber waits on at most one thing at a time, so one
  # link per queue kind is enough, and none of them allocate on the wait
  # path except a channel's node.
  property next_run : IyiFiber?
  property next_sleep : IyiFiber?
  property next_io : IyiFiber?
  property next_child : IyiFiber?
  property joiner : IyiFiber?

  # The registry link and the stack's high end, for the collector's root
  # walk (GC_DESIGN.md Stage 3): a parked fiber's live values sit between
  # its saved stack pointer and this top, and a walk that cannot reach
  # them frees live objects. The main fiber's top stays 0 — its stack is
  # the thread's own and the root walk already knows that one's base.
  property next_fiber : IyiFiber?
  property stack_top : UInt64

  property deadline : Int64
  property wait_fd : Int32

  # Which park this fiber is suspended in, counted up at every park. A
  # channel node names the park it was made for, and a node whose nonce is
  # not the fiber's current one is a leftover — a park the fiber already
  # left through cancellation — so a wake skips it and keeps looking, and
  # nobody has to unlink a node from a queue whose type the scheduler
  # cannot see. This is also what `select` will lean on: several nodes,
  # one nonce, and the losers go stale by arithmetic.
  property park_nonce : UInt64

  # 256 KiB of stack and one guard page under it, so running off the end
  # is a fault at a page rather than a quiet corruption of a neighbour's
  # chunk.
  STACK_BYTES = 262144_u64
  PAGE        =   4096_u64

  def initialize
    @state = 1
    @cancelled = false
    @defers = nil
    @panicked = false
    @panic_message = ""
    @panic_delivered = false
    @group = nil
    @sp = 0_u64
    @proc = nil
    @next_run = nil
    @next_sleep = nil
    @next_io = nil
    @next_child = nil
    @joiner = nil
    @deadline = 0_i64
    @wait_fd = -1
    @park_nonce = 0_u64
    @next_fiber = nil
    @stack_top = 0_u64
  end

  # The running program's own context: no stack to build, the kernel gave
  # it one, and the first switch away fills in @sp.
  def self.main : IyiFiber
    fiber = IyiFiber.new
    fiber.state = 0
    fiber
  end

  def prepare_stack : Nil
    # The runtime's own mapping (PROT_READ|PROT_WRITE = 3 on both
    # platforms), so a fiber stack exists under every allocator, Boehm
    # included, and a guard page (PROT_NONE) under it, so running off
    # the end is a fault rather than a quiet neighbour.
    # Declared before the branch, because a local born inside a
    # `{% if %}` dies at its `{% end %}` — the file's own top-level
    # constants comment says why.
    base = 0_u64
    {% if flag?(:darwin) %}
      # libSystem's mmap: MAP_PRIVATE|MAP_ANON is 0x1002 here rather
      # than Linux's 0x22, and failure is MAP_FAILED (every bit set)
      # rather than -errno.
      mapped = LibC.mmap(Pointer(Void).new(0_u64), STACK_BYTES, 3, 4098, -1, 0_i64)
      raise "fiber stack mmap failed" if mapped.address &+ 1_u64 == 0_u64
      base = mapped.address
      LibC.mprotect(Pointer(Void).new(base), PAGE, 0)
    {% else %}
      mapped = __iyi_conc_syscall6(IYI_SYS_MMAP, 0_i64, STACK_BYTES.to_i64, 3_i64, 34_i64, -1_i64, 0_i64)
      raise "fiber stack mmap failed" if mapped < 0 && mapped >= -4095
      base = mapped.to_u64
      __iyi_conc_syscall3(IYI_SYS_MPROTECT, base.to_i64, PAGE.to_i64, 0_i64)
    {% end %}
    top = base + STACK_BYTES
    @stack_top = top
    {% if flag?(:x86_64) %}
      # The first resume pops seven zeroed callee-saved slots and returns
      # into the trampoline. The entry slot is placed so the trampoline
      # begins with rsp ≡ 8 (mod 16), which is what the ABI promises a
      # function a `call` has just reached.
      entry_sp = top - 8_u64
      ret_slot = entry_sp - 8_u64
      Pointer(UInt64).new(ret_slot).value = __iyi_fiber_entry_address
      saved = ret_slot - 56_u64
      index = 0_i64
      while index < 7_i64
        (Pointer(UInt64).new(saved) + index).value = 0_u64
        index = index + 1
      end
      @sp = saved
    {% else %}
      # aarch64 keeps sp 16-aligned always; the restored x30 carries the
      # entry, and the twenty slots mirror the swap's frame exactly.
      saved = top - 160_u64
      index = 0_i64
      while index < 20_i64
        (Pointer(UInt64).new(saved) + index).value = 0_u64
        index = index + 1
      end
      Pointer(UInt64).new(saved + 88_u64).value = __iyi_fiber_entry_address
      @sp = saved
    {% end %}
  end

  def sp_slot : Pointer(UInt64)
    pointerof(@sp)
  end

  # The saved stack pointer as a value, for the root walk. Meaningful only
  # while suspended, which is the only time the walk asks.
  def saved_sp : UInt64
    @sp
  end
end

# A channel's receiver node. The node rather than the fiber carries the
# queue membership; whether it still *means* anything is the nonce's
# question, answered where fibers say (`IyiFiber#park_nonce`).
class IyiWaiter
  @fiber : IyiFiber
  @nonce : UInt64
  property next_node : IyiWaiter?

  def initialize(@fiber : IyiFiber, @nonce : UInt64)
    @next_node = nil
  end

  def fiber : IyiFiber
    @fiber
  end

  # Still the park it was made for: the fiber is channel-parked and has
  # not parked anywhere newer.
  def current? : Bool
    @fiber.state == 4 && @fiber.park_nonce == @nonce
  end
end

# A channel's sender node: the same membership plus the value being sent,
# boxed so a rendezvous can hand it over while its owner is suspended. An
# emptied box is the delivery receipt the woken sender reads; a box still
# full says the send failed — the channel closed, or the task was
# cancelled — and the value dies with the node.
class IyiSendNode(T)
  @fiber : IyiFiber
  @nonce : UInt64
  property next_node : IyiSendNode(T)?
  @box : Array(T)

  def initialize(@fiber : IyiFiber, @nonce : UInt64, value : T)
    @next_node = nil
    @box = Array(T).new(1)
    @box << value
  end

  def fiber : IyiFiber
    @fiber
  end

  def current? : Bool
    @fiber.state == 4 && @fiber.park_nonce == @nonce
  end

  def take : T
    @box.shift
  end

  def delivered? : Bool
    @box.empty?
  end
end

# ── The scheduler ──────────────────────────────────────────────────────
#
# One run queue, one sleep list, one io list, one poller fd (an epoll on
# Linux, a kqueue on darwin); every field a
# class variable with a literal initializer, which is the only global
# state the language grants (the allocator's own comment says why), and
# zero meaning "not created yet" throughout.
class IyiScheduler
  @@current : IyiFiber?
  @@run_head : IyiFiber?
  @@run_tail : IyiFiber?
  @@sleep_head : IyiFiber?
  @@io_head : IyiFiber?
  @@pollfd : Int64 = 0_i64
  @@events : UInt64 = 0_u64

  # How many ready events one poll asks for; the per-event stride is the
  # top-level IYI_POLL_EVENT_BYTES — a 32-byte kevent on darwin, an
  # epoll_event the kernel packs on x86_64 and pads on aarch64.
  EVENTS = 16_i64

  def self.current : IyiFiber
    fiber = @@current
    return fiber if fiber.is_a?(IyiFiber)
    main = IyiFiber.main
    @@current = main
    register(main)
    main
  end

  # Every fiber ever made, intrusively linked, for the collector's root
  # walk (GC_DESIGN.md Stage 3). The queues cannot serve that walk: a
  # channel-parked fiber lives in the channel's own node list, which the
  # scheduler cannot see, and a joiner hangs off the fiber it waits on.
  # One list that only grows is exact by construction, and a done fiber
  # is skipped by state rather than unlinked — its stack is never reused
  # anyway (state 6's own rule above).
  @@all_head : IyiFiber?

  def self.register(fiber : IyiFiber) : Nil
    fiber.next_fiber = @@all_head
    @@all_head = fiber
  end

  def self.first_fiber : IyiFiber?
    @@all_head
  end

  # The running fiber's stack top, 0 when it is the main fiber (or no
  # fiber exists yet): the thread stack's base is the root walk's own
  # discovery, not this file's.
  def self.current_stack_top : UInt64
    fiber = @@current
    return 0_u64 if fiber.is_a?(Nil)
    fiber.stack_top
  end

  # A channel park: the nonce that distinguishes this suspension from
  # every earlier one, so a queue node a cancellation left behind is
  # skipped by arithmetic rather than unlinked by hand. `select` parks
  # once and stamps every arm's node with the one nonce.
  def self.park(fiber : IyiFiber) : UInt64
    nonce = fiber.park_nonce + 1
    fiber.park_nonce = nonce
    fiber.state = 4
    nonce
  end

  def self.enqueue(fiber : IyiFiber) : Nil
    fiber.state = 1
    fiber.next_run = nil
    tail = @@run_tail
    if tail.is_a?(IyiFiber)
      tail.next_run = fiber
    else
      @@run_head = fiber
    end
    @@run_tail = fiber
  end

  def self.dequeue : IyiFiber?
    head = @@run_head
    return nil unless head.is_a?(IyiFiber)
    @@run_head = head.next_run
    @@run_tail = nil if @@run_head.is_a?(Nil)
    head.next_run = nil
    head
  end

  # Park the calling fiber (its state and queue membership are already
  # set) and run something else. Returns when this fiber is switched back
  # in — possibly without a switch at all, when the wait ended before
  # anything else got to run.
  def self.reschedule : Nil
    while true
      fiber = dequeue
      if fiber.is_a?(IyiFiber)
        switch_to(fiber)
        return
      end
      wait_for_events
    end
  end

  def self.switch_to(fiber : IyiFiber) : Nil
    previous = current
    fiber.state = 0
    return if fiber.sp_slot.address == previous.sp_slot.address
    @@current = fiber
    __iyi_ctx_swap(previous.sp_slot, fiber.sp_slot)
  end

  # The trampoline lands here on a fresh fiber's first resume.
  def self.run_spawned_fiber : Nil
    fiber = current
    body = fiber.proc
    body.call unless body.is_a?(Nil)
    fiber.state = 6
    joiner = fiber.joiner
    if joiner.is_a?(IyiFiber)
      fiber.joiner = nil
      enqueue(joiner)
    end
    # Never returns: a done fiber is never enqueued, so the switch away
    # is the last instruction of this stack's life.
    reschedule
    raise "a done fiber was scheduled"
  end

  # ── Blocking, and what unblocks it ───────────────────────────────────

  def self.sleep_current(ms : Int32) : Nil | Cancelled
    fiber = current
    return Cancelled.new if fiber.cancelled
    return nil if ms <= 0
    fiber.deadline = __iyi_monotonic_ns + ms.to_i64 * 1000000_i64
    fiber.state = 2
    sleep_insert(fiber)
    reschedule
    return Cancelled.new if fiber.cancelled
    nil
  end

  def self.wait_readable_current(fd : Int32) : Nil | Cancelled
    fiber = current
    return Cancelled.new if fiber.cancelled

    # One waiter per fd: the poller keys the wakeup by fd, so a second
    # fiber on the same fd would take the first one's event. Refused
    # loudly rather than raced quietly.
    scan = @@io_head
    while scan.is_a?(IyiFiber)
      raise "two fibers waiting on one fd" if scan.wait_fd == fd
      scan = scan.next_io
    end

    {% if flag?(:darwin) %}
      # EV_ADD, keyed by the fd itself. kqueue accepts a regular file
      # where epoll refuses one, but refuses the null device with EINVAL
      # (22) — measured on /dev/null and /dev/zero — and a fd kqueue
      # cannot watch is one whose read never parks. Same answer as
      # epoll's -EPERM below: "readable now" instead of dying, or a
      # program whose stdin is `< /dev/null` panics on its first wait.
      change = __iyi_kevent_change(fd, 0x1FFFF_u64)
      added = LibC.kevent(pollfd.to_i32, change.as(Void*), 1,
        Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64)).to_i64
      return nil if added < 0 && LibC.error_location.value == 22
      raise "kevent add failed" if added < 0
    {% else %}
      # EPOLL_CTL_ADD = 1, EPOLLIN = 1, data = the fd itself.
      event = Pointer(UInt8).malloc(16_u64)
      event.as(Pointer(UInt64)).value = 1_u64
      Pointer(UInt64).new(event.address + IYI_POLL_DATA_OFFSET).value = fd.to_u64
      added = __iyi_conc_syscall6(IYI_SYS_EPOLL_CTL, pollfd, 1_i64, fd.to_i64, event.address.to_i64, 0_i64, 0_i64)
      # -EPERM is epoll saying the fd is a regular file. A file never blocks
      # a read, which is exactly "readable now": answer it instead of dying,
      # or a program whose stdin is `< file` panics on its first wait.
      return nil if added == -1_i64
      raise "epoll_ctl add failed" if added < 0
    {% end %}

    fiber.wait_fd = fd
    fiber.state = 3
    fiber.next_io = @@io_head
    @@io_head = fiber
    reschedule
    return Cancelled.new if fiber.cancelled
    nil
  end

  def self.join(fiber : IyiFiber) : Nil
    while fiber.state != 6
      raise "task already has a joiner" if fiber.joiner.is_a?(IyiFiber)
      me = current
      fiber.joiner = me
      me.state = 5
      reschedule
    end
  end

  # III.4.2: cancellation reaches a *blocked* fiber. Whatever the fiber is
  # parked on, it is unparked here and its next (or current) blocking
  # primitive answers `Cancelled`.
  def self.cancel(fiber : IyiFiber) : Nil
    return if fiber.state == 6
    return if fiber.cancelled
    fiber.cancelled = true
    if fiber.state == 2
      sleep_remove(fiber)
      enqueue(fiber)
    elsif fiber.state == 3
      io_remove(fiber)
      enqueue(fiber)
    elsif fiber.state == 4
      # The channel's node is left where it is: waking bumps nothing here,
      # because the enqueue below changes the state the node's `current?`
      # reads, and every wake skips a node that is no longer current.
      enqueue(fiber)
    end
    # Running or runnable: the flag is enough. Joining (state 5) is left
    # to wake when its target finishes, which a failing group guarantees
    # by cancelling every child.
  end

  # ── The poller ───────────────────────────────────────────────────────

  def self.wait_for_events : Nil
    sleep_head = @@sleep_head
    if @@io_head.is_a?(Nil) && sleep_head.is_a?(Nil)
      raise "deadlock: every fiber is blocked and nothing can wake one"
    end

    timeout = -1_i64
    if sleep_head.is_a?(IyiFiber)
      now = __iyi_monotonic_ns
      gap = sleep_head.deadline - now
      gap = 0_i64 if gap < 0
      timeout = (gap + 999999_i64) // 1000000_i64
    end

    count = 0_i64
    {% if flag?(:darwin) %}
      # kevent's timeout is a timespec pointer and null means forever:
      # -1 becomes the null, anything else two 8-byte words. A -1 return
      # with errno EINTR (4) is a wakeup with no news, the same story
      # epoll's -EINTR tells below; anything else negative is real.
      timeout_ptr = Pointer(Void).new(0_u64)
      if timeout >= 0_i64
        spec = Pointer(UInt64).malloc(2_u64)
        spec[0] = (timeout // 1000_i64).to_u64
        spec[1] = ((timeout % 1000_i64) * 1000000_i64).to_u64
        timeout_ptr = spec.as(Void*)
      end
      count = LibC.kevent(pollfd.to_i32, Pointer(Void).new(0_u64), 0,
        Pointer(Void).new(events_buffer), EVENTS.to_i32, timeout_ptr).to_i64
      if count < 0
        raise "kevent failed" if LibC.error_location.value != 4
        count = 0_i64
      end
    {% else %}
      count = __iyi_conc_syscall6(IYI_SYS_EPOLL_PWAIT, pollfd, events_buffer.to_i64, EVENTS, timeout, 0_i64, 8_i64)
      # -EINTR (-4) is a wakeup with no news; anything else negative is real.
      raise "epoll_pwait failed" if count < 0 && count != -4_i64
    {% end %}

    index = 0_i64
    while index < count
      entry = events_buffer + (index * IYI_POLL_EVENT_BYTES).to_u64
      fd = Pointer(UInt64).new(entry + IYI_POLL_DATA_OFFSET).value.to_i64
      wake_io(fd.to_i32)
      index = index + 1
    end

    wake_expired_sleepers
  end

  def self.wake_io(fd : Int32) : Nil
    fiber = io_take(fd)
    return unless fiber.is_a?(IyiFiber)
    enqueue(fiber)
  end

  def self.wake_expired_sleepers : Nil
    now = __iyi_monotonic_ns
    while true
      head = @@sleep_head
      return unless head.is_a?(IyiFiber)
      return if head.deadline > now
      @@sleep_head = head.next_sleep
      head.next_sleep = nil
      enqueue(head)
    end
  end

  # ── Lists ────────────────────────────────────────────────────────────

  def self.sleep_insert(fiber : IyiFiber) : Nil
    head = @@sleep_head
    if head.is_a?(Nil) || head.deadline > fiber.deadline
      fiber.next_sleep = head
      @@sleep_head = fiber
      return
    end
    cursor = head
    while true
      after = cursor.next_sleep
      if after.is_a?(Nil) || after.deadline > fiber.deadline
        fiber.next_sleep = after
        cursor.next_sleep = fiber
        return
      end
      cursor = after
    end
  end

  def self.sleep_remove(fiber : IyiFiber) : Nil
    head = @@sleep_head
    return unless head.is_a?(IyiFiber)
    if head.sp_slot.address == fiber.sp_slot.address
      @@sleep_head = head.next_sleep
      fiber.next_sleep = nil
      return
    end
    cursor = head
    while true
      after = cursor.next_sleep
      return unless after.is_a?(IyiFiber)
      if after.sp_slot.address == fiber.sp_slot.address
        cursor.next_sleep = after.next_sleep
        fiber.next_sleep = nil
        return
      end
      cursor = after
    end
  end

  def self.io_take(fd : Int32) : IyiFiber?
    head = @@io_head
    return nil unless head.is_a?(IyiFiber)
    if head.wait_fd == fd
      @@io_head = head.next_io
      io_forget(head)
      return head
    end
    cursor = head
    while true
      after = cursor.next_io
      return nil unless after.is_a?(IyiFiber)
      if after.wait_fd == fd
        cursor.next_io = after.next_io
        io_forget(after)
        return after
      end
      cursor = after
    end
  end

  def self.io_remove(fiber : IyiFiber) : Nil
    io_take(fiber.wait_fd)
  end

  # Deregistered on every exit from the io list — wake and cancel both —
  # so a level-triggered fd cannot wake a fiber that no longer exists to
  # want it. EPOLL_CTL_DEL = 2 on Linux; EV_DELETE's packed word on
  # darwin, where a fd already gone is kevent's problem and not ours.
  def self.io_forget(fiber : IyiFiber) : Nil
    {% if flag?(:darwin) %}
      change = __iyi_kevent_change(fiber.wait_fd, 0x2FFFF_u64)
      LibC.kevent(pollfd.to_i32, change.as(Void*), 1,
        Pointer(Void).new(0_u64), 0, Pointer(Void).new(0_u64))
    {% else %}
      __iyi_conc_syscall6(IYI_SYS_EPOLL_CTL, pollfd, 2_i64, fiber.wait_fd.to_i64, 0_i64, 0_i64, 0_i64)
    {% end %}
    fiber.next_io = nil
    fiber.wait_fd = -1
  end

  # ── The poller's fd, lazily ──────────────────────────────────────────

  def self.pollfd : Int64
    fd = @@pollfd
    return fd if fd > 0
    {% if flag?(:darwin) %}
      fd = LibC.kqueue.to_i64
      raise "kqueue failed" if fd < 0
    {% else %}
      fd = __iyi_conc_syscall3(IYI_SYS_EPOLL_CREATE1, 0_i64, 0_i64, 0_i64)
      raise "epoll_create1 failed" if fd < 0
    {% end %}
    @@pollfd = fd
    fd
  end

  def self.events_buffer : UInt64
    buffer = @@events
    return buffer if buffer > 0
    buffer = Pointer(UInt8).malloc((EVENTS * IYI_POLL_EVENT_BYTES).to_u64).address
    @@events = buffer
    buffer
  end

  # ── Panics — III.1.4 ─────────────────────────────────────────────────

  # The panic path: run the current fiber's pending defers innermost
  # first, then die at the task boundary. A spawned task marks itself,
  # tells its group, wakes its joiner and is never scheduled again; the
  # main fiber has no boundary above it, so after its drain the process
  # exits 1. Every registered cleanup on the path has run either way,
  # which is the promise `defer` makes.
  def self.panic_current(message : String) : NoReturn
    fiber = current
    # Marked before the drain: a boundary the drain itself reaches — a
    # deferred `g.join`, above all — must see that its owner is already
    # dying and keep quiet rather than re-raise into the unwind.
    fiber.panicked = true
    fiber.panic_message = message

    while true
      node = fiber.defers
      break unless node.is_a?(IyiDeferNode)
      fiber.defers = node.next_node
      node.run
    end

    body = fiber.proc
    if body.is_a?(Nil)
      __iyi_exit(1)
    end

    g = fiber.group
    g.child_panicked(fiber.cancelled) if g.is_a?(IyiGroup)

    fiber.state = 6
    joiner = fiber.joiner
    if joiner.is_a?(IyiFiber)
      fiber.joiner = nil
      enqueue(joiner)
    end
    reschedule
    __iyi_exit(1)
  end
end

# `defer`'s runtime half on the concurrency targets: the registry is
# the current fiber's, so interleaved tasks never share cleanups. The
# normalizer emits the push on entry and the pop on every normal exit;
# what is left on the list when a panic arrives is exactly what did not
# get to clean up.
def __iyi_defer_push(cleanup : Proc(Nil)) : Nil
  fiber = IyiScheduler.current
  node = IyiDeferNode.new(cleanup)
  node.next_node = fiber.defers
  fiber.defers = node
end

def __iyi_defer_pop_run : Nil
  fiber = IyiScheduler.current
  node = fiber.defers
  return unless node.is_a?(IyiDeferNode)
  fiber.defers = node.next_node
  node.run
end

# ── The public primitives ──────────────────────────────────────────────

# Park for *ms* milliseconds. `Cancelled` when the group said stop —
# immediately if it already had, which is what lets `!` drain a cancelled
# task through every later wait it would have done.
def sleep(ms : Int32) : Nil | Cancelled
  IyiScheduler.sleep_current(ms)
end

# Park until *fd* has bytes to read. The poller, made visible: what
# `__iyi_read` does directly today, a program with other fibers live does
# through this, and III.10's IO floor will route through it wholesale.
def wait_readable(fd : Int32) : Nil | Cancelled
  IyiScheduler.wait_readable_current(fd)
end

# A read that parks the fiber instead of the thread. The propagation is
# the runtime's own dogfood: a cancelled wait leaves as a value.
def iyi_read(fd : Int32, buffer : Void*, count : UInt64) : Int64 | Cancelled
  wait_readable(fd)!
  __iyi_read(fd, buffer, count)
end

# ── Tasks and groups — III.4.1 ─────────────────────────────────────────

# What `g.spawn` answers. `value` joins, then repeats what the task's
# block returned — the whole union, error members included, so `case`
# handles a task's failure exactly the way III.4.3 says (the group has
# already applied its policy by then; reading the value is optional).
class IyiTask(T)
  @fiber : IyiFiber
  @box : Array(T)

  def initialize(@fiber : IyiFiber)
    @box = Array(T).new(1)
  end

  def fiber : IyiFiber
    @fiber
  end

  def finish(value : T) : Nil
    @box << value
  end

  def done? : Bool
    @fiber.state == 6
  end

  def value : T | Panicked
    IyiScheduler.join(@fiber)
    # III.1.4, literal: reading the panicked task's value *catches* the
    # panic — it arrives as the error value it became at the boundary,
    # `case`/`!`/`.or` handle it like any failure, and the join stops
    # owing a re-raise for it.
    if @fiber.panicked
      @fiber.panic_delivered = true
      return Panicked.new(@fiber.panic_message)
    end
    @box.first
  end
end

class IyiGroup
  @live : Int32
  @failed : Bool
  @first_child : IyiFiber?
  @joiner : IyiFiber?

  def initialize
    @live = 0
    @failed = false
    @first_child = nil
    @joiner = nil
  end

  # Start a task. The block is compiled once and carried as a proc; its
  # return value is the task's, and a return value that is an error
  # member is a failure the group acts on (III.4.3): first failure
  # cancels the siblings, `errgroup`'s policy with the library deleted.
  def spawn(&block : -> T) : IyiTask(T) forall T
    fiber = IyiFiber.new
    task = IyiTask(T).new(fiber)
    runner = self
    install(fiber) do
      value = block.call
      task.finish(value)
      runner.child_finished(value.is_a?(::Error) && !fiber.cancelled)
    end
    fiber.prepare_stack
    IyiScheduler.register(fiber)
    fiber.next_child = @first_child
    @first_child = fiber
    fiber.group = self
    @live = @live + 1
    IyiScheduler.enqueue(fiber)
    task
  end

  # The one place a task body becomes a stored proc. A captured block is
  # the language's own closure; a proc literal is not a thing an iyi file
  # writes.
  private def install(fiber : IyiFiber, &body : -> Nil) : Nil
    fiber.proc = body
  end

  # :nodoc: — the runtime's own callback, on the task's stack.
  def child_finished(failed : Bool) : Nil
    @live = @live - 1
    if failed && !@failed
      @failed = true
      cancel_children
    end
    if @live == 0
      joiner = @joiner
      if joiner.is_a?(IyiFiber)
        @joiner = nil
        IyiScheduler.enqueue(joiner)
      end
    end
  end

  # :nodoc: — a panicking child, on its own stack: the same accounting
  # as a returned error. What the join owes for it is read off the
  # children themselves.
  def child_panicked(cancelled : Bool) : Nil
    child_finished(!cancelled)
  end

  # :nodoc: — `group`'s deferred half. The scope cannot be left until
  # every task has finished, and `defer` is what guarantees "cannot":
  # a `return` out of the block still runs this.
  def join : Nil
    while @live > 0
      me = IyiScheduler.current
      @joiner = me
      me.state = 5
      IyiScheduler.reschedule
    end
    # The boundary owes a re-raise for any panic *nobody read*: a bug
    # observed through its handle already became a `Panicked` value
    # there, and re-raising it too would report one bug twice. The
    # child is marked delivered before the raise, so the deferred
    # second join (concurrency's own `defer g.join`) finds nothing —
    # and an owner already on its own panic path gets the mark without
    # the noise.
    child = @first_child
    while child.is_a?(IyiFiber)
      if child.panicked && !child.panic_delivered
        child.panic_delivered = true
        raise "a task panicked: " + child.panic_message unless IyiScheduler.current.panicked
      end
      child = child.next_child
    end
  end

  # Cancel every task still live. The group's own tool; a failing child
  # reaches it through the policy above.
  def cancel_children : Nil
    child = @first_child
    while child.is_a?(IyiFiber)
      IyiScheduler.cancel(child)
      child = child.next_child
    end
  end
end

# III.4.1: concurrency is introduced by a scope, never by a call. The
# join is deferred, so no exit leaves a task running — not a `return`,
# not an error leaving through `!`. The group answers what its block
# answers, which is how the typed form (III.4.9) gets a value out: the
# expansion appends the extraction to the block, and the block stays a
# block, so nothing a task assigned leaks into the enclosing scope.
def group(& : IyiGroup -> U) : U forall U
  g = IyiGroup.new
  defer g.join
  yield g
end

# ── Channel — III.4.6 ──────────────────────────────────────────────────
#
# `Channel(T).new` is a rendezvous, as Crystal's is: a send completes when
# a receive takes it, and either side parks until the other arrives. A
# parked sender carries its value in its node's box, so the handoff needs
# no third party; `new(capacity)` buffers that many sends first. Closing
# drains what was delivered, then refuses: a parked sender whose box is
# still full failed, and its value dies with the node.
#
# `T : Share` is not enforced yet for the reason the file header gives:
# one thread cannot race, and a marker that gates nothing cannot be
# tested for gating. `select` is answered by this protocol — a node per
# arm, one nonce, losers stale by arithmetic — at the bottom of the class.
class Channel(T)
  @items : Array(T)
  @capacity : Int32
  @closed : Bool
  @recv_head : IyiWaiter?
  @recv_tail : IyiWaiter?
  @send_head : IyiSendNode(T)?
  @send_tail : IyiSendNode(T)?

  def initialize
    initialize(0)
  end

  def initialize(capacity : Int32)
    raise "a channel's capacity is not negative" if capacity < 0
    @items = Array(T).new(capacity < 1 ? 1 : capacity)
    @capacity = capacity
    @closed = false
    @recv_head = nil
    @recv_tail = nil
    @send_head = nil
    @send_tail = nil
  end

  def send(value : T) : Nil | ChannelClosed | Cancelled
    fiber = IyiScheduler.current
    return Cancelled.new if fiber.cancelled
    return put_now(value) if send_ready?

    # Park carrying the value. The wake tells one of three stories, and
    # the box is the witness for the one that matters: emptied means
    # delivered, whatever else has happened since.
    node = park_send_node(fiber, IyiScheduler.park(fiber), value)
    IyiScheduler.reschedule
    return nil if node.delivered?
    return Cancelled.new if fiber.cancelled
    ChannelClosed.new
  end

  # A closed channel drains what was delivered before it refuses.
  def receive : T | ChannelClosed | Cancelled
    fiber = IyiScheduler.current
    while true
      return Cancelled.new if fiber.cancelled
      return take_now if receive_ready?
      park_receive_node(fiber, IyiScheduler.park(fiber))
      IyiScheduler.reschedule
    end
  end

  # Everyone parked is woken; what each wake means is read on the woken
  # side — a receiver finds the buffer, then `ChannelClosed`; a sender
  # finds its box still full.
  def close : Nil
    @closed = true
    while wake_receiver
    end
    while true
      node = take_sender
      break unless node.is_a?(IyiSendNode(T))
      IyiScheduler.enqueue(node.fiber)
    end
  end

  def closed? : Bool
    @closed
  end

  # ── The halves `select` shares with the calls above ────────────────
  #
  # `ready?` promises the `_now` half will not park. One fiber runs
  # between the check and the act, so the promise cannot be invalidated
  # in the gap — cooperative scheduling is the lock.

  def receive_ready? : Bool
    @closed || !@items.empty? || sender_waiting?
  end

  # Assumes `receive_ready?`: the buffer, then a parked sender's box,
  # then the refusal.
  def take_now : T | ChannelClosed
    unless @items.empty?
      value = @items.shift
      # The buffer has room now; the oldest parked sender's value moves
      # in, so parked sends complete in the order they parked.
      refill = take_sender
      if refill.is_a?(IyiSendNode(T))
        @items << refill.take
        IyiScheduler.enqueue(refill.fiber)
      end
      return value
    end
    unless @closed
      node = take_sender
      if node.is_a?(IyiSendNode(T))
        value = node.take
        IyiScheduler.enqueue(node.fiber)
        return value
      end
    end
    return ChannelClosed.new if @closed
    raise "take_now on an empty open channel"
  end

  def send_ready? : Bool
    @closed || @items.size < @capacity || receiver_waiting?
  end

  # Assumes `send_ready?`. A parked receiver is a completed rendezvous:
  # the value goes through the buffer for the one instant the receiver
  # needs to be scheduled, and the send is no longer contingent.
  def put_now(value : T) : Nil | ChannelClosed
    return ChannelClosed.new if @closed
    if wake_receiver
      @items << value
      return nil
    end
    if @items.size < @capacity
      @items << value
      return nil
    end
    raise "put_now on a full channel"
  end

  def receive_select_action : IyiReceiveSelect(T)
    IyiReceiveSelect(T).new(self)
  end

  def send_select_action(value : T) : IyiSendSelect(T)
    IyiSendSelect(T).new(self, value)
  end

  # `select`'s arms park through these with one shared nonce; a plain
  # call parks with a fresh nonce of its own.
  def park_receive_node(fiber : IyiFiber, nonce : UInt64) : Nil
    waiter = IyiWaiter.new(fiber, nonce)
    tail = @recv_tail
    if tail.is_a?(IyiWaiter)
      tail.next_node = waiter
    else
      @recv_head = waiter
    end
    @recv_tail = waiter
  end

  def park_send_node(fiber : IyiFiber, nonce : UInt64, value : T) : IyiSendNode(T)
    node = IyiSendNode(T).new(fiber, nonce, value)
    tail = @send_tail
    if tail.is_a?(IyiSendNode(T))
      tail.next_node = node
    else
      @send_head = node
    end
    @send_tail = node
    node
  end

  # Peeks that prune: a stale head is consumed, never counted.
  private def receiver_waiting? : Bool
    while true
      head = @recv_head
      return false unless head.is_a?(IyiWaiter)
      return true if head.current?
      @recv_head = head.next_node
      @recv_tail = nil if @recv_head.is_a?(Nil)
    end
  end

  private def sender_waiting? : Bool
    while true
      head = @send_head
      return false unless head.is_a?(IyiSendNode(T))
      return true if head.current?
      @send_head = head.next_node
      @send_tail = nil if @send_head.is_a?(Nil)
    end
  end

  # True when a parked receiver was woken; stale nodes — parks their
  # fiber already left — are consumed and skipped, so a real waiter
  # behind one is never starved by a leftover in front of it.
  private def wake_receiver : Bool
    while true
      head = @recv_head
      return false unless head.is_a?(IyiWaiter)
      @recv_head = head.next_node
      @recv_tail = nil if @recv_head.is_a?(Nil)
      next unless head.current?
      IyiScheduler.enqueue(head.fiber)
      return true
    end
  end

  # The oldest parked sender still standing, not yet woken: the caller
  # takes the value first and wakes the fiber after, so the box is the
  # delivery receipt by the time its owner runs.
  private def take_sender : IyiSendNode(T)?
    while true
      head = @send_head
      return nil unless head.is_a?(IyiSendNode(T))
      @send_head = head.next_node
      @send_tail = nil if @send_head.is_a?(Nil)
      next unless head.current?
      return head
    end
  end

  # ── select — III.4.6, the library half of the expansion ────────────
  #
  # A `select` compiles to `%i, %v = ::Channel.select({arm, arm})` and a
  # case over the index; `non_blocking_select` when an `else` arm
  # exists. One def serves every arity, because a tuple's size is a
  # compile-time fact a macro walks. On a cancelled task the first arm
  # answers `Cancelled`, exactly as that arm's own primitive would have.
  def self.select(actions : U) forall U
    fiber = IyiScheduler.current
    while true
      return {0, Cancelled.new} if fiber.cancelled
      {% for i in 0...U.size %}
        if actions[{{ i }}].ready?
          return { {{ i }}, actions[{{ i }}].execute }
        end
      {% end %}
      # Nothing ready: one park, every arm's node carrying its nonce.
      # A send arm can win *while parked* — a receiver empties its box
      # directly — and that is checked before the next round of parks.
      nonce = IyiScheduler.park(fiber)
      {% for i in 0...U.size %}
        actions[{{ i }}].park(fiber, nonce)
      {% end %}
      IyiScheduler.reschedule
      {% for i in 0...U.size %}
        if actions[{{ i }}].won_while_parked?
          return { {{ i }}, nil }
        end
      {% end %}
    end
  end

  # No arm ready answers -1, which the expansion's case meets with the
  # program's own `else`.
  def self.non_blocking_select(actions : U) forall U
    fiber = IyiScheduler.current
    return {0, Cancelled.new} if fiber.cancelled
    {% for i in 0...U.size %}
      if actions[{{ i }}].ready?
        return { {{ i }}, actions[{{ i }}].execute }
      end
    {% end %}
    {-1, nil}
  end
end

# The two arm shapes `select`'s expansion asks a channel for. Classes,
# because a select holds one across a park and reads what happened to
# it; a struct in a tuple is a copy nobody else can write to.
class IyiReceiveSelect(T)
  @channel : Channel(T)

  def initialize(@channel : Channel(T))
  end

  def ready? : Bool
    @channel.receive_ready?
  end

  def execute : T | ChannelClosed
    @channel.take_now
  end

  def park(fiber : IyiFiber, nonce : UInt64) : Nil
    @channel.park_receive_node(fiber, nonce)
  end

  # A parked receive wins by waking: the value is in the channel when
  # the select looks again.
  def won_while_parked? : Bool
    false
  end
end

class IyiSendSelect(T)
  @channel : Channel(T)
  @value : T
  @node : IyiSendNode(T)?

  def initialize(@channel : Channel(T), @value : T)
    @node = nil
  end

  def ready? : Bool
    @channel.send_ready?
  end

  def execute : Nil | ChannelClosed
    @channel.put_now(@value)
  end

  def park(fiber : IyiFiber, nonce : UInt64) : Nil
    @node = @channel.park_send_node(fiber, nonce, @value)
  end

  def won_while_parked? : Bool
    node = @node
    node.is_a?(IyiSendNode(T)) && node.delivered?
  end
end
