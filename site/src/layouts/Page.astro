---
// Fonts are vendored, never fetched from a CDN. A site arguing that a program
// should link what it uses does not get to pull two megabytes off a third party.
import "@fontsource-variable/newsreader/opsz.css";
import "@fontsource-variable/newsreader/opsz-italic.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource/ibm-plex-mono/600.css";
import "@fontsource/ibm-plex-mono/400-italic.css";

import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/code.css";

import facts from "../generated/facts.json";

interface Props {
  title: string;
  summary?: string;
}

const { title, summary } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (p: string) => `${base.replace(/\/$/, "")}/${p.replace(/^\//, "")}`;

const nav = [
  ["why", "why/"],
  ["learn", "learn/"],
  ["spec", "spec/"],
  ["playground", "playground/"],
  ["changelog", "changelog/"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {summary && <meta name="description" content={summary} />}
    <link rel="icon" href={href("favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead spread">
      <div class="masthead-inner to-wide">
        <a class="wordmark" href={href("/")} aria-label="iyi, home">
          <span class="wordmark-text">iyi</span>
        </a>
        <nav aria-label="Sections">
          <ul>
            {
              nav.map(([label, path]) => (
                <li>
                  <a href={href(path)}>{label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="colophon spread">
      <div class="to-wide">
        <hr class="rule" />
        <div class="colophon-grid">
          <p class="colophon-note">
            iyi is Turkish for good. The compiler is built on Crystal's and
            carries Crystal's licence and copyright, Apache 2.0, Copyright
            2012-2026 Manas Technology Solutions.
          </p>
          <dl class="evidence">
            <dt>numbers on this site</dt>
            <dd>generated by {facts.provenance.generator}</dd>
            <dt>measured at</dt>
            <dd>{facts.provenance.commit}</dd>
            <dt>structural source</dt>
            <dd>{facts.provenance.structural_source}</dd>
          </dl>
        </div>
      </div>
    </footer>

    <style>
      .skip {
        position: absolute;
        left: -9999px;
      }
      .skip:focus {
        left: var(--edge);
        top: var(--edge);
        background: var(--raise);
        padding: 0.5rem 0.8rem;
        border: var(--hair) solid var(--ink);
        z-index: 10;
      }

      .masthead {
        border-bottom: var(--hair) solid var(--hairline);
      }

      .masthead-inner {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 2rem;
        padding-block: 0.85rem;
        flex-wrap: wrap;
      }

      /* The wordmark is the word, set in the text face, with the tittles doing
       * the work. In Turkish orthography the dot on the i is semantic: i and
       * dotless i are different letters. So the dot is not decoration here, and
       * the mark does not need a logo bolted onto it. */
      .wordmark {
        text-decoration: none;
        font-family: var(--font-text);
        font-size: var(--step-2);
        font-weight: 620;
        letter-spacing: -0.02em;
        line-height: 1;
        color: var(--ink);
      }

      .wordmark-text {
        font-variation-settings: "opsz" 60;
      }

      nav ul {
        display: flex;
        gap: 1.15rem;
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }

      nav a {
        font-family: var(--font-mono);
        font-size: var(--step--1);
        color: var(--graphite);
        text-decoration: none;
        border-bottom: var(--hair) solid transparent;
        padding-block-end: 2px;
      }

      nav a:hover {
        color: var(--ink);
        border-bottom-color: var(--signal);
      }

      .colophon {
        margin-block-start: 4.5rem;
        padding-block-end: 3rem;
      }

      .colophon-grid {
        display: grid;
        gap: var(--gutter);
        grid-template-columns: minmax(0, 1fr) minmax(0, var(--rail));
        padding-block-start: 1.2rem;
      }

      @media (max-width: 62rem) {
        .colophon-grid {
          grid-template-columns: 1fr;
        }
      }

      .colophon-note {
        font-size: var(--step--1);
        color: var(--graphite);
        max-width: 52ch;
        margin: 0;
      }

      .colophon .evidence {
        margin: 0;
      }
    </style>
  </body>
</html>
