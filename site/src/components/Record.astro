---
// The chrome for a page that is a record rather than an argument: the two
// generated long-form pages, a SPEC.md section and CHANGELOG.md.
//
// It carries three things. A banner saying the page was generated and by what,
// because a page that reproduces a file should say so on the page rather than
// in a commit message. An evidence rail naming the source, the byte count and
// the commit, which is the same rail the site puts beside every measured
// number. And the prose styles that markdown from SPEC.md needs and base.css
// does not carry: tables, lists, blockquotes, fenced blocks, rules.
//
// Those styles have to reach slotted markdown, which never carries Astro's
// scope attribute, so they are written as `:global` under one `.record` class.
// The scoping is the class, and the block below is the only place on the site
// that styles generated prose.

interface Props {
  source: string;
  sourceBytes: number;
  // Omitted by a page that lists rather than reproduces: it has no extent of
  // its own in the source.
  bytes?: number;
  commit: string;
  generator: string;
  line?: number;
  eyebrow: string;
  // Already rendered by scripts/reference.mjs, because these headings carry
  // markdown: `Part IV: `.iyimod`, the module artifact` names a file in code
  // voice and a page printing the backticks would be showing punctuation.
  titleHtml: string;
  // The sentence that says what the page is. It differs between a page that
  // reproduces a file and a page that lists what is in one, and the difference
  // is exactly the kind of thing this site should not be vague about.
  claim?: string;
}

const {
  source,
  sourceBytes,
  bytes,
  commit,
  generator,
  line,
  eyebrow,
  titleHtml,
  claim = "Not hand-edited: what follows is the text as that file holds it.",
} = Astro.props;

const count = new Intl.NumberFormat("en-GB");
---

<header class="to-wide head">
  <div class="ident">
    <p class="label">{eyebrow}</p>
    <h1 set:html={titleHtml} />
    <slot name="mark" />
    <p class="generated">
      Generated from {source} at {commit} by {generator}. {claim}
    </p>
  </div>

  <dl class="evidence">
    <dt>source</dt>
    <dd>{source}</dd>
    {
      line !== undefined && (
        <>
          <dt>at line</dt>
          <dd>{count.format(line)}</dd>
        </>
      )
    }
    {
      bytes !== undefined && (
        <>
          <dt>bytes here</dt>
          <dd>{count.format(bytes)}</dd>
        </>
      )
    }
    <dt>bytes in {source}</dt>
    <dd>{count.format(sourceBytes)}</dd>
    <dt>commit</dt>
    <dd>{commit}</dd>
    <dt>generated by</dt>
    <dd>
      {
        /* The rail is 21ch and this path is longer, so it has to wrap. Left to
         * the inherited `overflow-wrap: break-word` it wraps mid-token and
         * reads as "reference.m / js". A break offered after each separator
         * wraps it where a path is meant to wrap. */
        generator.split("/").map((piece, n, all) =>
          n < all.length - 1 ? (
            <>
              {piece}/<wbr />
            </>
          ) : (
            piece
          ),
        )
      }
    </dd>
    <slot name="evidence" />
  </dl>
</header>

{
  /* A page that lists rather than reproduces passes no body, and does not get
   * the prose wrapper: the styles below are for the source's own markup. */
  Astro.slots.has("default") && (
    <div class="record stack">
      <slot />
    </div>
  )
}

<slot name="after" />

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--rail));
    gap: var(--gutter);
    padding-block: 2.4rem 1.6rem;
    align-items: start;
  }

  @media (max-width: 62rem) {
    .head {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }

  .ident > * + * {
    margin-block-start: 0.7rem;
  }

  .ident h1 {
    max-width: var(--measure);
  }

  /* The machine's voice, and the smallest step, because it is a stamp on the
   * page rather than part of the argument. The marks above it are mono too, so
   * it takes a hairline and real space: three mono blocks with 0.7rem between
   * them read as one paragraph. */
  .generated {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    line-height: 1.5;
    color: var(--graphite);
    max-width: 58ch;
    margin: 0;
    padding-block-start: 0.85rem;
    border-block-start: var(--hair) solid var(--hairline);
  }

  .ident > .generated {
    margin-block-start: 1.5rem;
  }

  .evidence {
    margin: 0;
  }

  .record {
    padding-block-end: 1rem;
  }

  /* Generated prose ------------------------------------------------------ */

  .record :global(h2),
  .record :global(h3),
  .record :global(h4) {
    margin-block: 2.1rem 0.75rem;
  }

  .record :global(h2:first-child),
  .record :global(h3:first-child),
  .record :global(h4:first-child) {
    margin-block-start: 0;
  }

  .record :global(ul),
  .record :global(ol) {
    margin: 0 0 1.05em;
    padding-inline-start: 1.4rem;
  }

  .record :global(li) {
    margin-block-end: 0.35em;
  }

  .record :global(li > ul),
  .record :global(li > ol) {
    margin-block: 0.35em 0;
  }

  .record :global(blockquote) {
    margin: 0 0 1.05em;
    padding-inline-start: 1rem;
    border-inline-start: var(--hair) solid var(--hairline);
    color: var(--graphite);
  }

  /* base.css sets `white-space: nowrap` on inline code, which is right for a
   * short identifier in hand-written copy and wrong here: CHANGELOG.md and
   * SPEC.md quote whole command lines in backticks, and an unbreakable
   * 697px `crystal build --iyi-keep ABCGreeter --emit-bind mods -o keep`
   * scrolled the entire document 346px sideways at 390px wide. `pre-wrap`
   * keeps the spacing inside the span and lets it break between words;
   * `break-word` catches a single token with no spaces in it at all. */
  .record :global(:not(pre) > code) {
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  /* A fenced block is the machine's voice, so it gets the same frame the
   * site's own source listings use. */
  .record :global(pre) {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    line-height: 1.58;
    background: var(--raise);
    border: var(--hair) solid var(--hairline);
    border-radius: 2px;
    margin: 0 0 1.05em;
    padding: 0.95rem 1.1rem;
    overflow-x: auto;
    tab-size: 2;
  }

  .record :global(pre code) {
    font-size: inherit;
    background: none;
    border: 0;
    padding: 0;
    white-space: pre;
  }

  /* SPEC.md argues in tables. They are the second most common thing in it
   * after prose, so they are set as an instrument: hairline rules, mono
   * figures, no fill.
   *
   * `width: 100%` does not contain a table: a cell with an unbreakable token
   * makes the table wider than its box and the whole document then scrolls
   * sideways, which on CHANGELOG.md was 346px of overflow at 390px wide. A
   * table is made its own horizontal scroller instead, the way a fenced block
   * already is. Measured at 390, 600, 900 and 1440. */
  .record :global(table) {
    display: block;
    width: max-content;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 0 0 1.15em;
    font-size: var(--step--1);
  }

  .record :global(th),
  .record :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.4rem 0.7rem 0.4rem 0;
    border-block-end: var(--hair) solid var(--hairline);
  }

  .record :global(thead th) {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--mute);
    font-weight: 500;
    border-block-end-color: var(--ink);
  }

  .record :global(hr) {
    border: 0;
    height: var(--hair);
    background: var(--hairline);
    margin-block: 2rem;
  }

  /* Struck text is load bearing in this record: Part V uses it to mark a
   * question that has since been answered. */
  .record :global(del),
  .record :global(s) {
    color: var(--mute);
    text-decoration-color: var(--signal);
  }

  .record :global(img) {
    max-width: 100%;
    height: auto;
  }
</style>
